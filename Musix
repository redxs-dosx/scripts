-- ---- Auto-placement: sit right after whatever buttons the topbar currently has ----
-- Looks at Roblox's own topbar (CoreGui.TopBarApp) and at the game's GUIs (e.g. TopbarPlus
-- buttons the creator added), finds the right-most button in the left half of the topbar
-- and parks the pill just after it. Re-checked every second while the pill is showing.
local function isShown(obj)
    local cur = obj
    while cur and cur ~= game do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return true
end

local function looksDrawn(d)
    if d.BackgroundTransparency < 0.98 then return true end
    if d:IsA("ImageLabel") or d:IsA("ImageButton") then
        return d.Image ~= "" and d.ImageTransparency < 0.98
    end
    if d:IsA("TextLabel") or d:IsA("TextButton") then
        return d.Text ~= "" and d.TextTransparency < 0.98
    end
    return false
end

local function scanTopbar()
    local cam = workspace.CurrentCamera
    local screenW = (cam and cam.ViewportSize.X) or 800
    local topY = GuiService:GetGuiInset().Y

    local roots = {}
    local okc, core = pcall(function() return game:GetService("CoreGui") end)
    if okc and core then
        local tb = core:FindFirstChild("TopBarApp")
        if tb then roots[#roots + 1] = tb end
    end
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pg then
        for _, g in ipairs(pg:GetChildren()) do
            if g:IsA("ScreenGui") and g ~= gui and g.Enabled then
                roots[#roots + 1] = g
            end
        end
    end

    local leftEnd, leftCy, rightStart
    for _, root in ipairs(roots) do
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("GuiObject") then
                local size = d.AbsoluteSize
                if size.X >= 20 and size.X <= 400 and size.Y >= 26 and size.Y <= 60 then
                    local pos = d.AbsolutePosition
                    local cy = pos.Y + size.Y / 2
                    if cy > 8 and cy < topY and looksDrawn(d) and isShown(d) then
                        if pos.X + size.X / 2 < screenW * 0.5 then
                            local e = pos.X + size.X
                            if not leftEnd or e > leftEnd then
                                leftEnd, leftCy = e, cy
                            end
                        elseif not rightStart or pos.X < rightStart then
                            rightStart = pos.X
                        end
                    end
                end
            end
        end
    end
    return { leftEnd = leftEnd, leftCy = leftCy, rightStart = rightStart }
end

local function updatePillLayout(animate)
    if not AUTO_PILL then return end
    local ok, r = pcall(scanTopbar)
    if not ok or type(r) ~= "table" then return end

    local x = r.leftEnd and math.floor(r.leftEnd + PILL_GAP) or (safeOffset.X + PILL_X)
    local w = PILL_WIDTH
    if r.rightStart then
        -- squeeze the pill if the right-hand buttons are close
        w = math.clamp(math.floor(r.rightStart - 10 - x), 150, PILL_WIDTH)
    end
    local cy = r.leftCy and math.floor(r.leftCy)
        or (safeOffset.Y + pillY + PILL_Y_OFFSET + pillH / 2)

    if x == pillLayout.x and w == pillLayout.w and cy == pillLayout.cy then return end
    pillLayout.x, pillLayout.w, pillLayout.cy = x, w, cy

    local goalPos = getPillCenter()
    local goalSize = UDim2.fromOffset(w, pillH)
    if animate and pill.Visible then
        tweenEx(pill, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, {
            Position = goalPos,
            Size = goalSize,
        })
    else
        pill.Position = goalPos
        pill.Size = goalSize
    end
end

