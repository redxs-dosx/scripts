local function makeSlider(hit, back, fill, knob, onChanged, onReleased)
    local dragging = false
    local lastRel = 0

    local function visual(rel)
        fill.Size = UDim2.fromScale(rel, 1)
        knob.Position = UDim2.fromScale(rel, 0.5)
    end

    local function update(inputX)
        local rel = math.clamp((inputX - back.AbsolutePosition.X) / back.AbsoluteSize.X, 0, 1)
        lastRel = rel
        visual(rel)
        if onChanged then onChanged(rel) end
    end

    track(hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            tweenEx(knob, 0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out, { Size = UDim2.fromOffset(18, 18) })
            update(input.Position.X)
        end
    end))

    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end))

    track(UserInputService.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            tweenEx(knob, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { Size = UDim2.fromOffset(12, 12) })
            if onReleased then onReleased(lastRel) end
        end
    end))

    return {
        set = visual,
        isDragging = function() return dragging end,
    }
end

local progress = makeSlider(barHit, barBack, barFill, barKnob,
