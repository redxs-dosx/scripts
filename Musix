local searchToken = 0

local function doWebSearch(q, token)
    task.spawn(function()
        local results, err = searchRobloxAudio(q)
        if not alive or token ~= searchToken then return end
        if not results then
            clearWebRows()
            setWebStatus("Couldn't reach Roblox search (" .. tostring(err) .. ").\n\nPasting a song ID still works.")
        elseif #results == 0 then
            clearWebRows()
            setWebStatus("No audio found for \"" .. q .. "\".")
        else
            setWebStatus("")
            renderWebResults(results)
        end
    end)
end

-- Typing in Roblox mode searches after a short pause
local function scheduleWebSearch()
    if searchMode ~= "roblox" then return end
    searchToken += 1
    local token = searchToken
    local q = trim(searchBox.Text)
    if q == "" then
        clearWebRows()
        setWebStatus("Search Roblox audio by name.\n\nYou can also paste a song ID.")
        return
    end
    if parseId(q) then
        clearWebRows()
        setWebStatus("")
        return
    end
    setWebStatus("Searching...")
    task.delay(0.7, function()
        if not alive or token ~= searchToken then return end
        doWebSearch(q, token)
    end)
end
