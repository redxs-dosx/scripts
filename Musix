-- =====================================================================
--  TAG READING (ID3 for mp3, Vorbis comments for ogg)
-- =====================================================================
local function trim(s)
    return (s:match("^%s*(.-)%s*$"))
end

local function cutNull(s)
    local i = s:find("\0", 1, true)
    if i then return s:sub(1, i - 1) end
    return s
end

local function latin1(s)
    local out = table.create(#s)
    for i = 1, #s do
        local b = s:byte(i)
        out[i] = b < 128 and string.char(b) or utf8.char(b)
    end
    return table.concat(out)
end

local function utf16(s, forceBE)
    local i, be = 1, forceBE or false
    local b1, b2 = s:byte(1, 2)
    if b1 == 0xFF and b2 == 0xFE then
        be = false; i = 3
    elseif b1 == 0xFE and b2 == 0xFF then
        be = true; i = 3
    end
    local out = {}
    while i + 1 <= #s do
        local a, b = s:byte(i, i + 1)
        local cu = be and (a * 256 + b) or (b * 256 + a)
        i += 2
        if cu >= 0xD800 and cu < 0xDC00 and i + 1 <= #s then
            local a2, b2b = s:byte(i, i + 1)
            local lo = be and (a2 * 256 + b2b) or (b2b * 256 + a2)
            if lo >= 0xDC00 and lo < 0xE000 then
                cu = 0x10000 + (cu - 0xD800) * 1024 + (lo - 0xDC00)
                i += 2
            end
        end
        if cu == 0 then break end
        if cu < 0xD800 or cu >= 0xE000 then
            out[#out + 1] = utf8.char(cu)
        end
    end
    return table.concat(out)
end

local function decodeText(enc, s)
    if enc == 1 then return utf16(s) end
    if enc == 2 then return utf16(s, true) end
    s = cutNull(s)
    if enc == 3 and utf8.len(s) then return s end
    if utf8.len(s) and enc ~= 0 then return s end
    return latin1(s)
end

local function u32le(s, i)
    local a, b, c, d = s:byte(i, i + 3)
    return a + b * 256 + c * 65536 + d * 16777216
end

local function u32be(s, i)
    local a, b, c, d = s:byte(i, i + 3)
    return a * 16777216 + b * 65536 + c * 256 + d
end

local function synchsafe(a, b, c, d)
    return a * 2097152 + b * 16384 + c * 128 + d
end

local function imgExt(bytes)
    if bytes:sub(1, 8) == "\137PNG\r\n\26\n" then return "png" end
    if bytes:sub(1, 2) == "\255\216" then return "jpg" end
    return nil
end

local function getText(body)
    local enc = body:byte(1)
    if not enc then return nil end
    local t = trim(decodeText(enc, body:sub(2)))
    if t == "" then return nil end
    return t
end

local function parseAPIC(body, ver)
    local enc = body:byte(1)
    local p
    if ver == 2 then
        p = 5 -- enc(1) + 3 char image format
    else
        local z = body:find("\0", 2, true)
        if not z then return nil end
        p = z + 1
    end
    local ptype = body:byte(p)
    p += 1
    if enc == 1 or enc == 2 then
        local q = p
        while q + 1 <= #body and not (body:byte(q) == 0 and body:byte(q + 1) == 0) do
            q += 2
        end
        p = q + 2
    else
        local z = body:find("\0", p, true)
        if not z then return nil end
        p = z + 1
    end
    return body:sub(p), ptype
end

local function parseID3(data)
    local info = {}
    if data:sub(1, 3) ~= "ID3" then return info end
    local ver = data:byte(4)
    local flags = data:byte(6)
    local sz = synchsafe(data:byte(7, 10))
    local pos = 11
    local tagEnd = math.min(10 + sz, #data)

    if ver >= 3 and bit32.band(flags, 0x40) ~= 0 then
        local a, b, c, d = data:byte(pos, pos + 3)
        if ver == 4 then
            pos += synchsafe(a, b, c, d)
        else
            pos += 4 + u32be(data, pos)
        end
    end

    local idLen = (ver == 2) and 3 or 4
    local hdrLen = (ver == 2) and 6 or 10

    while pos + hdrLen <= tagEnd do
        local id = data:sub(pos, pos + idLen - 1)
        if #id < idLen or id:byte(1) == 0 then break end

        local size
        if ver == 2 then
            local a, b, c = data:byte(pos + 3, pos + 5)
            size = a * 65536 + b * 256 + c
        elseif ver == 4 then
            size = synchsafe(data:byte(pos + 4, pos + 7))
        else
            size = u32be(data, pos + 4)
        end

        local bodyStart = pos + hdrLen
        local body = data:sub(bodyStart, bodyStart + size - 1)
        pos = bodyStart + size

        if size > 0 then
            if id == "TIT2" or id == "TT2" then
                info.title = info.title or getText(body)
            elseif id == "TPE1" or id == "TP1" then
                info.artist = info.artist or getText(body)
            elseif id == "TALB" or id == "TAL" then
                info.album = info.album or getText(body)
            elseif id == "APIC" or id == "PIC" then
                local img, ptype = parseAPIC(body, ver)
                if img and #img > 0 and (not info.image or ptype == 3) then
                    info.image = img
                end
            end
        end
    end
    return info
end

-- ---- base64 (for ogg embedded covers) ----
local B64 = {}
do
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    for i = 1, 64 do B64[chars:byte(i)] = i - 1 end
end

local function b64decode(s)
    s = s:gsub("[^%w%+/]", "")
    local out = {}
    local n = #s
    for i = 1, n - n % 4, 4 do
        local a, b, c, d = s:byte(i, i + 3)
        local v = B64[a] * 262144 + B64[b] * 4096 + B64[c] * 64 + B64[d]
        out[#out + 1] = string.char(math.floor(v / 65536) % 256, math.floor(v / 256) % 256, v % 256)
    end
    local rest = n % 4
    if rest >= 2 then
        local a, b, c = s:byte(n - rest + 1, n - rest + 3)
        local v = B64[a] * 262144 + B64[b] * 4096 + (c and B64[c] or 0) * 64
        out[#out + 1] = string.char(math.floor(v / 65536) % 256)
        if rest == 3 then out[#out + 1] = string.char(math.floor(v / 256) % 256) end
    end
    return table.concat(out)
end

local function parseFlacPicture(bin)
    local p = 5
    local mlen = u32be(bin, p); p += 4 + mlen
    local dlen = u32be(bin, p); p += 4 + dlen
    p += 16
    local len = u32be(bin, p); p += 4
    return bin:sub(p, p + len - 1)
end

local function oggPackets(data, want)
    local packets, cur = {}, {}
    local pos = 1
    while pos + 27 <= #data and #packets < want do
        if data:sub(pos, pos + 3) ~= "OggS" then break end
        local nseg = data:byte(pos + 26)
        local lace = { data:byte(pos + 27, pos + 26 + nseg) }
        local dpos = pos + 27 + nseg
        for _, l in ipairs(lace) do
            cur[#cur + 1] = data:sub(dpos, dpos + l - 1)
            dpos += l
            if l < 255 then
                packets[#packets + 1] = table.concat(cur)
                cur = {}
                if #packets >= want then break end
            end
        end
        pos = dpos
    end
    return packets
end

local function parseOgg(data)
    local info = {}
    local pkt = oggPackets(data, 2)[2]
    if not pkt then return info end

    local offset
    if pkt:sub(1, 7) == "\3vorbis" then
        offset = 8
    elseif pkt:sub(1, 8) == "OpusTags" then
        offset = 9
    else
        return info
    end

    local p = offset
    local vlen = u32le(pkt, p); p += 4 + vlen
    local count = u32le(pkt, p); p += 4
    local tags = {}
    for _ = 1, count do
        if p + 4 > #pkt then break end
        local len = u32le(pkt, p); p += 4
        local s = pkt:sub(p, p + len - 1); p += len
        local eq = s:find("=", 1, true)
        if eq then
            local k = s:sub(1, eq - 1):upper()
            if not tags[k] then tags[k] = s:sub(eq + 1) end
        end
    end

    local function clean(v)
        if not v then return nil end
        v = trim(v)
        if v == "" then return nil end
        if not utf8.len(v) then v = latin1(v) end
        return v
    end

    info.title = clean(tags.TITLE)
    info.artist = clean(tags.ARTIST)
    info.album = clean(tags.ALBUM)

    if tags.METADATA_BLOCK_PICTURE then
        local ok, img = pcall(function()
            return parseFlacPicture(b64decode(tags.METADATA_BLOCK_PICTURE))
        end)
        if ok and img and #img > 0 then info.image = img end
    end
    return info
end

-- =====================================================================
--  FILE SYSTEM / LIBRARY
-- =====================================================================
local songs = {}      -- sorted array of song tables
local known = {}      -- [fileName] = song
local cacheIndex = {} -- [fileName] = { title, artist, album, cover }

local function safeName(s)
    return (s:gsub("[^%w_%-]", "_"))
end

local function loadIndex()
    cacheIndex = {}
    if fsOk and isfile(INDEX) then
        local ok, res = pcall(function() return HttpService:JSONDecode(readfile(INDEX)) end)
        if ok and type(res) == "table" then cacheIndex = res end
    end
end

local function saveIndex()
    if not fsOk then return end
    pcall(function() writefile(INDEX, HttpService:JSONEncode(cacheIndex)) end)
end

local function readMeta(fileName)
    local path = ROOT .. "/" .. fileName
    local ext = (fileName:match("%.([^%.]+)$") or ""):lower()
    local meta = {}

    local ok, data = pcall(readfile, path)
    if ok and type(data) == "string" then
        local ok2, res = pcall(function()
            if ext == "mp3" then
                local m = parseID3(data)
                if not m.title and data:sub(-128, -126) == "TAG" then
                    local t = trim(latin1(cutNull(data:sub(-125, -96))))
                    local a = trim(latin1(cutNull(data:sub(-95, -66))))
                    if t ~= "" then m.title = t end
                    if a ~= "" then m.artist = m.artist or a end
                end
                return m
            elseif ext == "ogg" then
                return parseOgg(data)
            end
            return {}
        end)
        if ok2 and type(res) == "table" then meta = res end
    end
    data = nil

    -- cover -> cache folder
    local coverPath
    if meta.image then
        local e = imgExt(meta.image)
        if e then
            coverPath = CACHE .. "/" .. safeName(fileName) .. "." .. e
            local okW = pcall(writefile, coverPath, meta.image)
            if not okW then coverPath = nil end
        end
    end

    -- name fallbacks
    local base = (fileName:gsub("%.[^%.]+$", ""))
    local title, artist = meta.title, meta.artist
    if not title then
        local a, t = base:match("^(.-)%s+%-%s+(.+)$")
        if a and t then
            title = t
            artist = artist or a
        else
            title = base
        end
    end

    return {
        title = title,
        artist = artist or "Unknown Artist",
        album = meta.album,
        cover = coverPath,
    }
end

local function loadSong(fileName)
    local entry = cacheIndex[fileName]
    if not (entry and (not entry.cover or isfile(entry.cover))) then
        entry = readMeta(fileName)
        cacheIndex[fileName] = entry
        saveIndex()
    end
    return {
        file = fileName,
        path = ROOT .. "/" .. fileName,
        title = entry.title or fileName,
        artist = entry.artist or "Unknown Artist",
        album = entry.album,
        cover = entry.cover,
    }
end

local function listAudioFiles()
    local files = {}
    local ok, list = pcall(listfiles, ROOT)
    if ok and type(list) == "table" then
        for _, p in ipairs(list) do
            local name = p:match("[^/\\]+$")
            local ext = name and name:match("%.([^%.]+)$")
            if ext then
                ext = ext:lower()
                if ext == "mp3" or ext == "ogg" or ext == "wav" then
                    files[name] = true
                end
            end
        end
    end
    return files
end

if fsOk then
    pcall(function()
        if not isfolder(ROOT) then makefolder(ROOT) end
        if not isfolder(CACHE) then makefolder(CACHE) end
    end)
    loadIndex()
end

