-- ========= Minimize (to pill) / Restore / Close =========
local animating = false
local QUINT, BACK, QUAD = Enum.EasingStyle.Quint, Enum.EasingStyle.Back, Enum.EasingStyle.Quad
local IN, OUT = Enum.EasingDirection.In, Enum.EasingDirection.Out

-- Window grows out of the pill (or fades/zooms in on first launch)
local function showWindow(fromPill)
    window.Visible = true
    if fromPill then
        window.Position = getPillCenter()
        windowScale.Scale = 0.08
    else
        window.Position = UDim2.fromScale(0.5, 0.5)
        windowScale.Scale = 0.94
    end
    window.GroupTransparency = 1
    tweenEx(window, 0.45, QUINT, OUT, { Position = UDim2.fromScale(0.5, 0.5), GroupTransparency = 0 })
    tweenEx(windowScale, 0.45, QUINT, OUT, { Scale = 1 })
    task.delay(0.46, function()
        if not alive then return end
        -- snap to the exact final state so nothing is left slightly shrunk or offset
        windowScale.Scale = 1
        window.Position = UDim2.fromScale(0.5, 0.5)
        window.Size = UDim2.fromScale(1, 1)
        window.GroupTransparency = 0
        animating = false
    end)
end

-- Window shrinks + flies into the topbar, then the pill pops out
local function minimize()
    if animating then return end
    animating = true
    updatePillLayout(false) -- re-read the topbar so the pill lands in the right spot
    tween(blur, 0.35, { Size = 0 })
    tweenEx(window, 0.35, QUINT, IN, { Position = getPillCenter(), GroupTransparency = 1 })
    tweenEx(windowScale, 0.35, QUINT, IN, { Scale = 0.08 })

    task.delay(0.22, function()
        if not alive then return end
        pillScale.Scale = 0.4
        pill.Visible = true
        tweenEx(pillScale, 0.4, BACK, OUT, { Scale = 1 })
    end)
    task.delay(0.37, function()
        if not alive then return end
        window.Visible = false
        animating = false
    end)
end

-- Pill squishes away, window grows out of its spot
local function restore()
    if animating then return end
    animating = true
    tween(blur, 0.4, { Size = BLUR_SIZE })
    tweenEx(pillScale, 0.18, QUAD, IN, { Scale = 0.4 })
    task.delay(0.16, function()
        if not alive then return end
        pill.Visible = false
        showWindow(true)
    end)
end

minBtn.MouseButton1Click:Connect(minimize)
pillOpen.MouseButton1Click:Connect(restore)

