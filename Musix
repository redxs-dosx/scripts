-- =====================================================================
--  SCANNING (auto-detects files dropped into the Musix folder)
-- =====================================================================
local scanning = false

local function rescan()
    if scanning or not alive or not fsOk then return end
    scanning = true

    local files = listAudioFiles()
    local changed = false

    for i = #songs, 1, -1 do
        local s = songs[i]
        if not files[s.file] then
            known[s.file] = nil
            if s == currentSong then
                switching = true
                sound:Stop()
                currentSong = nil
                isPlaying = false
                task.delay(0.3, function() switching = false end)
                updateNowPlayingUI()
            end
            table.remove(songs, i)
            changed = true
        end
    end

    local newFiles = {}
    for name in pairs(files) do
        if not known[name] then newFiles[#newFiles + 1] = name end
    end
    table.sort(newFiles)

    if changed then renderList() end

    for _, name in ipairs(newFiles) do
        if not alive then break end
        local ok, song = pcall(loadSong, name)
        if ok and song then
            songs[#songs + 1] = song
            known[name] = song
            sortSongs()
            renderList()
        end
        task.wait()
    end

    scanning = false
end

local function fullRescan()
    if not fsOk then return end
    cacheIndex = {}
    saveIndex()
    known = {}
    songs = {}
    if currentSong then
        switching = true
        sound:Stop()
        currentSong = nil
        isPlaying = false
        task.delay(0.3, function() switching = false end)
        updateNowPlayingUI()
    end
    renderList()
    task.spawn(function()
        while scanning do task.wait() end
        rescan()
    end)
end

