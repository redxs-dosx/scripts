local httpRequest = request or http_request or (syn and syn.request) or (http and http.request) or (fluxus and fluxus.request)

local function httpGetJson(path)
    if not httpRequest then return nil, "your executor has no request function" end
    local lastErr = "unknown error"
    -- Roblox first; the roproxy mirror is only a fallback if Roblox refuses the request
    for _, host in ipairs({ "https://apis.roblox.com", "https://apis.roproxy.com" }) do
        local ok, res = pcall(httpRequest, {
            Url = host .. path,
            Method = "GET",
            Headers = { ["Accept"] = "application/json" },
        })
        if ok and type(res) == "table" then
            if res.StatusCode == 200 and res.Body then
                local okJ, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if okJ and type(data) == "table" then return data end
                lastErr = "bad response"
            else
                lastErr = "HTTP " .. tostring(res.StatusCode)
            end
        else
            lastErr = "request blocked"
        end
    end
    return nil, lastErr
end

local function searchRobloxAudio(query)
    local data, err = httpGetJson(
        "/toolbox-service/v1/marketplace/3?keyword=" .. HttpService:UrlEncode(query) .. "&num=25"
    )
    if not data then return nil, err end
    if type(data.data) ~= "table" then return {} end

    local order = {}
    for _, item in ipairs(data.data) do
        local rawId = item.id or (type(item.asset) == "table" and item.asset.id)
        if type(rawId) == "number" then
            order[#order + 1] = string.format("%d", rawId)
        end
    end
    if #order == 0 then return {} end

    local det = httpGetJson("/toolbox-service/v1/items/details?assetIds=" .. table.concat(order, "%2C"))
    local byId = {}
    if det and type(det.data) == "table" then
        for _, item in ipairs(det.data) do
            local asset = type(item.asset) == "table" and item.asset or item
            if type(asset.id) == "number" then
                byId[string.format("%d", asset.id)] = { asset = asset, creator = item.creator }
            end
        end
    end

    local results = {}
    for _, id in ipairs(order) do
        local title, artist, duration = "Roblox ID " .. id, "Unknown", nil
        local skip = false
        local entry = byId[id]
        if entry then
            local a = entry.asset
            if a.typeId and a.typeId ~= 3 then skip = true end
            local audio = type(a.audioDetails) == "table" and a.audioDetails or {}
            if a.name and a.name ~= "" then
                title = a.name
            elseif audio.title and audio.title ~= "" then
                title = audio.title
            end
            if title:find("Content Deleted", 1, true) then skip = true end
            local by = type(entry.creator) == "table" and entry.creator.name or nil
            if audio.artist and audio.artist ~= "" then
                artist = audio.artist
            elseif by then
                artist = by
            end
            duration = tonumber(audio.duration)
        end
        if not skip then
            results[#results + 1] = { id = id, title = title, artist = artist, duration = duration }
        end
    end
    return results
end

