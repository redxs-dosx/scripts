-- Pop + fade whenever the track changes
local function animateSongChange()
    artScale.Scale = 0.86
    tweenEx(artScale, 0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out, { Scale = 1 })

    artImage.ImageTransparency = 1
    tweenEx(artImage, 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { ImageTransparency = 0 })

    songTitle.TextTransparency = 1
    songArtist.TextTransparency = 1
    pillTitle.TextTransparency = 1
    tweenEx(songTitle, 0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { TextTransparency = 0 })
    tweenEx(songArtist, 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { TextTransparency = 0 })
    tweenEx(pillTitle, 0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { TextTransparency = 0 })
end

local function playSong(song)
    local asset
    if song.assetId then
        -- Roblox audio asset (played straight from the ID, no file needed)
        asset = "rbxassetid://" .. song.assetId
    else
        if not assetFn then
            songArtist.Text = "Your executor has no getcustomasset support"
            return
        end
        local ok, a = pcall(assetFn, song.path)
        if not ok or not a then
            songArtist.Text = "Couldn't load that file"
            return
        end
        asset = a
    end
    currentSong = song
    switching = true
    sound:Stop()
    sound.SoundId = asset
    sound.TimePosition = 0
    sound.Looped = repeatOn
    sound:Play()
    isPlaying = true
    task.delay(0.3, function() switching = false end)
    updateNowPlayingUI()
    animateSongChange()

    if song.assetId then
        task.delay(4, function()
            if alive and currentSong == song and not sound.IsLoaded then
                songArtist.Text = "Couldn't load that ID (private, or not allowed in this game)"
            end
        end)
    end
end

local function indexOfCurrent()
    for i, s in ipairs(songs) do
        if s == currentSong then return i end
    end
    return nil
end

local function playNext()
    if #songs == 0 then return end
    local i = indexOfCurrent()
    local target
    if shuffleOn and #songs > 1 then
        repeat target = math.random(1, #songs) until target ~= i
    else
        target = i and (i % #songs + 1) or 1
    end
    playSong(songs[target])
end

local function playPrevious()
    if #songs == 0 then return end
    if currentSong and sound.TimePosition > 3 then
        sound.TimePosition = 0
        return
    end
    local i = indexOfCurrent() or 1
    playSong(songs[i > 1 and i - 1 or #songs])
end

local function togglePlay()
    if not currentSong then
        if #songs > 0 then playSong(songs[1]) end
        return
    end
    if isPlaying then
        sound:Pause()
        isPlaying = false
    else
        if sound.IsPaused then sound:Resume() else sound:Play() end
        isPlaying = true
    end
    refreshPlayIcon()
end

track(sound.Ended:Connect(function()
    if switching or not alive then return end
    playNext()
end))

