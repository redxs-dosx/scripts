track(RunService.Heartbeat:Connect(function(dt)
    acc += dt
    if acc < 0.15 then return end
    acc = 0
    if not currentSong then return end
    local len = sound.TimeLength
    if len <= 0 then return end
    local pos = sound.TimePosition
    local remaining = "-" .. fmtTime(len - pos)
    pillTime.Text = remaining
    if not progress.isDragging() then
        progress.set(math.clamp(pos / len, 0, 1))
        timeLeft.Text = fmtTime(pos)
        timeRight.Text = remaining
    end
end))

