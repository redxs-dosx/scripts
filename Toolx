-- Main tab (profile header, trending scripts / games, search)
---------------------------------------------------------------------
local Presence = {}
local mainTab = addTab("Main")
do
	local TeleportService = game:GetService("TeleportService")

	local SCRIPTBLOX_API = "https://scriptblox.com/api/script/"
	local EXPLORE_API = "https://apis.roblox.com/explore-api/v1/"
	local OMNI_SEARCH_API = "https://apis.roblox.com/search-api/omni-search"
	local GAMES_LIST_API = "https://games.roblox.com/v1/games/list"

	local mode = "Scripts" -- "Scripts" or "Games"
	local requestId = 0
	local provider = "ScriptBlox" -- "ScriptBlox", "Rscripts" or "xScripts"
	local RS = { api = "https://api.rscripts.net/v1/", key = "", keyFile = SAVE_FOLDER .. "/rscripts.key" }
	local FS = { verified = false, keyless = false, gameMode = "Any game", sort = "Default" } -- filter state + helpers
	local updateFilterRows -- forward declarations, defined below
	local doSearch

	-----------------------------------------------------------------
	-- Data helpers
	-----------------------------------------------------------------
	local function fetchJson(url)
		local body = fetchUrl(url)
		if not body then
			return nil
		end
		local ok, data = pcall(function()
			return HttpService:JSONDecode(body)
		end)
		if ok and typeof(data) == "table" then
			return data
		end
		return nil
	end

	local function shortNumber(n)
		n = tonumber(n) or 0
		local s
		if n >= 1e6 then
			s = string.format("%.1fM", n / 1e6)
		elseif n >= 1e3 then
			s = string.format("%.1fK", n / 1e3)
		else
			s = tostring(math.floor(n))
		end
		return (s:gsub("%.0([MK])", "%1"))
	end

	-- Roblox games ------------------------------------------------
	local function parseGames(list)
		local out = {}
		if typeof(list) ~= "table" then
			return out
		end
		for _, g in ipairs(list) do
			if typeof(g) == "table" and g.universeId and (g.rootPlaceId or g.placeId) then
				table.insert(out, {
					universeId = g.universeId,
					placeId = g.rootPlaceId or g.placeId,
					name = tostring(g.name or "Unknown"),
					players = tonumber(g.playerCount or g.playing) or 0,
					up = g.totalUpVotes or 0,
					down = g.totalDownVotes or 0,
				})
			end
		end
		return out
	end

	-- The explore / search lists don't reliably carry a live player count (it came back as 0 for every game),
	-- so ask the games endpoint for the real "playing" number, up to 100 games per request
	local function fillPlayerCounts(list)
		if #list == 0 then
			return list
		end
		local ids = {}
		for i = 1, math.min(#list, 100) do
			table.insert(ids, tostring(list[i].universeId))
		end
		local data = fetchJson("https://games.roblox.com/v1/games?universeIds=" .. table.concat(ids, ","))
		if data and typeof(data.data) == "table" then
			local counts = {}
			for _, entry in ipairs(data.data) do
				if typeof(entry) == "table" and entry.id and tonumber(entry.playing) then
					counts[tostring(entry.id)] = tonumber(entry.playing)
				end
			end
			for _, g in ipairs(list) do
				local n = counts[tostring(g.universeId)]
				if n then
					g.players = n
				end
			end
		end
		return list
	end

	local function trendingGames()
		local session = HttpService:GenerateGUID(false)
		local sortId

		local sorts = fetchJson(EXPLORE_API .. "get-sorts?sessionId=" .. session .. "&device=computer&country=all")
		if sorts and typeof(sorts.sorts) == "table" then
			local fallback
			for _, s in ipairs(sorts.sorts) do
				local id = tostring(s.sortId or "")
				if id:lower():find("trending") then
					sortId = id
					break
				end
				if not fallback and id ~= "" and (s.contentType == nil or s.contentType == "Games") then
					fallback = id
				end
			end
			sortId = sortId or fallback
		end
		sortId = sortId or "top-trending"

		local data = fetchJson(
			EXPLORE_API .. "get-sort-content?sessionId=" .. session
				.. "&sortId=" .. HttpService:UrlEncode(sortId)
				.. "&device=computer&country=all"
		)
		if not data then
			return nil, "Couldn't reach Roblox. Check that your executor allows HTTP requests."
		end
		local games = parseGames(data.games or data.contents)
		if #games == 0 then
			return nil, "Roblox returned no trending games."
		end
		return fillPlayerCounts(games)
	end

	local function searchGames(query)
		local session = HttpService:GenerateGUID(false)
		local data = fetchJson(
			OMNI_SEARCH_API .. "?searchQuery=" .. HttpService:UrlEncode(query)
				.. "&pageToken=&sessionId=" .. session .. "&pageType=all"
		)
		local games = {}
		if data and typeof(data.searchResults) == "table" then
			for _, group in ipairs(data.searchResults) do
				for _, g in ipairs(parseGames(group.contents)) do
					table.insert(games, g)
				end
			end
		end
		if #games == 0 then
			-- older endpoint as a fallback
			local legacy = fetchJson(GAMES_LIST_API .. "?model.keyword=" .. HttpService:UrlEncode(query) .. "&model.maxRows=24")
			if legacy then
				games = parseGames(legacy.games)
			end
		end
		if #games == 0 then
			return nil, data and ('No games found for "' .. query .. '".') or "Couldn't reach Roblox. Check that your executor allows HTTP requests."
		end
		return fillPlayerCounts(games)
	end

	-- ScriptBlox scripts -------------------------------------------
	local function parseScripts(data)
		local root = data and (data.result or data)
		local list = root and (root.scripts or root)
		local out = {}
		if typeof(list) ~= "table" then
			return out
		end
		for _, s in ipairs(list) do
			if typeof(s) == "table" and s.title then
				local g = typeof(s.game) == "table" and s.game or nil
				table.insert(out, {
					title = tostring(s.title),
					slug = s.slug,
					id = s._id,
					source = typeof(s.script) == "string" and s.script or nil,
					game = g and g.name or nil,
					gameId = g and g.gameId or nil,
					universal = s.isUniversal == true,
					verified = s.verified == true,
					key = s.key == true,
					patched = s.isPatched == true,
					views = s.views or 0,
				})
			end
		end
		return out
	end

	local function trendingScripts()
		local data = fetchJson(SCRIPTBLOX_API .. "trending")
		if not data then
			return nil, "Couldn't reach ScriptBlox. Check that your executor allows HTTP requests."
		end
		local list = parseScripts(data)
		if #list == 0 then
			return nil, "ScriptBlox returned no trending scripts."
		end
		return list
	end

	local function searchScripts(query)
		local data = fetchJson(SCRIPTBLOX_API .. "search?q=" .. HttpService:UrlEncode(query) .. "&max=20")
		if not data then
			return nil, "Couldn't reach ScriptBlox. Check that your executor allows HTTP requests."
		end
		local list = parseScripts(data)
		if #list == 0 then
			return nil, 'No scripts found for "' .. query .. '".'
		end
		return list
	end


	-----------------------------------------------------------------
	-- Filters + Rscripts provider
	-----------------------------------------------------------------
	function FS.trim(text)
		return (tostring(text or ""):match("^%s*(.-)%s*$"))
	end

	-- Works out the game filter (place id + name). Returns {} for "any game", or nil + an error message.
	function FS.resolveGame()
		local gm = FS.gameMode
		if gm == "Any game" then
			return {}
		end
		local placeId, name
		if gm == "This game" then
			placeId = tostring(game.PlaceId)
		else
			local text = FS.trim(FS.gameBox and FS.gameBox.Text)
			if text == "" then
				return {}
			end
			if text:match("^%d+$") then
				placeId = text
			else
				local games, err = searchGames(text)
				if not (games and games[1]) then
					return nil, err or ('No game found for "' .. text .. '".')
				end
				placeId = tostring(games[1].placeId)
				name = games[1].name
			end
		end
		if not name then
			pcall(function()
				name = game:GetService("MarketplaceService"):GetProductInfo(tonumber(placeId)).Name
			end)
		end
		return { placeId = placeId, name = name, universeId = (gm == "This game") and tostring(game.GameId) or nil }
	end

	function FS.collect()
		local f, err = FS.resolveGame()
		if not f then
			return nil, err
		end
		f.verified = FS.verified
		f.keyless = FS.keyless
		return f
	end

	function FS.active(f)
		return f.verified or f.keyless or f.placeId ~= nil
	end

	-- Applies the filters on our side too, so they work even when a provider ignores a parameter
	function FS.apply(list, f)
		local out = {}
		local gname = f.name and f.name:lower() or nil
		for _, item in ipairs(list) do
			local keep = true
			if f.verified and not item.verified then
				keep = false
			end
			if f.keyless and item.key then
				keep = false
			end
			if keep and f.placeId then
				if item.gameId then
					keep = tostring(item.gameId) == f.placeId
				elseif gname and item.game then
					keep = item.game:lower():find(gname, 1, true) ~= nil
				else
					keep = false
				end
			end
			if keep then
				out[#out + 1] = item
			end
		end
		return out
	end

	-- Rscripts needs an API key sent as a header, so this goes through request() instead of HttpGet
	function RS.get(path)
		if RS.key == "" then
			return nil, "Rscripts needs an API key. Paste yours in the box above (free from rscripts.net/dashboard/api)."
		end
		local req = (typeof(request) == "function" and request)
			or (typeof(http_request) == "function" and http_request)
			or (typeof(syn) == "table" and syn.request)
		if not req then
			return nil, "Your executor has no request() function, which Rscripts needs for its API key."
		end
		local ok, res = pcall(req, {
			Url = RS.api .. path,
			Method = "GET",
			Headers = { ["Authorization"] = "Bearer " .. RS.key, ["Accept"] = "application/json" },
		})
		if not ok or typeof(res) ~= "table" then
			return nil, "Couldn't reach Rscripts. Check that your executor allows HTTP requests."
		end
		local status = tonumber(res.StatusCode) or 0
		if status == 401 then
			return nil, "Rscripts rejected your API key. Check that you pasted it correctly."
		end
		if status == 429 then
			return nil, "Rscripts rate limit hit. Try again in a minute."
		end
		local okJson, data = pcall(function()
			return HttpService:JSONDecode(res.Body)
		end)
		if not okJson or typeof(data) ~= "table" then
			return nil, "Rscripts sent back something unreadable (status " .. tostring(status) .. ")."
		end
		if data.success ~= true then
			local msg = typeof(data.error) == "table" and data.error.message or data.error or data.message
			return nil, "Rscripts error: " .. tostring(msg or status)
		end
		return data
	end

	function RS.parse(list)
		local out = {}
		if typeof(list) ~= "table" then
			return out
		end
		for _, s in ipairs(list) do
			if typeof(s) == "table" and s.title then
				local g = typeof(s.game) == "table" and s.game or nil
				local c = typeof(s.creator) == "table" and s.creator or nil
				local r = typeof(s.risk) == "table" and s.risk or nil
				out[#out + 1] = {
					provider = "Rscripts",
					title = tostring(s.title),
					slug = s.slug,
					id = s.id,
					source = (typeof(s.script) == "string" and #s.script > 0) and s.script or nil,
					rawUrl = typeof(s.rawScript) == "string" and s.rawScript or nil,
					game = g and g.title and tostring(g.title) or nil,
					gameId = g and g.placeId or nil,
					universal = g == nil,
					verified = c ~= nil and c.isVerified == true,
					key = s.isKeySystem == true,
					patched = s.isPatched == true,
					views = s.views or 0,
					risk = r and tonumber(r.score) or nil,
				}
			end
		end
		return out
	end

	function RS.fetch(query, flt)
		local hasQuery = query ~= nil and query ~= ""
		if not hasQuery and not FS.active(flt) then
			local data, err = RS.get("trending")
			if not data then
				return nil, err
			end
			local list, seen = {}, {}
			local d = typeof(data.data) == "table" and data.data or {}
			for _, group in ipairs({ d.trending, d.rising }) do
				for _, item in ipairs(RS.parse(group)) do
					local k = tostring(item.slug or item.title)
					if not seen[k] then
						seen[k] = true
						list[#list + 1] = item
					end
				end
			end
			if #list == 0 then
				return nil, "Rscripts returned no trending scripts."
			end
			return list
		end

		local path = "scripts?limit=24"
		if hasQuery then
			path = path .. "&q=" .. HttpService:UrlEncode(query)
		else
			path = path .. "&sort=trending"
		end
		if flt.placeId then
			path = path .. "&placeId=" .. flt.placeId
		end
		if flt.verified then
			path = path .. "&verifiedOnly=true"
		end
		if flt.keyless then
			path = path .. "&noKeySystem=true"
		end
		local data, err = RS.get(path)
		if not data then
			return nil, err
		end
		local list = FS.apply(RS.parse(data.data), flt)
		if #list == 0 then
			return nil, hasQuery and ('No Rscripts scripts found for "' .. query .. '" with these filters.') or "No Rscripts scripts match your filters."
		end
		return list
	end

	function FS.scriptblox(query, flt)
		local q = query
		if (q == nil or q == "") and flt.name then
			q = flt.name -- ScriptBlox has no game filter, so search by the game's name and filter the results
		end
		local data
		if q and q ~= "" then
			local url = SCRIPTBLOX_API .. "search?q=" .. HttpService:UrlEncode(q) .. "&max=20"
			if flt.verified then
				url = url .. "&verified=1"
			end
			if flt.keyless then
				url = url .. "&key=0"
			end
			data = fetchJson(url)
		else
			data = fetchJson(SCRIPTBLOX_API .. "trending")
		end
		if not data then
			return nil, "Couldn't reach ScriptBlox. Check that your executor allows HTTP requests."
		end
		local list = FS.apply(parseScripts(data), flt)
		if #list == 0 then
			if FS.active(flt) then
				return nil, "No ScriptBlox scripts match your filters."
			end
			return nil, (q and q ~= "") and ('No scripts found for "' .. q .. '".') or "ScriptBlox returned no trending scripts."
		end
		return list
	end

	-- xScripts: every script comes from a GitHub repo. The first 3 lines of each file hold its info:
	--   local Key = true/false
	--   local Verified = true/false
	--   local GameId = "Universal" (or the game's id, several ids can be separated by commas)
	local XS = { owner = "redxs-dosx", repo = "xScripts", branch = "main", items = nil, loading = false, maxShown = 50 }

	function XS.parseHeader(body)
		local info = { key = false, verified = false, universal = true, gameIds = {} }
		body = body:gsub("^\239\187\191", "") -- strip a UTF-8 BOM
		local lineNo = 0
		for line in (body .. "\n"):gmatch("(.-)\r?\n") do
			lineNo += 1
			if lineNo > 3 then
				break
			end
			line = line:gsub("%-%-.*$", "")
			local name, value = line:match("^%s*local%s+([%w_]+)%s*=%s*(.-)%s*;?%s*$")
			if name and value then
				name = name:lower()
				if name == "key" then
					info.key = value:lower() == "true"
				elseif name == "verified" then
					info.verified = value:lower() == "true"
				elseif name == "gameid" then
					if value:lower():find("universal", 1, true) then
						info.universal = true
					else
						local ids = {}
						for id in value:gmatch("%d+") do
							table.insert(ids, id)
						end
						if #ids > 0 then
							info.universal = false
							info.gameIds = ids
						end
					end
				end
			end
		end
		return info
	end

	function XS.makeItem(path, body, rawUrl)
		local info = XS.parseHeader(body)
		local file = path:match("([^/]+)$") or path
		return {
			provider = "xScripts",
			title = (file:gsub("%.luau?$", "")),
			path = path,
			source = body,
			rawUrl = rawUrl,
			universal = info.universal,
			gameIds = info.gameIds,
			gameId = info.gameIds[1],
			game = (not info.universal and info.gameIds[1]) and ("Game " .. table.concat(info.gameIds, ", ")) or nil,
			verified = info.verified,
			key = info.key,
		}
	end

	-- Lists every .lua / .luau file in the repo with one API call, then downloads them a few at a time
	function XS.build()
		local base = "https://raw.githubusercontent.com/" .. XS.owner .. "/" .. XS.repo .. "/" .. XS.branch .. "/"
		local data = fetchJson("https://api.github.com/repos/" .. XS.owner .. "/" .. XS.repo .. "/git/trees/" .. XS.branch .. "?recursive=1")
		if not data or typeof(data.tree) ~= "table" then
			return nil, "Couldn't read the xScripts repo. GitHub may be rate limiting you, try again in a while."
		end
		local files = {}
		for _, node in ipairs(data.tree) do
			if typeof(node) == "table" and node.type == "blob" and typeof(node.path) == "string" and node.path:lower():match("%.luau?$") then
				table.insert(files, node.path)
			end
		end
		if #files == 0 then
			return nil, "The xScripts repo has no scripts yet."
		end

		local results, cursor, active = {}, 0, 0
		local function worker()
			while true do
				cursor += 1
				local i = cursor
				local path = files[i]
				if not path then
					break
				end
				local encoded = (path:gsub("[^/]+", function(seg)
					return HttpService:UrlEncode(seg)
				end))
				local url = base .. encoded
				local body = fetchUrl(url)
				if body then
					results[i] = XS.makeItem(path, body, url)
				end
			end
			active -= 1
		end
		for _ = 1, math.min(8, #files) do
			active += 1
			task.spawn(worker)
		end
		local waited = 0
		while active > 0 and waited < 60 do
			task.wait(0.1)
			waited += 0.1
		end

		local items = {}
		for i = 1, #files do
			if results[i] then
				table.insert(items, results[i])
			end
		end
		if #items == 0 then
			return nil, "Couldn't download any xScripts scripts. Check that your executor allows HTTP requests."
		end
		table.sort(items, function(a, b)
			return a.title:lower() < b.title:lower()
		end)
		return items
	end

	-- Loaded once per session; searches after that are instant
	function XS.load()
		if XS.items then
			return XS.items
		end
		if XS.loading then
			local waited = 0
			while XS.loading and waited < 70 do
				task.wait(0.2)
				waited += 0.2
			end
			if XS.items then
				return XS.items
			end
			return nil, "xScripts didn't finish loading."
		end
		XS.loading = true
		local ok, items, err = pcall(XS.build)
		XS.loading = false
		if not ok then
			return nil, "Couldn't read the xScripts repo."
		end
		if items then
			XS.items = items
		end
		return items, err
	end

	local function xsMatchesGame(item)
		for _, id in ipairs(item.gameIds) do
			if id == tostring(game.PlaceId) or id == tostring(game.GameId) then
				return true
			end
		end
		return false
	end

	function XS.fetch(query, flt)
		local items, err = XS.load()
		if not items then
			return nil, err
		end
		local q = (query or ""):lower()
		local list = {}
		for _, it in ipairs(items) do
			local keep = true
			if flt.verified and not it.verified then
				keep = false
			end
			if flt.keyless and it.key then
				keep = false
			end
			if keep and flt.placeId then
				keep = false
				for _, id in ipairs(it.gameIds) do
					if id == flt.placeId or (flt.universeId and id == flt.universeId) then
						keep = true
					end
				end
			end
			if keep and q ~= "" then
				keep = it.title:lower():find(q, 1, true) ~= nil
					or (it.game ~= nil and it.game:lower():find(q, 1, true) ~= nil)
					or (it.universal and ("universal"):find(q, 1, true) ~= nil)
			end
			if keep then
				table.insert(list, it)
			end
		end
		if #list == 0 then
			if q ~= "" then
				return nil, 'No xScripts scripts found for "' .. query .. '".'
			end
			return nil, "No xScripts scripts match your filters."
		end
		-- scripts made for the game you're in first, then universal ones, then the rest
		local function rank(it)
			if xsMatchesGame(it) then
				return 1
			end
			return it.universal and 2 or 3
		end
		table.sort(list, function(a, b)
			local ra, rb = rank(a), rank(b)
			if ra ~= rb then
				return ra < rb
			end
			return a.title:lower() < b.title:lower()
		end)
		while #list > XS.maxShown do
			table.remove(list)
		end
		return list
	end

	function FS.fetch(query, flt)
		if provider == "xScripts" then
			return XS.fetch(query, flt)
		end
		if provider == "Rscripts" then
			return RS.fetch(query, flt)
		end
		return FS.scriptblox(query, flt)
	end

	pcall(function()
		if typeof(isfile) == "function" and isfile(RS.keyFile) then
