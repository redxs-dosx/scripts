	-- Search results usually include the source; otherwise ask the raw endpoint
	local function getSource(item)
		if item.provider == "xScripts" then
			if item.source and #item.source > 0 then
				return item.source
			end
			return item.rawUrl and fetchUrl(item.rawUrl) or nil
		end
		if item.provider == "Rscripts" then
			if item.source then
				return item.source
			end
			if item.rawUrl then
				local body = fetchUrl(item.rawUrl)
				if body then
					return body
				end
			end
			if item.slug then
				local data = RS.get("scripts/" .. HttpService:UrlEncode(tostring(item.slug)))
				local d = data and data.data
				if typeof(d) == "table" and typeof(d.script) == "string" and #d.script > 0 then
					return d.script
				end
			end
			return nil
		end
		if item.source and #item.source > 0 then
			return item.source
		end
		for _, key in ipairs({ item.slug, item.id }) do
			if key then
				local body = fetchUrl(SCRIPTBLOX_API .. "raw/" .. HttpService:UrlEncode(tostring(key)))
				if body then
					local ok, data = pcall(function()
						return HttpService:JSONDecode(body)
					end)
					if ok and typeof(data) == "table" then
						if typeof(data.script) == "string" and #data.script > 0 then
							return data.script
						end
					elseif body:sub(1, 1) ~= "{" then
						return body
					end
				end
			end
		end
		return nil
	end

