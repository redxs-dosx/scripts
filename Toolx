-- Player mods (walkspeed, jump power, anti-fling)
---------------------------------------------------------------------
local Mods = {}
do
	local state = { walk = false, jump = false, fling = false }
	local values = { walk = 16, jump = 50 }
	local saved = {}
	local steppedConn, heartConn
	local lastSafeCF

	local partCache, cacheTime = {}, 0

	local function getHumanoid()
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		return hum, root
	end

	local function refreshCache()
		table.clear(partCache)
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player and other.Character then
				for _, d in ipairs(other.Character:GetDescendants()) do
					if d:IsA("BasePart") then
						table.insert(partCache, d)
					end
				end
			end
		end
	end

	-- Anti-fling part 1: other players' parts never collide with you
	local function onStepped()
		if not state.fling then
			return
		end
		local now = os.clock()
		if now - cacheTime > 1 then
			cacheTime = now
			refreshCache()
		end
		for i = #partCache, 1, -1 do
			local part = partCache[i]
			if part.Parent then
				if part.CanCollide then
					part.CanCollide = false
				end
			else
				table.remove(partCache, i)
			end
		end
	end

	local function onHeartbeat()
		local hum, root = getHumanoid()
		if not hum or not root then
			return
		end

		if state.walk then
			hum.WalkSpeed = values.walk
		end
		if state.jump then
			hum.UseJumpPower = true
			hum.JumpPower = values.jump
		end

		-- Anti-fling part 2: cancel crazy velocities and snap back to the last safe spot
		if state.fling then
			local lv = root.AssemblyLinearVelocity
			local av = root.AssemblyAngularVelocity
			local horizontal = Vector3.new(lv.X, 0, lv.Z).Magnitude
			local limit = math.max(120, hum.WalkSpeed * 3)
			if av.Magnitude > 60 or horizontal > limit or lv.Y > 200 then
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
				if lastSafeCF then
					root.CFrame = lastSafeCF
				end
			else
				lastSafeCF = root.CFrame
			end
		end
	end

	local function refresh()
		if state.walk or state.jump or state.fling then
			if not heartConn then
				heartConn = RunService.Heartbeat:Connect(onHeartbeat)
				steppedConn = RunService.Stepped:Connect(onStepped)
			end
		else
			if heartConn then
				heartConn:Disconnect()
				heartConn = nil
			end
			if steppedConn then
				steppedConn:Disconnect()
				steppedConn = nil
			end
		end
	end

	function Mods.SetWalk(on)
		state.walk = on
		local hum = getHumanoid()
		if on then
			if hum and saved.walk == nil then
				saved.walk = hum.WalkSpeed
			end
		else
			if hum and saved.walk then
				hum.WalkSpeed = saved.walk
			end
			saved.walk = nil
		end
		refresh()
	end

	function Mods.SetWalkValue(v)
		values.walk = v
	end

	function Mods.SetJump(on)
		state.jump = on
		local hum = getHumanoid()
		if on then
			if hum and saved.jump == nil then
				saved.jump = { power = hum.JumpPower, usePower = hum.UseJumpPower }
			end
		else
			if hum and saved.jump then
				hum.JumpPower = saved.jump.power
				hum.UseJumpPower = saved.jump.usePower
			end
			saved.jump = nil
		end
		refresh()
	end

	function Mods.SetJumpValue(v)
		values.jump = v
	end

	function Mods.SetAntiFling(on)
		state.fling = on
		lastSafeCF = nil
		table.clear(partCache)
		cacheTime = 0
		refresh()
	end

	function Mods.Unload()
		Mods.SetWalk(false)
		Mods.SetJump(false)
		Mods.SetAntiFling(false)
	end
end

