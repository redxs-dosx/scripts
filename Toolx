-- Noclip (Norm NC = collisions off, Wall TP = teleport through walls)
---------------------------------------------------------------------
local Noclip = {}
do
	local conn
	local saved = {} -- part -> true for parts we switched CanCollide off on
	local lastTp = 0

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	pcall(function()
		rayParams.RespectCanCollide = true
		overlapParams.RespectCanCollide = true
	end)

	local function restore()
		for part in pairs(saved) do
			if part.Parent then
				pcall(function()
					part.CanCollide = true
				end)
			end
			saved[part] = nil
		end
	end

	-- Norm NC: the humanoid keeps turning collisions back on, so switch them off every physics step
	local function normStep()
		local char = player.Character
		if not char then
			return
		end
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				saved[part] = true
				part.CanCollide = false
			end
		end
	end

	-- Wall TP: collisions stay on. Walking into a wall moves you to the first free spot on the other side.
	local function wallStep()
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not (hum and root) or hum.Health <= 0 then
			return
		end
		local move = hum.MoveDirection
		local dir = Vector3.new(move.X, 0, move.Z)
		if dir.Magnitude < 0.1 or os.clock() - lastTp < 0.2 then
			return
		end
		dir = dir.Unit

		rayParams.FilterDescendantsInstances = { char }
		overlapParams.FilterDescendantsInstances = { char }
		local hit = workspace:Raycast(root.Position, dir * 3, rayParams)
		if not hit then
			return
		end

		for d = 0.5, 50, 0.5 do
			local point = hit.Position + dir * d
			local center = Vector3.new(point.X, root.Position.Y, point.Z)
			local blocked = workspace:GetPartBoundsInBox(CFrame.new(center), Vector3.new(2.4, 5, 2.4), overlapParams)
			if #blocked == 0 then
				lastTp = os.clock()
				root.CFrame = CFrame.new(center, center + dir)
				return
			end
		end
	end

	-- mode is "Norm NC", "Wall TP" or nil (off)
	function Noclip.Set(mode)
		if conn then
			conn:Disconnect()
			conn = nil
		end
		restore()
		if mode == "Norm NC" then
			conn = RunService.Stepped:Connect(normStep)
		elseif mode == "Wall TP" then
			conn = RunService.Heartbeat:Connect(wallStep)
		end
	end

	function Noclip.Unload()
		Noclip.Set(nil)
	end
end

