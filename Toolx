	local function togglePlayerList()
		pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, not playerListOn())
		end)
	end

	local function emotesOpen()
		local ok, v = pcall(function()
			return GuiService:GetEmotesMenuOpen()
		end)
		return ok and v == true
	end
	local function toggleEmotes()
		pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.EmotesMenu, true)
		end)
		pcall(function()
			GuiService:SetEmotesMenuOpen(not emotesOpen())
		end)
	end

	local invState = false
	local function inventoryOpen()
		local ok, v = pcall(function()
			return require(CoreGui.RobloxGui.Modules.BackpackScript).IsOpen
		end)
		if ok and type(v) == "boolean" then
			return v
		end
		return invState
	end
	local function toggleInventory()
		pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
		end)
		local ok = pcall(function()
			require(CoreGui.RobloxGui.Modules.BackpackScript):OpenClose()
		end)
		if not ok then
			sendKey(Enum.KeyCode.Backquote)
		end
		invState = not invState
	end

	-- report what each button did, so a button that does nothing is easy to spot
	do
		local rawChat, rawList, rawEmotes, rawInventory = toggleChat, togglePlayerList, toggleEmotes, toggleInventory
		toggleChat = function()
			rawChat()
			setActionStatus("Chat: " .. (chatVisible() and "shown" or "hidden"))
		end
		togglePlayerList = function()
			rawList()
			setActionStatus("Leaderboard: " .. (playerListOn() and "on" or "off"))
		end
		toggleEmotes = function()
			rawEmotes()
			task.wait(0.2)
			setActionStatus("Emotes: " .. (emotesOpen() and "open" or "closed"))
		end
		toggleInventory = function()
			rawInventory()
			setActionStatus("Inventory: " .. (inventoryOpen() and "open" or "closed or unknown"))
		end
	end

	-- unread chat counter
	local unread = 0
	local function trackUnread(setBadge)
		local function onMessage()
			if not chatVisible() then
				unread = unread + 1
				setBadge(unread)
			end
		end
		pcall(function()
			sconnect(TextChatService.MessageReceived, onMessage)
		end)
		pcall(function()
			local folder = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
			local ev = folder and folder:FindFirstChild("OnMessageDoneFiltering")
			if ev then
				sconnect(ev.OnClientEvent, onMessage)
			end
		end)
	end

	-- health: update(percent, isFull)
	local function bindHealth(update, token)
		local hconn
		local function hook(char)
			if hconn then
				hconn:Disconnect()
				hconn = nil
			end
			if not char then
				return
			end
			task.spawn(function()
				local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
				if not hum or not alive or token ~= styleToken then
					return
				end
				if hconn then
					hconn:Disconnect()
				end
				local function upd()
					local mh = math.max(hum.MaxHealth, 1)
					update(math.clamp(hum.Health / mh, 0, 1), hum.Health >= hum.MaxHealth)
				end
				hconn = hum.HealthChanged:Connect(upd)
				upd()
			end)
		end
		sconnect(LocalPlayer.CharacterAdded, hook)
		onClean(function()
			if hconn then
				hconn:Disconnect()
			end
		end)
		hook(LocalPlayer.Character)
	end

	local function accountText()
		local ok, under13 = pcall(function()
			return LocalPlayer:GetUnder13()
		end)
		return (ok and under13) and "Account: <13" or "Account: 13+"
	end

	local function statList()
		local list = {}
		local ls = LocalPlayer:FindFirstChild("leaderstats")
		if ls then
			for _, v in ipairs(ls:GetChildren()) do
				if v:IsA("IntValue") or v:IsA("NumberValue") or v:IsA("StringValue") then
					list[#list + 1] = v
				end
			end
		end
		return list
	end

	local function statSig()
		local t = {}
		for _, v in ipairs(statList()) do
			t[#t + 1] = v.Name
		end
		return table.concat(t, "|")
	end

