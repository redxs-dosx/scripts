	local function drawEmote(f, on)
		clear(f)
		shape(f, 2, 2, 20, 20, 10, on)
		local c = on and DARK or WHITE
		box(f, 8, 8, 3, 3, 1, c)
		box(f, 13, 8, 3, 3, 1, c)
		local clip = mk("Frame", {
			Position = UDim2.fromOffset(7, 13),
			Size = UDim2.fromOffset(10, 4),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			Parent = f,
		})
		local arc = mk("Frame", {
			Position = UDim2.fromOffset(2, -4),
			Size = UDim2.fromOffset(6, 6),
			BackgroundTransparency = 1,
			Parent = clip,
		})
		corner(arc, 3)
		mk("UIStroke", {
			Thickness = 2,
			Color = c,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = arc,
		})
	end

	local function drawPack(f, on)
		clear(f)
		outline(f, 7, 1, 10, 10, 5, WHITE, 2)
		shape(f, 3, 6, 18, 17, 6, on)
		box(f, 7, 15, 10, 2, 1, on and DARK or WHITE)
	end

	-- unread-message badge (red circle)
	local function makeBadge(parent, position)
		local badge = mk("Frame", {
			Name = "Unread",
			Size = UDim2.fromOffset(18, 18),
			Position = position,
			BackgroundColor3 = Color3.fromRGB(226, 35, 26),
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = 5,
			Parent = parent,
		})
		corner(badge, 9)
		local label = mk("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 6,
			Font = Enum.Font.SourceSansBold,
			TextSize = 13,
			TextColor3 = WHITE,
			Parent = badge,
		})
		return function(n)
			badge.Visible = n > 0
			label.Text = (n >= 100) and "!" or tostring(n)
		end
	end

	local function healthColor(p)
		if p <= 0.1 then
			return RED
		end
		if p >= 0.8 then
			return GREEN
		end
		if p < 0.5 then
			return RED:Lerp(YELLOW, (p - 0.1) / 0.4)
		end
		return YELLOW:Lerp(GREEN, (p - 0.5) / 0.3)
	end

	------------------------------------------------------------------
	-- the real topbar: hide / restore
	------------------------------------------------------------------
	local enforceHidden = false
	local hidden = {} -- real topbar ScreenGui -> its original Enabled value
	local hiddenInner = {} -- CoreGui.TopBarApp.TopBarApp -> { prop, was }
	local hiddenConns = {}
	local usedSetCore = false
	local statusReal = "Real topbar: untouched"
	local statusAction = ""
	local loggedChildren = false

	local function pushStatus()
		if Topbar.OnStatus then
			pcall(Topbar.OnStatus, statusReal .. (statusAction ~= "" and ("\n" .. statusAction) or ""))
		end
	end
	local function setRealStatus(text)
		if text ~= statusReal then
			statusReal = text
			pushStatus()
		end
	end
	local function setActionStatus(text)
		statusAction = text
		pushStatus()
	end

	local function isEnabled(g)
		local ok, v = pcall(function()
			return g.Enabled
		end)
		return (not ok) or v
	end

	-- every ScreenGui in CoreGui that looks like Roblox's topbar
	local function findRealTopbars()
		local found = {}
		local ok, children = pcall(function()
			return CoreGui:GetChildren()
		end)
		if not ok then
			return found, nil
		end
		for _, child in ipairs(children) do
			local lname = child.Name:lower()
			if
				child:IsA("ScreenGui")
				and child ~= gui
				and (lname:find("topbar", 1, true) or lname:find("top_bar", 1, true) or lname:find("unibar", 1, true))
			then
				found[#found + 1] = child
			end
		end
		return found, children
	end

	-- CoreGui > TopBarApp > TopBarApp (the inner object inside the real topbar ScreenGui)
	local function findInnerTopbar()
		local ok, inner = pcall(function()
			local outer = CoreGui:FindFirstChild("TopBarApp")
			return outer and outer:FindFirstChild("TopBarApp")
		end)
		if ok then
			return inner
		end
		return nil
	end

	-- ScreenGuis toggle with Enabled, normal gui objects with Visible
	local function innerProp(obj)
		if obj:IsA("LayerCollector") then
			return "Enabled"
		end
		if obj:IsA("GuiObject") then
			return "Visible"
		end
		return nil
	end

	local function applyInnerHidden()
		local inner = findInnerTopbar()
		local prop = inner and innerProp(inner)
		if not prop then
			return
		end
		if hiddenInner[inner] == nil then
			local okRead, was = pcall(function()
				return inner[prop]
			end)
			hiddenInner[inner] = { prop = prop, was = okRead and was or true }
			-- if Roblox turns it back on, turn it off again
			pcall(function()
				hiddenConns[#hiddenConns + 1] = inner:GetPropertyChangedSignal(prop):Connect(function()
					if enforceHidden and inner[prop] then
						pcall(function()
							inner[prop] = false
						end)
					end
				end)
			end)
		end
		pcall(function()
			inner[prop] = false
		end)
	end

	local function applyHidden()
		local list, children = findRealTopbars()
		local names = {}
		local stillOn = {}
		for _, g in ipairs(list) do
			names[#names + 1] = g.Name
			if hidden[g] == nil then
				hidden[g] = isEnabled(g)
				-- if Roblox turns it back on, turn it off again
				pcall(function()
					hiddenConns[#hiddenConns + 1] = g:GetPropertyChangedSignal("Enabled"):Connect(function()
						if enforceHidden and isEnabled(g) then
							pcall(function()
								g.Enabled = false
							end)
						end
					end)
				end)
			end
			if isEnabled(g) then
				pcall(function()
					g.Enabled = false
				end)
			end
			if isEnabled(g) then
				stillOn[#stillOn + 1] = g.Name
			end
		end

		applyInnerHidden()

		-- older clients also honour this
		if not usedSetCore then
			usedSetCore = true
			pcall(function()
				StarterGui:SetCore("TopbarEnabled", false)
			end)
		end

		if #list > 0 then
			if #stillOn == 0 then
				setRealStatus("Real topbar: hidden (" .. table.concat(names, ", ") .. ")")
			else
				setRealStatus("Real topbar: could not disable " .. table.concat(stillOn, ", "))
			end
		elseif children == nil then
			setRealStatus("Real topbar: can't read CoreGui, only asked Roblox to hide it")
		else
			setRealStatus("Real topbar: not found in CoreGui, only asked Roblox to hide it")
			if not loggedChildren then
				loggedChildren = true
				local list2 = {}
				for _, c in ipairs(children) do
					list2[#list2 + 1] = c.Name
				end
				warn("[Toolx] topbar not found, CoreGui contains: " .. table.concat(list2, ", "))
			end
		end
	end

	local function setRealVisible(visible)
		enforceHidden = not visible
		if visible then
			for _, c in ipairs(hiddenConns) do
				c:Disconnect()
			end
			table.clear(hiddenConns)
			for g, was in pairs(hidden) do
				pcall(function()
					g.Enabled = was
				end)
			end
			table.clear(hidden)
			for inner, info in pairs(hiddenInner) do
				pcall(function()
					inner[info.prop] = info.was
				end)
			end
			table.clear(hiddenInner)
			if usedSetCore then
				usedSetCore = false
				pcall(function()
					StarterGui:SetCore("TopbarEnabled", true)
				end)
			end
			loggedChildren = false
			setRealStatus("Real topbar: showing")
		else
			applyHidden()
		end
	end

	------------------------------------------------------------------
	-- actions (what the buttons actually do)
	------------------------------------------------------------------
	local function sendKey(key)
		if not VIM then
			return false
		end
		return pcall(function()
			VIM:SendKeyEvent(true, key, false, game)
			task.wait(0.05)
			VIM:SendKeyEvent(false, key, false, game)
		end)
	end

	-- is the real menu window showing? (falls back to the MenuIsOpen flag)
	local function isMenuOpen()
		local ok, shield = pcall(function()
			return CoreGui.RobloxGui.SettingsShield
		end)
		if ok and shield then
			local ok2, v = pcall(function()
				return shield.Visible
			end)
			if ok2 and type(v) == "boolean" then
				return v
			end
		end
		local ok3, flag = pcall(function()
			return GuiService.MenuIsOpen
		end)
		return ok3 and flag == true
	end

	-- true when we can actually see the menu window (so a "no change" result is believable)
	local function canSeeMenuWindow()
		local ok, shield = pcall(function()
			return CoreGui.RobloxGui.SettingsShield
		end)
		return ok and shield ~= nil
	end

	local function toggleMenu()
		local before = isMenuOpen()
		-- the menu button just presses Escape, same as the keyboard
		if sendKey(Enum.KeyCode.Escape) then
			task.wait(0.3)
			if canSeeMenuWindow() then
				setActionStatus("Menu: Escape pressed (" .. (isMenuOpen() and "open" or "closed") .. ")")
			else
				setActionStatus("Menu: Escape pressed")
			end
			return
		end

		-- no VirtualInputManager on this executor: fall back to Roblox's own menu module
		local want = not before
		local ok = pcall(function()
			require(CoreGui.RobloxGui.Modules.Settings.SettingsHub):SetVisibility(want)
		end)
		if not ok then
			ok = pcall(function()
				GuiService:SetMenuIsOpen(want)
			end)
		end
		setActionStatus(ok and ("Menu: " .. (want and "opened" or "closed") .. " (no Escape key available)") or "Menu: nothing worked")
	end

	local chatState = true
	local function usingTextChat()
		local ok, v = pcall(function()
			return TextChatService.ChatVersion == Enum.ChatVersion.TextChatService
		end)
		return ok and v == true
	end

	local function chatVisible()
		if usingTextChat() then
			local ok, v = pcall(function()
				return TextChatService.ChatWindowConfiguration.Enabled
			end)
			if ok and type(v) == "boolean" then
				return v
			end
		else
			local ok, v = pcall(function()
				return StarterGui:GetCore("ChatActive")
			end)
			if ok and type(v) == "boolean" then
				return v
			end
		end
		return chatState
	end

	-- the actual chat window of the new chat (CoreGui.ExperienceChat.appLayout.chatWindow)
	local function experienceChatWindow()
		local ok, w = pcall(function()
			return CoreGui.ExperienceChat.appLayout.chatWindow
		end)
		if ok and w then
			return w
		end
		return nil
	end

	local function toggleChat()
		local want = not chatVisible()
		chatState = want
		if usingTextChat() then
			pcall(function()
				TextChatService.ChatWindowConfiguration.Enabled = want
			end)
			pcall(function()
				TextChatService.ChatInputBarConfiguration.Enabled = want
			end)
			-- also show / hide the window itself, in case the configuration is ignored
			local window = experienceChatWindow()
			if window then
				pcall(function()
					window.Visible = want
				end)
			end
		else
			local ok = pcall(function()
				StarterGui:SetCore("ChatActive", want)
			end)
			if not ok then
				pcall(function()
					StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, want)
				end)
			end
		end
	end

