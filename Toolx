-- Notifications (small toasts, top right). Work while the window is minimized.
---------------------------------------------------------------------
local notifyEnabled = true
local TOAST_W = 236
local MAX_TOASTS = 4
local toastColors = {
	info = theme.accent,
	success = Color3.fromRGB(76, 201, 120),
	warn = theme.amber,
	error = theme.red,
}

local toastHost = new("Frame", {
	Name = "Toasts",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -14, 0, 56),
	Size = UDim2.fromOffset(TOAST_W, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundTransparency = 1,
	ZIndex = 10,
}, gui)
new("UIListLayout", {
	Padding = UDim.new(0, 6),
	SortOrder = Enum.SortOrder.LayoutOrder,
	HorizontalAlignment = Enum.HorizontalAlignment.Right,
}, toastHost)

local toastList = {}
local toastSeq = 0

local function dismissToast(t)
	if t.gone then
		return
	end
	t.gone = true
	for i, v in ipairs(toastList) do
		if v == t then
			table.remove(toastList, i)
			break
		end
	end
	tween(t.card, 0.25, { GroupTransparency = 1 })
	task.delay(0.3, function()
		t.card:Destroy()
	end)
end

-- kind: "info" (default) | "success" | "warn" | "error"
local function notify(text, kind, duration)
	-- stay quiet while saved options are being re-applied at startup
	if not notifyEnabled or loadingOptions or not gui.Parent then
		return
	end
	toastSeq += 1
	local card = new("CanvasGroup", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.bg,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		LayoutOrder = toastSeq,
	}, toastHost)
	corner(card, 10)
	stroke(card, 0.85)
	new("UIPadding", {
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 10),
	}, card)
	-- accent strip on the left edge (cancels the padding so it reaches the card's edges)
	new("Frame", {
		Position = UDim2.new(0, -12, 0, -8),
		Size = UDim2.new(0, 3, 1, 16),
		BackgroundColor3 = toastColors[kind or "info"] or toastColors.info,
		BorderSizePixel = 0,
	}, card)
	new("TextLabel", {
		Text = tostring(text),
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = theme.text,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
	}, card)

	local t = { card = card, gone = false }
	table.insert(toastList, t)

	-- tap a toast to dismiss it
	local hit = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(-12, -8),
		Size = UDim2.new(1, 22, 1, 16),
		ZIndex = 2,
	}, card)
	hit.Activated:Connect(function()
		dismissToast(t)
	end)

	tween(card, 0.25, { GroupTransparency = 0 })
	task.delay(duration or 2.8, function()
		dismissToast(t)
	end)

	while #toastList > MAX_TOASTS do
		dismissToast(toastList[1])
	end
end

