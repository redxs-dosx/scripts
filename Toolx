	function api:Button(text, callback, danger)
		local r = row(36)
		local lbl = new("TextLabel", {
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = danger and theme.red or theme.text,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
		}, r)
		connect(r.MouseEnter, function()
			tween(r, 0.15, { BackgroundTransparency = 0.15 })
		end)
		connect(r.MouseLeave, function()
			tween(r, 0.15, { BackgroundTransparency = 0.35, BackgroundColor3 = theme.surface })
		end)
		connect(r.Activated, function()
			r.BackgroundColor3 = theme.accent
			r.BackgroundTransparency = 0.5
			tween(r, 0.35, { BackgroundColor3 = theme.surface, BackgroundTransparency = 0.35 })
			if callback then
				task.spawn(callback, lbl)
			end
		end)
		return r, lbl
	end

	function api:Toggle(text, default, callback, key)
		local state = default and true or false
		local r = row(38)
		local label = new("TextLabel", {
			RichText = true,
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = theme.text,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(1, -64, 1, 0),
		}, r)

		local track = new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(38, 20),
			BackgroundColor3 = state and theme.accent or theme.off,
			BorderSizePixel = 0,
		}, r)
		corner(track, 10)
		local knob = new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = state and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
			BackgroundColor3 = theme.white,
			BorderSizePixel = 0,
		}, track)
		corner(knob, 8)

		local function set(v, silent)
			state = v
			tween(knob, 0.25, { Position = v and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0) }, Enum.EasingStyle.Back)
			tween(track, 0.2, { BackgroundColor3 = v and theme.accent or theme.off })
			if not silent and callback then
				task.spawn(callback, v)
			end
			if not silent and key then
				optionChanged()
			end
		end

		local enabled = true
		local function setEnabled(v, hint)
			local hintText = (not v and hint) and ('  <font size="10" color="#e0a040">' .. hint .. "</font>") or ""
			label.Text = text .. hintText
			if v == enabled then
				return
			end
			enabled = v
			if not v and state then
				set(false)
			end
			tween(label, 0.25, { TextColor3 = v and theme.text or theme.dim })
			tween(r, 0.25, { BackgroundTransparency = v and 0.35 or 0.7 })
			tween(track, 0.25, { BackgroundTransparency = v and 0 or 0.55 })
			tween(knob, 0.25, { BackgroundTransparency = v and 0 or 0.4 })
		end

		connect(r.MouseEnter, function()
			if enabled then
				tween(r, 0.15, { BackgroundTransparency = 0.2 })
			end
		end)
		connect(r.MouseLeave, function()
			tween(r, 0.15, { BackgroundTransparency = enabled and 0.35 or 0.7 })
		end)
		connect(r.Activated, function()
			if enabled then
				set(not state)
			end
		end)

		local comp = {
			Set = set,
			Get = function()
				return state
			end,
			SetEnabled = setEnabled,
			IsEnabled = function()
				return enabled
			end,
		}
		if key then
			registry[key] = comp
		end
		return comp
	end

	-- Segmented picker: one button per option, callback(name) fires when the choice changes
	function api:Choice(text, options, default, callback, key)
		local r = row(66)
		new("TextLabel", {
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = theme.text,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(1, -24, 0, 20),
		}, r)
		local strip = new("Frame", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 30),
			Size = UDim2.new(1, -24, 0, 28),
		}, r)
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, strip)

		local count = #options
		local buttons = {}
		local selected = default or options[1]

		local function paint()
			for opt, b in pairs(buttons) do
				local on = opt == selected
				tween(b, 0.2, {
					BackgroundColor3 = on and theme.accent or theme.off,
					TextColor3 = on and theme.white or theme.dim,
				})
			end
		end

		local function choose(name, silent)
			if buttons[name] == nil then
				return
			end
			local changed = name ~= selected
			selected = name
			paint()
			if changed and not silent then
				if callback then
					task.spawn(callback, name)
				end
				if key then
					optionChanged()
				end
			end
		end

		for i, opt in ipairs(options) do
			local b = new("TextButton", {
				Text = opt,
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				AutoButtonColor = false,
				BackgroundColor3 = theme.off,
				TextColor3 = theme.dim,
				BorderSizePixel = 0,
				Size = UDim2.new(1 / count, -math.floor(6 * (count - 1) / count), 1, 0),
				LayoutOrder = i,
			}, strip)
			corner(b, 6)
			buttons[opt] = b
			connect(b.Activated, function()
				choose(opt)
			end)
		end
		paint()

		local comp = {
			Set = choose,
			Get = function()
				return selected
			end,
		}
		if key then
			registry[key] = comp
		end
		return comp
	end

	-- Press-a-key picker: tap the row, then press the key to bind it (Esc cancels, Backspace clears).
	-- Get / Set use the KeyCode name ("RightShift"), or "None". callback(name) fires when it changes.
	function api:Keybind(text, default, callback, key)
		local current = default or "None"
		local listening = false
		local listenConn

		local r = row(38)
		new("TextLabel", {
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = theme.text,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(1, -130, 1, 0),
		}, r)
		local chip = new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(106, 24),
			BackgroundColor3 = theme.off,
			BorderSizePixel = 0,
		}, r)
		corner(chip, 6)
		local keyLabel = new("TextLabel", {
			Text = current,
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextColor3 = theme.accent,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
		}, chip)

		local function show()
			keyLabel.Text = listening and "Press a key..." or current
			keyLabel.TextColor3 = listening and theme.amber or theme.accent
		end

		local function set(name, silent)
			if typeof(name) ~= "string" then
				return
			end
			local valid = name == "None" or (pcall(function()
				return Enum.KeyCode[name]
			end))
			if not valid then
				return
			end
			local changed = name ~= current
			current = name
			show()
			if changed and not silent then
				if callback then
					task.spawn(callback, name)
				end
				if key then
					optionChanged()
				end
			end
		end

		local function stopListening()
			listening = false
			if listenConn then
				listenConn:Disconnect()
				listenConn = nil
			end
			-- clear on the next resumption point so the same key press can't also toggle the window
			task.defer(function()
				capturingKey = false
			end)
			show()
		end

		connect(r.MouseEnter, function()
			tween(r, 0.15, { BackgroundTransparency = 0.2 })
		end)
		connect(r.MouseLeave, function()
			tween(r, 0.15, { BackgroundTransparency = 0.35 })
		end)
		connect(r.Activated, function()
			if listening then
				stopListening()
				return
			end
			listening = true
			capturingKey = true
			show()
			listenConn = connect(UserInputService.InputBegan, function(input)
				if input.UserInputType ~= Enum.UserInputType.Keyboard then
					return
				end
				if input.KeyCode == Enum.KeyCode.Escape then
					stopListening()
				elseif input.KeyCode == Enum.KeyCode.Backspace then
					stopListening()
					set("None")
				elseif input.KeyCode ~= Enum.KeyCode.Unknown then
					stopListening()
					set(input.KeyCode.Name)
				end
			end)
		end)

		local comp = {
			Set = set,
			Get = function()
				return current
			end,
		}
		if key then
			registry[key] = comp
		end
		return comp
	end

	-- Key / value row. Tapping calls onTap(currentValue); if it returns a string, that text flashes in the value.
	function api:InfoRow(key, value, onTap)
		local r = row(30)
		new("TextLabel", {
			Text = key,
			Font = Enum.Font.GothamMedium,
			TextSize = 12,
			TextColor3 = theme.dim,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(0, 96, 1, 0),
		}, r)
		local valueLabel = new("TextLabel", {
			Text = tostring(value),
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextColor3 = theme.text,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(112, 0),
			Size = UDim2.new(1, -124, 1, 0),
		}, r)

		local shown = tostring(value)
		local flashing = false

		connect(r.MouseEnter, function()
			tween(r, 0.15, { BackgroundTransparency = 0.2 })
		end)
		connect(r.MouseLeave, function()
			tween(r, 0.15, { BackgroundTransparency = 0.35 })
		end)
		connect(r.Activated, function()
			if not onTap then
				return
			end
			local result = onTap(shown)
			if typeof(result) == "string" then
				flashing = true
				valueLabel.Text = result
				valueLabel.TextColor3 = theme.accent
				task.delay(1, function()
					flashing = false
					if valueLabel.Parent then
						valueLabel.Text = shown
						valueLabel.TextColor3 = theme.text
					end
				end)
			end
		end)

		return {
			Set = function(v)
				shown = tostring(v)
				if not flashing and valueLabel.Parent then
					valueLabel.Text = shown
				end
			end,
			Get = function()
				return shown
			end,
		}
	end

	-- Scrolling box of rich-text lines (used for chat logs)
	function api:LogBox(height, maxLines, emptyText)
		maxLines = maxLines or 200
		local r = new("Frame", {
			Size = UDim2.new(1, 0, 0, height),
			BackgroundColor3 = theme.surface,
			BackgroundTransparency = 0.45,
			BorderSizePixel = 0,
			LayoutOrder = nextOrder(),
		}, scroller)
		corner(r, 8)
		stroke(r, 0.94)

		local list = new("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = theme.accent,
			ScrollBarImageTransparency = 0.4,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
		}, r)
		new("UIPadding", {
			PaddingTop = UDim.new(0, 6),
			PaddingBottom = UDim.new(0, 6),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}, list)
		new("UIListLayout", {
			Padding = UDim.new(0, 3),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, list)

		local emptyLabel = new("TextLabel", {
			Text = emptyText or "No messages yet",
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextColor3 = theme.dim,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
		}, r)

		local labels = {}
		local lineCount = 0
		local box = {}

		-- onClick (optional) makes the line tappable; if it returns a string, that text flashes on the line
		function box.Add(richText, onClick)
			-- only auto-scroll if the reader is already at the bottom
			local nearBottom = list.CanvasPosition.Y + list.AbsoluteWindowSize.Y >= list.AbsoluteCanvasSize.Y - 24
			lineCount += 1
			local lbl = new(onClick and "TextButton" or "TextLabel", {
				Text = richText,
				RichText = true,
				Font = Enum.Font.Gotham,
				TextSize = 12,
				TextColor3 = theme.text,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				BackgroundTransparency = 1,
				AutomaticSize = Enum.AutomaticSize.Y,
				Size = UDim2.new(1, 0, 0, 0),
				LayoutOrder = lineCount,
			}, list)
			if onClick then
				lbl.AutoButtonColor = false
				lbl.BackgroundColor3 = theme.accent
				lbl.Activated:Connect(function()
					lbl.BackgroundTransparency = 0.7
					tween(lbl, 0.4, { BackgroundTransparency = 1 })
					local result = onClick()
					if typeof(result) == "string" then
						lbl.Text = '<font color="#8c9bff">' .. result .. "</font>"
						task.delay(1, function()
							if lbl.Parent then
								lbl.Text = richText
							end
						end)
					end
				end)
			end
			table.insert(labels, lbl)
			if #labels > maxLines then
				table.remove(labels, 1):Destroy()
			end
			emptyLabel.Visible = false
			if nearBottom then
				task.delay(0.03, function()
					if list.Parent then
						list.CanvasPosition = Vector2.new(0, list.AbsoluteCanvasSize.Y)
					end
				end)
			end
			return lbl
		end

		function box.Clear()
			for _, l in ipairs(labels) do
				l:Destroy()
			end
			table.clear(labels)
			emptyLabel.Visible = true
		end

		return box
	end

	function api:Slider(text, min, max, default, callback, key)
		local r = row(54)
		local value = math.clamp(default, min, max)

		new("TextLabel", {
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = theme.text,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(1, -80, 0, 20),
		}, r)
		local valueLabel = new("TextLabel", {
			Text = tostring(value),
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			TextColor3 = theme.accent,
			TextXAlignment = Enum.TextXAlignment.Right,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 6),
			Size = UDim2.fromOffset(60, 20),
		}, r)

		local hit = new("Frame", {
			Active = true,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, 28),
			Size = UDim2.new(1, 0, 0, 24),
		}, r)
		local bar = new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 12, 0.5, 0),
			Size = UDim2.new(1, -24, 0, 6),
			BackgroundColor3 = theme.off,
			BorderSizePixel = 0,
		}, hit)
		corner(bar, 3)
		local fill = new("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = theme.accent,
			BorderSizePixel = 0,
		}, bar)
		corner(fill, 3)
		local knob = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = theme.white,
			BorderSizePixel = 0,
		}, bar)
		corner(knob, 7)

		local function setValue(v, silent)
			v = math.clamp(math.floor(v + 0.5), min, max)
			local changed = v ~= value
			value = v
			valueLabel.Text = tostring(v)
			local alpha = (v - min) / (max - min)
			fill.Size = UDim2.fromScale(alpha, 1)
			knob.Position = UDim2.fromScale(alpha, 0.5)
			if changed and not silent and callback then
				task.spawn(callback, v)
			end
			if changed and not silent and key then
				optionChanged()
			end
		end
		setValue(value, true)

		local dragging = false
		local function fromX(x)
			local w = bar.AbsoluteSize.X
			if w <= 0 then
				return
			end
			local alpha = math.clamp((x - bar.AbsolutePosition.X) / w, 0, 1)
			setValue(min + alpha * (max - min))
		end

		connect(hit.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				scroller.ScrollingEnabled = false
				fromX(input.Position.X)
				local c
				c = input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						scroller.ScrollingEnabled = true
						c:Disconnect()
					end
				end)
			end
		end)
		connect(UserInputService.InputChanged, function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				fromX(input.Position.X)
			end
		end)

		local comp = {
			Set = setValue,
			Get = function()
				return value
			end,
		}
		if key then
			registry[key] = comp
		end
		return comp
	end

	-- Empty frame placed in the page's list. With a height it is fixed; without one it grows to fit its children.
	function api:Container(height)
		local f = new("Frame", {
			Size = UDim2.new(1, 0, 0, height or 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			LayoutOrder = nextOrder(),
		}, scroller)
		if not height then
			f.AutomaticSize = Enum.AutomaticSize.Y
		end
		return f
	end

	return setmetatable(tab, { __index = api })
end

---------------------------------------------------------------------
-- Desync module (client box vs server box, freeze client / server)
---------------------------------------------------------------------
local Desync = {}
do
	local flags = { boxes = false, client = false, server = false }
	local boxClient, boxServer, ghost, serverPin
	local loopConn, addedConn, removingConn

	-- Both boxes use the same size
	local BOX_SIZE = Vector3.new(2.4, 2.4, 1.4)
	local GHOST_TRANSPARENCY = 0.5
	-- Roblox replicates your character about 20 times a second, so on average the server
	-- is half a send interval behind on top of the network travel time
	local SEND_HALF_INTERVAL = 0.025
	local HISTORY_SECONDS = 3

	local history = {}
	local smoothedOneWay = 0.05
	local lastStatUpdate = 0

	local function getRak()
		local rak
		pcall(function()
			rak = raknet
		end)
		if typeof(rak) == "table" then
			return rak
		end
		return nil
	end

	local function getChar()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		return char, hrp, hum
	end

	local function makeBox(name, color, size, zIndex)
		local part = Instance.new("Part")
		part.Name = name
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.CastShadow = false
		part.Transparency = 1
		part.Size = size
		local adorn = Instance.new("BoxHandleAdornment")
		adorn.Adornee = part
		adorn.Size = size
		adorn.Color3 = color
		adorn.Transparency = 0.55
		adorn.AlwaysOnTop = true
		adorn.ZIndex = zIndex or 5
		adorn.Visible = flags.boxes
		adorn.Parent = part
		part.Parent = workspace
		return part
	end

	local function destroyGhost()
		if ghost then
			ghost:Destroy()
			ghost = nil
		end
		local _, _, hum = getChar()
		local cam = workspace.CurrentCamera
		if cam and hum then
			cam.CameraSubject = hum
		end
	end

	local function createGhost()
		local char, hrp, hum = getChar()
		if not (char and hrp and hum) then
			return
		end
		if ghost then
			ghost:Destroy()
			ghost = nil
		end

		local oldArchivable = char.Archivable
		char.Archivable = true
		local clone = char:Clone()
		char.Archivable = oldArchivable
		if not clone then
			return
		end

		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BaseScript") then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				-- slightly see-through (invisible parts like the root stay invisible)
				if d.Transparency < GHOST_TRANSPARENCY then
					d.Transparency = GHOST_TRANSPARENCY
				end
			elseif d:IsA("Decal") or d:IsA("Texture") then
				if d.Transparency < GHOST_TRANSPARENCY then
					d.Transparency = GHOST_TRANSPARENCY
				end
			end
		end
		clone.Name = "ToolxGhost"
		-- No Humanoid on the clone: a Humanoid keeps forcing CanCollide back on for its limbs,
		-- which is what lets a clone bump into you. Without one it is just anchored, non-colliding parts.
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("Humanoid") then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.Massless = true
			end
		end
		clone.Parent = workspace
		ghost = clone

		-- the camera can follow a plain part, so use the clone's head
		local subject = clone:FindFirstChild("Head") or clone:FindFirstChild("HumanoidRootPart")
		local cam = workspace.CurrentCamera
		if cam and subject then
			cam.CameraSubject = subject
		end
	end

	-- One-way network latency (client -> server) in seconds
	local function sampleOneWay()
		local okPing, ping = pcall(function()
			return player:GetNetworkPing()
		end)
		if okPing and typeof(ping) == "number" and ping > 0 then
			return ping
		end
		local okStat, ms = pcall(function()
			return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
		end)
		if okStat and typeof(ms) == "number" and ms > 0 then
			return ms / 2000 -- round-trip ms -> one-way seconds
		end
		return nil
	end

	-- Where your root part was at a past moment, interpolated from recorded frames
	local function sampleHistory(target)
		local n = #history
		if n == 0 then
			return nil
		end
		if target <= history[1].t then
			return history[1].cf
		end
		for i = n, 2, -1 do
			local a, b = history[i - 1], history[i]
			if a.t <= target then
				local span = b.t - a.t
				local alpha = span > 0 and (target - a.t) / span or 1
				return a.cf:Lerp(b.cf, math.clamp(alpha, 0, 1))
			end
		end
		return history[1].cf
	end

	local function update()
		local _, hrp = getChar()
		if not hrp or not boxClient or not boxServer then
			return
		end

		-- your client simulates your character, so its real position is always your actual root part
		local clientCF = hrp.CFrame

		-- The server only knows where you were about one latency ago
		local now = os.clock()
		local oneWay = sampleOneWay()
		if oneWay then
			smoothedOneWay += (oneWay - smoothedOneWay) * 0.1
		end
		table.insert(history, { t = now, cf = hrp.CFrame })
		while #history > 2 and history[2].t < now - HISTORY_SECONDS do
			table.remove(history, 1)
		end
		local lag = smoothedOneWay + SEND_HALF_INTERVAL

		local serverCF = sampleHistory(now - lag) or hrp.CFrame
		if flags.server and serverPin then
			serverCF = serverPin
		end

		if Desync.OnStats and now - lastStatUpdate > 0.25 then
			lastStatUpdate = now
			Desync.OnStats(string.format(
				"Ping %d ms | green box trails you by %d ms",
				math.floor(smoothedOneWay * 2000 + 0.5),
				math.floor(lag * 1000 + 0.5)
			))
		end

		boxClient.CFrame = clientCF
		boxServer.CFrame = serverCF

		-- the clone sits exactly on the green box, so you see (and your camera follows)
		-- the delayed position the server has for you
		if flags.client and ghost then
			ghost:PivotTo(serverCF)
		end

		local a = boxClient:FindFirstChildOfClass("BoxHandleAdornment")
		local b = boxServer:FindFirstChildOfClass("BoxHandleAdornment")
		if a then a.Visible = flags.boxes end
		if b then b.Visible = flags.boxes end
	end

	local function onCharacterRemoving()
		if ghost then
			ghost:Destroy()
			ghost = nil
		end
		serverPin = nil
		table.clear(history)
	end

	local function onCharacterAdded(char)
		local hrp = char:WaitForChild("HumanoidRootPart", 5)
		task.wait(0.25)
		table.clear(history)
		if not hrp or not flags.client and not flags.server then
			return
		end
		if flags.client then
			createGhost()
		end
		if flags.server then
			serverPin = hrp.CFrame
		end
	end

	local function startLoop()
		if loopConn then
			return
		end
		-- blue = where the client thinks you are, green = where the server thinks you are
		boxClient = makeBox("ToolxClientBox", Color3.fromRGB(70, 130, 255), BOX_SIZE, 6)
		boxServer = makeBox("ToolxServerBox", Color3.fromRGB(60, 220, 120), BOX_SIZE, 5)
		-- run just before the camera updates so the camera follows the clone without an extra frame of delay
		RunService:BindToRenderStep("ToolxDesync", Enum.RenderPriority.Camera.Value - 1, update)
		loopConn = true
		addedConn = player.CharacterAdded:Connect(onCharacterAdded)
		removingConn = player.CharacterRemoving:Connect(onCharacterRemoving)
	end

	local function stopLoop()
		table.clear(history)
		if Desync.OnStats then
			Desync.OnStats("Ping: --")
		end
		if loopConn then
			pcall(function()
				RunService:UnbindFromRenderStep("ToolxDesync")
			end)
			loopConn = nil
		end
		if addedConn then
			addedConn:Disconnect()
			addedConn = nil
		end
		if removingConn then
			removingConn:Disconnect()
			removingConn = nil
		end
		if boxClient then
			boxClient:Destroy()
			boxClient = nil
		end
		if boxServer then
			boxServer:Destroy()
			boxServer = nil
		end
	end

	local function refresh()
		if flags.boxes or flags.client or flags.server then
			startLoop()
		else
			stopLoop()
		end
	end

	function Desync.SetBoxes(on)
		flags.boxes = on
		refresh()
	end

	function Desync.SetClientFreeze(on)
		flags.client = on
		if on then
			refresh()
			createGhost()
		else
			destroyGhost()
			refresh()
		end
	end

	function Desync.SetServerFreeze(on)
		flags.server = on
		refresh()
		if on then
			-- pin the green box where the server last saw you (your position one latency ago)
			local _, hrp = getChar()
			local lag = smoothedOneWay + SEND_HALF_INTERVAL
			serverPin = sampleHistory(os.clock() - lag) or (hrp and hrp.CFrame)
		else
			serverPin = nil
		end

		local rak = getRak()
		if rak and typeof(rak.desync) == "function" then
			pcall(rak.desync, on)
		else
			warn("[Toolx] RakNet not detected")
		end
	end

	function Desync.IsRaknetOn()
		local rak = getRak()
		if not rak or typeof(rak.is_enabled) ~= "function" then
			return false
		end
		local ok, value = pcall(rak.is_enabled)
		return (ok and value) and true or false
	end

	function Desync.Unload()
		local wasServer = flags.server
		flags.boxes = false
		flags.client = false
		flags.server = false
		destroyGhost()
		serverPin = nil
		stopLoop()
		if wasServer then
			local rak = getRak()
			if rak and typeof(rak.desync) == "function" then
				pcall(rak.desync, false)
			end
		end
	end

	if getRak() then
		print("[Toolx] RakNet detected")
	else
		print("[Toolx] RakNet not detected")
	end
end

---------------------------------------------------------------------
-- Player mods (walkspeed, jump power, anti-fling)
---------------------------------------------------------------------
local Mods = {}
do
	local state = { walk = false, jump = false, fling = false }
	local values = { walk = 16, jump = 50 }
	local saved = {}
	local steppedConn, heartConn
	local lastSafeCF
	local pauseCount = 0 -- >0 while our own fling is running (anti-fling must not fight it)

	local partCache, cacheTime = {}, 0

	local function getHumanoid()
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		return hum, root
	end

	local function refreshCache()
		table.clear(partCache)
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player and other.Character then
				for _, d in ipairs(other.Character:GetDescendants()) do
					if d:IsA("BasePart") then
						table.insert(partCache, d)
					end
				end
			end
		end
	end

	-- Anti-fling part 1: other players' parts never collide with you
	local function onStepped()
		if not state.fling or pauseCount > 0 then
			return
		end
		local now = os.clock()
		if now - cacheTime > 1 then
			cacheTime = now
			refreshCache()
		end
		for i = #partCache, 1, -1 do
			local part = partCache[i]
			if part.Parent then
				if part.CanCollide then
					part.CanCollide = false
				end
			else
				table.remove(partCache, i)
			end
		end
	end

	local function onHeartbeat()
		local hum, root = getHumanoid()
		if not hum or not root then
			return
		end

		if state.walk then
			hum.WalkSpeed = values.walk
		end
		if state.jump then
			hum.UseJumpPower = true
			hum.JumpPower = values.jump
		end

		-- Anti-fling part 2: cancel crazy velocities and snap back to the last safe spot
		if state.fling and pauseCount == 0 then
			local lv = root.AssemblyLinearVelocity
			local av = root.AssemblyAngularVelocity
			local horizontal = Vector3.new(lv.X, 0, lv.Z).Magnitude
			local limit = math.max(120, hum.WalkSpeed * 3)
			if av.Magnitude > 60 or horizontal > limit or lv.Y > 200 then
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
				if lastSafeCF then
					root.CFrame = lastSafeCF
				end
			else
				lastSafeCF = root.CFrame
			end
		end
	end

	local function refresh()
		if state.walk or state.jump or state.fling then
			if not heartConn then
				heartConn = RunService.Heartbeat:Connect(onHeartbeat)
				steppedConn = RunService.Stepped:Connect(onStepped)
			end
		else
			if heartConn then
				heartConn:Disconnect()
				heartConn = nil
			end
			if steppedConn then
				steppedConn:Disconnect()
				steppedConn = nil
			end
		end
	end

	function Mods.SetWalk(on)
		state.walk = on
		local hum = getHumanoid()
		if on then
			if hum and saved.walk == nil then
				saved.walk = hum.WalkSpeed
			end
		else
			if hum and saved.walk then
				hum.WalkSpeed = saved.walk
			end
			saved.walk = nil
		end
		refresh()
	end

	function Mods.SetWalkValue(v)
		values.walk = v
	end

	function Mods.SetJump(on)
		state.jump = on
		local hum = getHumanoid()
		if on then
			if hum and saved.jump == nil then
				saved.jump = { power = hum.JumpPower, usePower = hum.UseJumpPower }
			end
		else
			if hum and saved.jump then
				hum.JumpPower = saved.jump.power
				hum.UseJumpPower = saved.jump.usePower
			end
			saved.jump = nil
		end
		refresh()
	end

	function Mods.SetJumpValue(v)
		values.jump = v
	end

	function Mods.Pause(on)
		pauseCount = math.max(0, pauseCount + (on and 1 or -1))
		if pauseCount == 0 then
			lastSafeCF = nil
		end
	end

	function Mods.SetAntiFling(on)
		state.fling = on
		lastSafeCF = nil
		table.clear(partCache)
		cacheTime = 0
		refresh()
	end

	function Mods.Unload()
		Mods.SetWalk(false)
		Mods.SetJump(false)
		Mods.SetAntiFling(false)
	end
end

---------------------------------------------------------------------
-- Teleport (to a player, or to a spawn point)
---------------------------------------------------------------------
local Teleport = {}
do
	local spawnIndex = 0

	local function getRoot(char)
		return char and char:FindFirstChild("HumanoidRootPart")
	end

	-- keepVelocity = true: skip zeroing velocity (used when returning to origin after a fling
	-- so our own momentum doesn't get cancelled before the server registers the collision)
	local function moveTo(cf, keepVelocity)
		local char = player.Character
		local root = getRoot(char)
		if not root then
			return false
		end
		pcall(function()
			char:PivotTo(cf)
		end)
		if not keepVelocity then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
		return true
	end

	-- Teleports you just behind the other player
	function Teleport.ToPlayer(target)
		if not target or not target.Parent then
			notify("That player left", "warn")
			return
		end
		local root = getRoot(target.Character)
		if not root then
			notify(target.DisplayName .. " isn't loaded yet", "warn")
			return
		end
		if moveTo(root.CFrame * CFrame.new(0, 0, 3)) then
			notify("Teleported to " .. target.DisplayName, "success")
		else
			notify("Your character isn't loaded", "error")
		end
	end

	-- Your own respawn location first, then every enabled spawn you could spawn at
	local function spawnList()
		local list = {}
		local mine = player.RespawnLocation
		if mine and mine.Parent then
			table.insert(list, mine)
		end
		local fallback = {}
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("SpawnLocation") and d.Enabled and d ~= mine then
				table.insert(fallback, d)
				if d.Neutral or (not player.Neutral and d.TeamColor == player.TeamColor) then
					table.insert(list, d)
				end
			end
		end
		-- no spawn fits your team: offer any enabled spawn instead
		if #list == 0 then
			list = fallback
		end
		return list
	end

	-- With several spawns, each tap moves you to the next one
	function Teleport.ToSpawn()
		local list = spawnList()
		if #list == 0 then
			notify("No spawn point found in this game", "warn")
			return
		end
		spawnIndex = spawnIndex % #list + 1
		local s = list[spawnIndex]
		if moveTo(s.CFrame + Vector3.new(0, s.Size.Y / 2 + 3, 0)) then
			notify(#list > 1 and string.format("Teleported to spawn %d/%d", spawnIndex, #list) or "Teleported to spawn", "success")
		else
			notify("Your character isn't loaded", "error")
		end
	end

	---------------------------------------------------------------------
	-- Fling helpers  (IY-style: BodyAngularVelocity spin + noclip)
	---------------------------------------------------------------------

	-- How long we spin into the target before giving up.
	local FLING_DURATION = 3.0

	-- Positions (relative to the target's root) we cycle through while spinning.
	local FLING_OFFSETS = {
		Vector3.new(0, 1.5, 0),
		Vector3.new(0, -1.5, 0),
		Vector3.new(2.25, 1.5, -2.25),
		Vector3.new(-2.25, -1.5, 2.25),
	}

	-- Infinite Yield style fling, fixed so that the TARGET gets launched and not us.
	--
	-- What was wrong before:
	--   * Our parts were set to Massless, which cancels the huge density and made us light, so
	--     the contact threw us instead of them.
	--   * Humanoids re-enable CanCollide every physics step, so noclip has to be re-applied
	--     each Stepped, not just once.
	--   * Anti-fling (if on) saw our spin as an attack and snapped us around mid-fling.
	--   * On the way back we kept all of our spin/velocity and then turned collisions on
	--     again, which launched us into the map.
	--
	-- Now: huge density (NOT massless) + per-step noclip + spin on the target, then on exit we
	-- go back to `origin` and keep every part's velocity at zero (still noclipped) until
	-- everything has settled, and only then restore collisions and physical properties.
	--
	-- Returns true if the target appeared to gain significant height.
	local function doFling(target, origin)
		local myChar = player.Character
		local myRoot = getRoot(myChar)
		if not myRoot then
			return false
		end
		local targetRoot = getRoot(target.Character)
		if not targetRoot then
			return false
		end

		local baseY     = targetRoot.Position.Y
		local startTime = os.clock()
		local flung     = false
		origin = origin or myRoot.CFrame

		Mods.Pause(true)

		-- remember how everything was so we can put it back exactly
		local parts, originals = {}, {}
		for _, part in ipairs(myChar:GetDescendants()) do
			if part:IsA("BasePart") then
				table.insert(parts, part)
				originals[part] = {
					props    = part.CustomPhysicalProperties,
					collide  = part.CanCollide,
					massless = part.Massless,
				}
				pcall(function()
					-- very heavy so the spin pushes the target, not us (do NOT make it massless)
					part.CustomPhysicalProperties = PhysicalProperties.new(math.huge, 0.3, 0.5)
				end)
			end
		end

		local function zeroVelocity()
			for _, part in ipairs(parts) do
				pcall(function()
					part.AssemblyLinearVelocity  = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end)
			end
		end

		-- noclip on every physics step (the humanoid keeps turning collisions back on)
		local noclipConn = RunService.Stepped:Connect(function()
			for _, part in ipairs(parts) do
				if part.CanCollide then
					part.CanCollide = false
				end
			end
		end)

		-- don't ragdoll / fall over from the spin
		local myHum = myChar:FindFirstChildOfClass("Humanoid")
		if myHum then
			pcall(function()
				myHum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
				myHum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,      false)
			end)
		end

		-- the spinning force
		local bav = Instance.new("BodyAngularVelocity")
		bav.Name            = "ToolxFlingBAV"
		bav.AngularVelocity = Vector3.new(0, 99999, 0)
		bav.MaxTorque       = Vector3.new(0, math.huge, 0)
		bav.P               = math.huge
		bav.Parent          = myRoot

		-- ── spin loop ────────────────────────────────────────────────
		local frame = 0
		local conn
		conn = RunService.Heartbeat:Connect(function()
			local elapsed = os.clock() - startTime

			if elapsed >= FLING_DURATION or not target.Parent or not target.Character
				or player.Character ~= myChar then
				conn:Disconnect()
				return
			end

			local tr = getRoot(target.Character)
			if not tr or not myRoot.Parent then
				conn:Disconnect()
				return
			end

			frame += 1
			local offset = FLING_OFFSETS[frame % #FLING_OFFSETS + 1]

			-- sit on the target (slightly ahead of where they're moving) so the spin hits them,
			-- and never let our own linear velocity build up
			pcall(function()
				myChar:PivotTo(CFrame.new(tr.Position + tr.AssemblyLinearVelocity * 0.1 + offset))
				myRoot.AssemblyLinearVelocity = Vector3.zero
			end)

			-- alternate the spin each 0.2 s so the server doesn't settle the two bodies together
			local phase = math.floor(elapsed / 0.2) % 2
			if bav.Parent then
				bav.AngularVelocity = Vector3.new(0, phase == 0 and 99999 or 0, 0)
			end

			-- Early exit once the target is clearly airborne
			if (tr.Position.Y - baseY) >= 15 then
				flung = true
				conn:Disconnect()
			end
		end)

		-- Block until the loop finishes
		local deadline = os.clock() + FLING_DURATION + 0.5
		repeat task.wait(0.05)
		until not conn.Connected or os.clock() >= deadline
		if conn.Connected then conn:Disconnect() end

		-- ── teardown: get away from the target and stop dead ─────────
		bav:Destroy()

		-- Hold still at the origin (still noclipped, still heavy) while all leftover spin /
		-- momentum is killed every frame. Only then do collisions come back.
		local settleUntil = os.clock() + 0.6
		repeat
			pcall(function()
				myChar:PivotTo(origin)
			end)
			zeroVelocity()
			RunService.Heartbeat:Wait()
		until os.clock() >= settleUntil

		noclipConn:Disconnect()

		for _, part in ipairs(parts) do
			local o = originals[part]
			pcall(function()
				part.CustomPhysicalProperties = o.props
				part.Massless                 = o.massless
				part.CanCollide               = o.collide
			end)
		end
		for _ = 1, 3 do
			zeroVelocity()
			RunService.Heartbeat:Wait()
		end

		if myHum then
			pcall(function()
				myHum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
				myHum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,      true)
			end)
		end

		Mods.Pause(false)

		-- Final height check as fallback
		local tr = getRoot(target.Character)
		if not flung and tr then
			flung = (tr.Position.Y - baseY) > 8
		end

		return flung
	end

	-- Fling a single named player; return to origin afterward.
	function Teleport.FlingPlayer(target)
		if not target or not target.Parent then
			notify("That player left", "warn")
			return
		end
		if not getRoot(target.Character) then
			notify(target.DisplayName .. " isn't loaded yet", "warn")
			return
		end
		local myChar = player.Character
		local myRoot = getRoot(myChar)
		if not myRoot then
			notify("Your character isn't loaded", "error")
			return
		end

		local origin = myRoot.CFrame
		notify("Flinging " .. target.DisplayName .. "...", "info")

		-- doFling takes us back to `origin` and kills our velocity before returning
		local success = doFling(target, origin)

		if success then
			notify("Flung " .. target.DisplayName .. "!", "success")
		else
			notify(target.DisplayName .. " resisted (try again)", "warn")
		end
	end

	-- Copy every tool the target is holding or carrying into your own backpack.
	-- Note: Roblox only replicates a player's Backpack to that player, so on most games you can
	-- only see (and copy) the tool they currently have equipped.
	function Teleport.TakeTools(target)
		if not target or not target.Parent then
			notify("That player left", "warn")
			return
		end
		local myBackpack = player:FindFirstChildOfClass("Backpack")
		if not myBackpack then
			notify("Your backpack isn't loaded", "error")
			return
		end
		local sources = {}
		local theirBackpack = target:FindFirstChildOfClass("Backpack")
		if theirBackpack then
			table.insert(sources, theirBackpack)
		end
		if target.Character then
			table.insert(sources, target.Character)
		end
		local copied, seen = 0, {}
		for _, source in ipairs(sources) do
			for _, item in ipairs(source:GetChildren()) do
				if item:IsA("Tool") or item:IsA("HopperBin") then
					local ok = pcall(function()
						local copy = item:Clone()
						copy.Parent = myBackpack
					end)
					if ok then
						copied += 1
					end
				end
			end
		end
		if copied > 0 then
			notify(string.format("Took %d tool%s from %s", copied, copied == 1 and "" or "s", target.DisplayName), "success")
		else
			notify(target.DisplayName .. " has no tools you can see", "warn")
		end
	end

	-- Fling every other player in the server one by one, returning to origin between each.
	function Teleport.FlingAll(lbl)
		local myChar = player.Character
		local myRoot = getRoot(myChar)
		if not myRoot then
			notify("Your character isn't loaded", "error")
			return
		end

		local origin = myRoot.CFrame
		local others = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				table.insert(others, p)
			end
		end

		if #others == 0 then
			notify("No other players to fling", "warn")
			return
		end

		local original = lbl and lbl.Text or nil
		local done, failed = 0, 0

		for i, target in ipairs(others) do
			if lbl and lbl.Parent then
				lbl.Text = string.format("Flinging %d/%d...", i, #others)
			end

			if not target or not target.Parent then
				failed += 1
			elseif not getRoot(target.Character) then
				notify(target.DisplayName .. " isn't loaded, skipping", "warn")
				failed += 1
			else
				-- doFling returns us to origin with zero velocity before it finishes
				local success = doFling(target, origin)
				task.wait(0.1)

				if success then
					done += 1
				else
					failed += 1
				end
			end
		end

		moveTo(origin)

		if lbl and lbl.Parent then
			lbl.Text = original or "Fling all"
		end

		if failed == 0 then
			notify(string.format("Flung all %d players!", done), "success")
		else
			notify(string.format("Flung %d / %d players (%d may have resisted)", done, #others, failed), done > 0 and "warn" or "error")
		end
	end
end

---------------------------------------------------------------------
-- Topbar switcher: working 2018 / 2021 copies of Roblox's topbar, or the real one ("Current")
-- 2018    = pre-March-2020 topbar: 36px translucent bar, hamburger, chat, username + account type,
--           leaderstats, health bar.
-- 2021    = March 2020 - 2023 topbar: round 32px buttons, Roblox logo, chat, "..." menu
--           (Leaderboard / Emotes / Inventory), health bar.
-- Current = Roblox's real topbar. It is hidden by disabling CoreGui.TopBarApp while a copy is shown.
-- No emoji and no asset ids are used, every icon is drawn out of Frames.
---------------------------------------------------------------------
local Topbar = {}
do
	local GuiService = game:GetService("GuiService")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local CoreGui = game:GetService("CoreGui")
	local TextChatService = game:GetService("TextChatService")
	local VIM
	pcall(function()
		VIM = game:GetService("VirtualInputManager")
	end)
	local LocalPlayer = player

	local alive = true
	local current = "Current"
	local style = nil
	local styleToken = 0
	local cleanups = {}

	local WHITE = Color3.new(1, 1, 1)
	local BLACK = Color3.new(0, 0, 0)
	local DARK = Color3.fromRGB(35, 37, 39)
	local GRAY = Color3.fromRGB(165, 165, 165)
	local RED = Color3.fromRGB(255, 28, 0)
	local YELLOW = Color3.fromRGB(250, 235, 0)
	local GREEN = Color3.fromRGB(27, 252, 107)

	local function onClean(fn)
		cleanups[#cleanups + 1] = fn
	end
	local function runCleanups()
		for _, fn in ipairs(cleanups) do
			pcall(fn)
		end
		table.clear(cleanups)
	end
	local function sconnect(signal, fn)
		local c = signal:Connect(fn)
		onClean(function()
			c:Disconnect()
		end)
		return c
	end

	-- properties in one table, Parent is applied last
	local function mk(class, props)
		local o = Instance.new(class)
		local parent = props.Parent
		for k, v in pairs(props) do
			if k ~= "Parent" then
				o[k] = v
			end
		end
		if parent then
			o.Parent = parent
		end
		return o
	end

	------------------------------------------------------------------
	-- the gui the copies live in. It ignores every inset (topbar area
	-- and the device safe zones such as notches), so the bar reaches
	-- the real edges of the screen instead of leaving blank sides.
	------------------------------------------------------------------
	local gui
	local function ensureGui()
		if gui and gui.Parent then
			return gui
		end
		gui = mk("ScreenGui", {
			Name = "ToolxTopbar",
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			DisplayOrder = 100,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		})
		pcall(function()
			gui.ScreenInsets = Enum.ScreenInsets.None
		end)

		local candidates = {
			function()
				return typeof(gethui) == "function" and gethui() or nil
			end,
			function()
				return CoreGui
			end,
			function()
				return player:WaitForChild("PlayerGui")
			end,
		}
		for _, get in ipairs(candidates) do
			local ok, parent = pcall(get)
			if ok and parent then
				pcall(function()
					local old = parent:FindFirstChild("ToolxTopbar")
					if old then
						old:Destroy()
					end
				end)
				local assigned = pcall(function()
					gui.Parent = parent
				end)
				if assigned and gui.Parent == parent then
					break
				end
			end
		end
		return gui
	end

	-- The copies are drawn at their original size and scaled up as a whole. The root is
	-- 1/scale of the screen and UIScale brings it back to full screen, so right-anchored
	-- buttons still sit on the right edge.
	local uiScale = 1.15
	local function scaledRoot(name)
		local root = mk("Frame", {
			Name = name,
			Size = UDim2.fromScale(1 / uiScale, 1 / uiScale),
			BackgroundTransparency = 1,
			ZIndex = 1,
			Parent = ensureGui(),
		})
		local ui = mk("UIScale", { Scale = uiScale, Parent = root })
		return root, ui
	end

	------------------------------------------------------------------
	-- icon drawing (frames only)
	------------------------------------------------------------------
	local function box(parent, x, y, w, h, radius, color)
		local f = mk("Frame", {
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(w, h),
			BackgroundColor3 = color or WHITE,
			BorderSizePixel = 0,
			Parent = parent,
		})
		if radius and radius > 0 then
			corner(f, radius)
		end
		return f
	end

	-- outlined box; the stroke is drawn outside the frame, so inset by the thickness
	local function outline(parent, x, y, w, h, radius, color, t)
		local f = mk("Frame", {
			Position = UDim2.fromOffset(x + t, y + t),
			Size = UDim2.fromOffset(w - 2 * t, h - 2 * t),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = parent,
		})
		if radius > 0 then
			corner(f, math.max(radius - t, 0))
		end
		mk("UIStroke", {
			Thickness = t,
			Color = color,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = f,
		})
		return f
	end

	local function shape(parent, x, y, w, h, radius, filled)
		if filled then
			return box(parent, x, y, w, h, radius, WHITE)
		end
		return outline(parent, x, y, w, h, radius, WHITE, 2)
	end

	local function clear(f)
		for _, c in ipairs(f:GetChildren()) do
			if not c:IsA("UIScale") then
				c:Destroy()
			end
		end
	end

	local function holder(parent, w, h, scale)
		local f = mk("Frame", {
			Size = UDim2.fromOffset(w, h),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			BackgroundTransparency = 1,
			Parent = parent,
		})
		if scale then
			mk("UIScale", { Scale = scale, Parent = f })
		end
		return f
	end

	-- 32x25: three bars (the 2018 hamburger)
	local function drawHamburger(f, color)
		clear(f)
		for i = 0, 2 do
			box(f, 0, 1 + i * 10, 32, 3, 1, color)
		end
	end

	-- 28x27: speech bubble
	local function drawChat(f, on)
		clear(f)
		local c = on and WHITE or GRAY
		box(f, 0, 1, 28, 20, 6, c)
		local tail = box(f, 6, 15, 9, 9, 1, c)
		tail.Rotation = 45
		for i = 0, 2 do
			box(f, 5 + i * 7, 9, 4, 4, 2, DARK)
		end
	end

