---------------------------------------------------------------------
-- ESP + health meter
---------------------------------------------------------------------
local ESP = {}
do
	local settings = {
		esp = false,
		names = true,
		useDisplay = true,
		outline = true, -- true = full outline, false = hitbox
		teamName = false,
		health = false,
	}
	local entries = {} -- Player -> entry
	local container
	local heartbeat
	local accum = 0

	local function getContainer()
		if container and container.Parent then
			return container
		end
		container = new("Folder", { Name = "ToolxESP" })
		local parent = gui.Parent or game:GetService("CoreGui")
		local ok = pcall(function()
			container.Parent = parent
		end)
		if not ok or container.Parent ~= parent then
			container.Parent = gui
		end
		return container
	end

	-- always the colour of the team the player is assigned to (white if they have no team)
	local function teamColor(p)
		local t = p.Team
		if t then
			return t.TeamColor.Color
		end
		return Color3.new(1, 1, 1)
	end

	local function makeEntry(p)
		local folder = new("Folder", { Name = p.Name }, getContainer())
		local e = { player = p, folder = folder }

		e.highlight = new("Highlight", {
			Name = "Outline",
			FillTransparency = 1,
			OutlineTransparency = 0,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			Enabled = false,
		}, folder)

		e.box = new("SelectionBox", {
			Name = "Hitbox",
			LineThickness = 0.04,
			Transparency = 0,
			SurfaceTransparency = 0.85,
		}, folder)

		e.infoGui = new("BillboardGui", {
			Name = "Info",
			AlwaysOnTop = true,
			LightInfluence = 0,
			ResetOnSpawn = false,
			Size = UDim2.fromOffset(200, 36),
			StudsOffset = Vector3.new(0, 2.8, 0),
			Enabled = false,
		}, folder)
		e.nameLabel = new("TextLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0.5, 0),
			Font = Enum.Font.GothamBold,
			TextSize = 14,
			TextYAlignment = Enum.TextYAlignment.Bottom,
			TextStrokeTransparency = 0.3,
			Text = "",
		}, e.infoGui)
		e.teamLabel = new("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(1, 0, 0.5, 0),
			Font = Enum.Font.GothamMedium,
			TextSize = 12,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextStrokeTransparency = 0.3,
			Text = "",
		}, e.infoGui)

		e.hpGui = new("BillboardGui", {
			Name = "Health",
			AlwaysOnTop = true,
			LightInfluence = 0,
			ResetOnSpawn = false,
			Size = UDim2.fromOffset(64, 18),
			StudsOffset = Vector3.new(0, -3.6, 0),
			Enabled = false,
		}, folder)
		local back = new("Frame", {
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 6),
		}, e.hpGui)
		corner(back, 3)
		e.hpFill = new("Frame", {
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
		}, back)
		corner(e.hpFill, 3)
		e.hpText = new("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, 7),
			Size = UDim2.new(1, 0, 0, 11),
			Font = Enum.Font.GothamBold,
			TextSize = 10,
			TextColor3 = Color3.new(1, 1, 1),
			TextStrokeTransparency = 0.4,
			Text = "",
		}, e.hpGui)

		return e
	end

	local function hideEsp(e)
		e.highlight.Enabled = false
		e.highlight.Adornee = nil
		e.box.Adornee = nil
		e.infoGui.Enabled = false
	end

	local function hideHealth(e)
		e.hpGui.Enabled = false
	end

	local function updateEntry(e)
		local p = e.player
		local char = p.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
		local alive = hum ~= nil and root ~= nil and hum.Health > 0
		local color = teamColor(p)

		-- ESP (outline / hitbox, names, team name)
		if settings.esp and alive then
			if settings.outline then
				e.box.Adornee = nil
				e.highlight.Adornee = char
				e.highlight.OutlineColor = color
				e.highlight.FillColor = color
				e.highlight.Enabled = true
			else
				e.highlight.Enabled = false
				e.highlight.Adornee = nil
				e.box.Adornee = char
				e.box.Color3 = color
				e.box.SurfaceColor3 = color
			end

			local showName = settings.names
			local showTeam = settings.teamName and p.Team ~= nil
			if showName or showTeam then
				e.infoGui.Adornee = char:FindFirstChild("Head") or root
				e.infoGui.Enabled = true
				e.nameLabel.Visible = showName
				e.nameLabel.Text = settings.useDisplay and p.DisplayName or p.Name
				e.nameLabel.TextColor3 = color
				e.teamLabel.Visible = showTeam
				e.teamLabel.Text = showTeam and p.Team.Name or ""
				e.teamLabel.TextColor3 = color
			else
				e.infoGui.Enabled = false
			end
		else
			hideEsp(e)
		end

		-- health meter (works without ESP)
		if settings.health and alive and hum.MaxHealth > 0 then
			local frac = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
			e.hpGui.Adornee = root
			e.hpGui.Enabled = true
			e.hpFill.Size = UDim2.fromScale(frac, 1)
			e.hpFill.BackgroundColor3 = Color3.fromHSV(frac * 0.33, 0.85, 0.95)
			e.hpText.Text = math.ceil(hum.Health) .. "/" .. math.ceil(hum.MaxHealth)
		else
			hideHealth(e)
		end
	end

	local function clearAll()
		for p, e in pairs(entries) do
			pcall(function()
				e.folder:Destroy()
			end)
			entries[p] = nil
		end
	end

	local function step()
		local present = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				present[p] = true
				local e = entries[p]
				if not e then
					e = makeEntry(p)
					entries[p] = e
				end
				pcall(updateEntry, e)
			end
		end
		for p, e in pairs(entries) do
			if not present[p] then
				pcall(function()
					e.folder:Destroy()
				end)
				entries[p] = nil
			end
		end
	end

	local function sync()
		local need = settings.esp or settings.health
		if need and not heartbeat then
			accum = 1
			heartbeat = RunService.Heartbeat:Connect(function(dt)
				accum = accum + dt
				if accum < 0.1 then
					return
				end
				accum = 0
				step()
			end)
		elseif not need and heartbeat then
			heartbeat:Disconnect()
			heartbeat = nil
			clearAll()
		end
	end

	function ESP.SetEnabled(on)
		settings.esp = on
		sync()
		if not on then
			for _, e in pairs(entries) do
				hideEsp(e)
			end
		end
	end
	function ESP.SetNames(on)
		settings.names = on
	end
	function ESP.SetNameType(name)
		settings.useDisplay = name == "Display name"
	end
	function ESP.SetStyle(name)
		settings.outline = name == "Full outline"
	end
	function ESP.SetTeamName(on)
		settings.teamName = on
	end
	function ESP.SetHealth(on)
		settings.health = on
		sync()
		if not on then
			for _, e in pairs(entries) do
				hideHealth(e)
			end
		end
	end
	function ESP.Unload()
		settings.esp = false
		settings.health = false
		if heartbeat then
			heartbeat:Disconnect()
			heartbeat = nil
		end
		clearAll()
		if container then
			pcall(function()
				container:Destroy()
			end)
			container = nil
		end
	end
end

---------------------------------------------------------------------
-- Execute tab (run your own code, with a built-in safety scanner)
---------------------------------------------------------------------
do
	local executeTab = addTab("Execute")

	local function hexOf(c)
		return "#" .. c:ToHex()
	end
	local function has(low, text)
		return string.find(low, text, 1, true) ~= nil
	end
	local function firstOf(low, list)
		for _, t in ipairs(list) do
			if has(low, t) then
				return t
			end
		end
		return nil
	end

	-----------------------------------------------------------------
	-- Scanner: looks for things that can hurt your account or device.
	-- It's a pattern check, not a guarantee. Hidden or brand new tricks can slip past it.
	-----------------------------------------------------------------
	local function normalize(source)
		local s = source
		-- "ROBLO" .. "SECURITY" -> "ROBLOSECURITY"
		s = s:gsub('"%s*%.%.%s*"', ""):gsub("'%s*%.%.%s*'", "")
		-- \x41 and \065 style escapes -> real characters
		s = s:gsub("\\x(%x%x)", function(h)
			return string.char(tonumber(h, 16))
		end)
		s = s:gsub("\\(%d%d?%d?)", function(d)
			local n = tonumber(d)
			if n and n < 256 then
				return string.char(n)
			end
		end)
		-- string.char(72,105) -> "Hi"
		s = s:gsub("string%.char%s*%(([%d%s,]+)%)", function(list)
			local out = {}
			for num in string.gmatch(list, "%d+") do
				local n = tonumber(num)
				if n and n < 256 then
					table.insert(out, string.char(n))
				end
			end
			return '"' .. table.concat(out) .. '"'
		end)
		return s
	end

	local SHORTENERS = { "bit.ly/", "tinyurl.com/", "t.co/", "cutt.ly/", "is.gd/", "rb.gy/", "shorturl.at/", "goo.gl/", "ow.ly/", "tiny.cc/", "lnkd.in/" }
	local ANON_HOSTS = {
		"pastebin.com", "hastebin", "paste.ee", "controlc.com", "ghostbin", "cdn.discordapp.com/attachments",
		"media.discordapp.net/attachments", "ngrok", "trycloudflare.com", "duckdns.org", "anonfiles", "transfer.sh",
		"mediafire.com", "mega.nz", "dropbox.com/s/",
	}
	local DANGEROUS_EXT = { ".exe", ".bat", ".cmd", ".ps1", ".vbs", ".scr", ".dll", ".lnk", ".msi", ".jar", ".apk", ".sh" }

	local function scan(source)
		local findings = {}
		local function add(sev, title, why, found)
			table.insert(findings, { sev = sev, title = title, why = why, found = found, order = #findings })
		end

		local text = normalize(source)
		local low = string.lower(text)
		local outbound = firstOf(low, { "httppost", "postasync", "requestasync", "http_request", "syn.request", "request(", "request (" })

		-- account
		local hit = firstOf(low, { "roblosecurity", "do-not-share-this" })
		if hit then
			add("high", "Reads your Roblox login cookie", "That cookie gives full access to your account. Normal scripts never need it.", hit)
		end
		hit = firstOf(low, {
			"auth.roblox.com", "accountsettings.roblox.com", "economy.roblox.com/v1/purchases", "trades.roblox.com",
			"billing.roblox.com", "twostepverification.roblox.com", "users.roblox.com/v1/users/authenticated",
			"privatemessages.roblox.com", "accountinformation.roblox.com", "premiumfeatures.roblox.com", "/v2/logout",
		})
		if hit then
			add("high", "Calls Roblox account APIs", "These are used to change account settings, spend Robux, trade items or read private info.", hit)
		end
		hit = firstOf(low, { "promptpurchase", "promptproductpurchase", "promptgamepasspurchase", "promptrobuxpurchase", "performpurchase", "promptbundlepurchase", "promptpremiumpurchase" })
		if hit then
			add("medium", "Tries to make you buy something", "Check carefully before you confirm any purchase pop-up.", hit)
		end

		-- data leaving your device
		hit = firstOf(low, { "discord.com/api/webhooks", "discordapp.com/api/webhooks", "/api/webhooks/" })
		if hit then
			add("high", "Sends data to a Discord webhook", "Stolen info is often sent to the thief this way, and you'd never see it happen.", hit)
		end
		hit = firstOf(low, { "api.telegram.org/bot" })
		if hit then
			add("high", "Sends data to a Telegram bot", "Another common way to send stolen info out.", hit)
		end
		hit = firstOf(low, { "grabify", "iplogger", "2no.co", "yip.su", "blasze", "stopify.co", "leakix" })
		if hit then
			add("high", "Contains an IP logger link", "These links record the IP address of anyone who opens them.", hit)
		end
		hit = firstOf(low, { "ipify.org", "ip-api.com", "ipinfo.io", "ifconfig.me", "icanhazip", "checkip.", "whatismyip", "myexternalip", "ipapi.co", "geoiplookup" })
		if hit then
			add("medium", "Looks up your IP address", "Sometimes harmless, but it's also how scripts learn where you are.", hit)
		end
		hit = firstOf(low, { "gethwid", "get_hwid", "hwid", "getclientid", "rbxanalyticsservice" })
		if hit then
			add(outbound and "high" or "medium", outbound and "Reads your device ID and can send data online" or "Reads a device ID",
				"A device ID identifies your computer or phone, and can be used to track or ban it.", hit)
		end
		if outbound then
			hit = firstOf(low, { "userid", "accountage", "membershiptype" })
			if hit then
				add("medium", "Can send your account info online", "It reads account details and has a way to send data out.", hit)
			end
			hit = firstOf(low, { "chatted", "onincomingmessage", "messagereceived" })
			if hit then
				add("medium", "Can send your chat messages online", "It reads chat and has a way to send data out.", hit)
			end
		end

		-- device
		hit = firstOf(low, { "os.execute", "io.popen", "cmd.exe", "powershell", "/bin/sh", "/bin/bash", "wscript.shell", "mshta", "rundll32", "certutil", "schtasks" })
		if hit then
			add("high", "Tries to run system commands", "That would let a script control your computer outside of Roblox.", hit)
		end
		if has(low, "writefile") or has(low, "appendfile") then
			for _, ext in ipairs(DANGEROUS_EXT) do
				if has(low, ext .. '"') or has(low, ext .. "'") then
					add("high", "Writes a program file to your device", "Saving files like " .. ext .. " is how malware gets onto a device.", ext)
					break
				end
			end
		end
		if has(low, "setclipboard") or has(low, "toclipboard") then
			local wallet
			for run in string.gmatch(low, "bc1[%w]+") do
				if #run >= 26 then
					wallet = run
					break
				end
			end
			wallet = wallet or string.match(low, "0x" .. string.rep("%x", 40))
			if wallet then
				add("high", "Swaps your clipboard for a wallet address", "This can redirect money you meant to send to someone else.", string.sub(wallet, 1, 14) .. "...")
			end
		end
		hit = firstOf(low, { "delfile", "delfolder" })
		if hit then
			add("medium", "Deletes files", "It can erase your saved scripts and settings in the executor folder.", hit)
		end
		if string.find(low, "while%s+true%s+do%s*end") or string.find(low, "repeat%s*until%s+false") or has(low, "game:shutdown")
			or string.find(low, "string%.rep%s*%(.-,%s*%d%d%d%d%d%d%d+") then
			add("medium", "Could freeze or close the game", "It has an endless loop with no wait, a huge allocation, or a shutdown call.")
		end

		-- remote code and links
		if has(low, "loadstring") and (has(low, "httpget") or has(low, "http.request") or has(low, "request(") or has(low, "getasync")) then
			add("medium", "Downloads and runs code from the internet", "That code isn't in this script, so it can't be scanned here, and it can change later. Only run it if you trust the link.")
		end
		local urls, seen = {}, {}
		for url in string.gmatch(text, "https?://[%w%-%._~:/%?#@!$&%(%)%*%+,;=%%]+") do
			if not seen[url] then
				seen[url] = true
				table.insert(urls, url)
			end
		end
		for _, url in ipairs(urls) do
			local u = string.lower(url)
			local why = firstOf(u, SHORTENERS) and "a link shortener (hides where it really goes)"
				or string.match(u, "^https?://%d+%.%d+%.%d+%.%d+") and "a raw IP address instead of a website name"
				or firstOf(u, ANON_HOSTS) and "a site where anyone can host anything"
			if why then
				add("medium", "Suspicious link", "It points to " .. why .. ".", string.sub(url, 1, 60))
				break
			end
		end
		if #urls > 0 then
			local shown = {}
			for i = 1, math.min(#urls, 4) do
				table.insert(shown, string.sub(urls[i], 1, 60))
			end
			add("low", "Contains links", "Check that you recognise these.", table.concat(shown, "\n"))
		end

		-- hard to read
		local escapes = select(2, string.gsub(source, "\\%d%d%d", "")) + select(2, string.gsub(source, "\\x%x%x", ""))
		local hidden = firstOf(string.lower(source), { "luraph", "moonsec", "ironbrew", "obfuscat" })
		local blob = false
		for run in string.gmatch(source, "[%w%+/=]+") do
			if #run >= 300 then
				blob = true
				break
			end
		end
		local longLine = false
		for line in string.gmatch(source, "[^\n]+") do
			if #line > 3000 then
				longLine = true
				break
			end
		end
		if hidden or escapes >= 40 or blob or longLine then
			add("medium", "Hard to read on purpose", "Hidden or scrambled code can't be checked reliably, so something dangerous could be inside.")
		end

		-- low-level hooks (info only)
		hit = firstOf(low, { "hookmetamethod", "hookfunction", "getrawmetatable", "setreadonly" })
		if hit then
			add("low", "Uses low-level hooks", "Common in cheats and tools. They can watch or change what the game does.", hit)
		end
		if has(low, "teleportservice") and (has(low, "teleportasync") or has(low, ":teleport(")) then
			add("low", "Can teleport you to another place", "Make sure you're okay with being moved.")
		end

		local rank = { high = 1, medium = 2, low = 3 }
		table.sort(findings, function(a, b)
			if rank[a.sev] ~= rank[b.sev] then
				return rank[a.sev] < rank[b.sev]
			end
			return a.order < b.order
		end)
		return findings
	end

	local function describe(source)
		local findings = scan(source)
		local high, med = 0, 0
		for _, f in ipairs(findings) do
			if f.sev == "high" then
				high += 1
			elseif f.sev == "medium" then
				med += 1
			end
		end
		local verdict, color, kind
		if high > 0 then
			verdict, color, kind = "Dangerous. Don't run this.", theme.red, "error"
		elseif med >= 2 then
			verdict, color, kind = "Suspicious. Be careful.", theme.amber, "warn"
		elseif med == 1 then
			verdict, color, kind = "Use caution.", theme.amber, "warn"
		else
			verdict, color, kind = "No known threats found.", toastColors.success, "success"
		end
		local sevColor = { high = hexOf(theme.red), medium = hexOf(theme.amber), low = hexOf(theme.dim) }
		local dim = hexOf(theme.dim)
		local lines = { '<font color="' .. hexOf(color) .. '"><b>' .. verdict .. "</b></font>" }
		for i, f in ipairs(findings) do
			if i > 8 then
				table.insert(lines, '<font color="' .. dim .. '">...and ' .. (#findings - 8) .. " more.</font>")
				break
			end
			local entry = '<font color="' .. sevColor[f.sev] .. '"><b>' .. string.upper(f.sev) .. "</b></font>  <b>" .. escapeRich(f.title) .. "</b>"
				.. '\n<font color="' .. dim .. '">' .. escapeRich(f.why)
			if f.found then
				entry ..= "\nfound: " .. escapeRich(f.found)
			end
			table.insert(lines, entry .. "</font>")
		end
		table.insert(lines, '<font color="' .. dim .. '">Scanned ' .. #source .. " characters. A scan can't catch everything, so only run scripts you trust.</font>")
		return table.concat(lines, "\n\n"), high, verdict, kind
	end

	-----------------------------------------------------------------
	-- Editor
	-----------------------------------------------------------------
	executeTab:Section("Script")
	local editorBox = executeTab:Container(150)
	local editor = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = theme.bg,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = theme.accent,
		ScrollBarImageTransparency = 0.1,
		VerticalScrollBarInset = Enum.ScrollBarInset.Always,
		VerticalScrollBarPosition = Enum.VerticalScrollBarPosition.Right,
		ElasticBehavior = Enum.ElasticBehavior.Never,
		Active = true,
		-- the canvas height is managed by hand (see the editor helpers below) so the scrollbar always matches the text
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.None,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}, editorBox)
	corner(editor, 8)
	stroke(editor, 0.9)
	local codeBox = new("TextBox", {
		Text = "",
		PlaceholderText = "-- Type or paste your script here",
		PlaceholderColor3 = theme.dim,
		ClearTextOnFocus = false,
		MultiLine = true,
		TextWrapped = true,
		Font = Enum.Font.Code,
		TextSize = 12,
		TextColor3 = theme.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 150),
	}, editor)
	new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }, codeBox)

	-- Luau syntax highlighting + scrolling for the editor (wrapped in a function so it adds no locals to the script's top level)
	;(function()
		local TextService = game:GetService("TextService")
		local EDITOR_FONT, EDITOR_SIZE = Enum.Font.Code, 12
		local PAD_X, PAD_Y = 8, 6

		-----------------------------------------------------------------
		-- Syntax highlighting: the TextBox's own text is made invisible and a RichText label
		-- with identical font / size / wrapping is drawn exactly on top of it, so the cursor,
		-- selection and keyboard all still belong to the real TextBox.
		-----------------------------------------------------------------
		local function makeHighlighter()
			local function set(list)
				local s = {}
				for w in string.gmatch(list, "%S+") do
					s[w] = true
				end
				return s
			end

			local KEYWORDS = set("and break continue do else elseif end export for function goto if in local not or repeat return then until while self")
			local CONSTANTS = set("nil true false")
			local BUILTINS = set([[
				print warn error assert pcall xpcall select type typeof tostring tonumber pairs ipairs next rawget rawset rawequal rawlen
				setmetatable getmetatable require loadstring newproxy unpack tick time wait spawn delay game workspace script shared plugin
				_G _VERSION math string table task os coroutine utf8 bit32 buffer debug Instance Vector2 Vector3 Vector2int16 Vector3int16
				CFrame Color3 BrickColor UDim UDim2 Enum Ray Rect Region3 TweenInfo NumberRange NumberSequence ColorSequence
				Random Font DateTime Axes Faces OverlapParams RaycastParams PhysicalProperties
				getgenv getrenv getfenv setfenv getreg getgc getinstances getnilinstances getscripts getloadedmodules getconnections
				hookfunction hookmetamethod getrawmetatable setrawmetatable setreadonly isreadonly checkcaller newcclosure islclosure iscclosure
				clonefunction cloneref compareinstances firesignal fireclickdetector fireproximityprompt firetouchinterest
				request http_request identifyexecutor gethui setclipboard getclipboard writefile readfile isfile isfolder makefolder
				delfile delfolder listfiles appendfile loadfile dofile getcustomasset queue_on_teleport setfpscap getnamecallmethod
				setnamecallmethod getcallingscript decompile getsenv getrenv Drawing WebSocket
			]])

			local C_KEYWORD = "#F86D7C"
			local C_CONST = "#FFC600"
			local C_NUMBER = "#FFC600"
			local C_STRING = "#ADF195"
			local C_COMMENT = "#6C7086"
			local C_BUILTIN = "#84D6F7"
			local C_FUNC = "#FDFBAC"

			local ESC = { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;", ["'"] = "&apos;" }
			local function esc(s)
				return (string.gsub(s, "[&<>\"']", ESC))
			end

			return function(src)
				local out, n = {}, 0
				local function emit(text, color)
					n = n + 1
					if color then
						out[n] = '<font color="' .. color .. '">' .. esc(text) .. "</font>"
					else
						out[n] = esc(text)
					end
				end

				local len = #src
				local i = 1
				while i <= len do
					local b = string.byte(src, i)
					local nextI

					if b == 45 and string.byte(src, i + 1) == 45 then
						-- comment: --[[ ]] / --[=[ ]=] or to end of line
						local eq = string.match(src, "^%-%-%[(=*)%[", i)
						if eq then
							local _, close = string.find(src, "]" .. eq .. "]", i + 4 + #eq, true)
							nextI = (close or len) + 1
						else
							local nl = string.find(src, "\n", i, true)
							nextI = nl or (len + 1)
						end
						emit(string.sub(src, i, nextI - 1), C_COMMENT)
					elseif b == 34 or b == 39 then
						-- "string" / 'string' (ends at the closing quote or at the end of the line)
						local j = i + 1
						while j <= len do
							local c = string.byte(src, j)
							if c == 92 then
								j = j + 2
							elseif c == b then
								break
							elseif c == 10 then
								j = j - 1
								break
							else
								j = j + 1
							end
						end
						if j > len then
							j = len
						end
						nextI = j + 1
						emit(string.sub(src, i, j), C_STRING)
					elseif b == 96 then
						-- `interpolated string` (may span lines)
						local j = i + 1
						while j <= len do
							local c = string.byte(src, j)
							if c == 92 then
								j = j + 2
							elseif c == 96 then
								break
							else
								j = j + 1
							end
						end
						if j > len then
							j = len
						end
						nextI = j + 1
						emit(string.sub(src, i, j), C_STRING)
					elseif b == 91 and string.match(src, "^%[=*%[", i) then
						-- [[ long string ]]
						local eq = string.match(src, "^%[(=*)%[", i)
						local _, close = string.find(src, "]" .. eq .. "]", i + 2 + #eq, true)
						nextI = (close or len) + 1
						emit(string.sub(src, i, nextI - 1), C_STRING)
					elseif (b >= 48 and b <= 57) or (b == 46 and (string.byte(src, i + 1) or 0) >= 48 and (string.byte(src, i + 1) or 0) <= 57 and string.byte(src, i - 1) ~= 46) then
						-- number
						local s = string.match(src, "^0[xX][%x_]+", i) or string.match(src, "^0[bB][01_]+", i)
						if not s then
							s = string.match(src, "^[%d_]*%.?[%d_]*", i)
							local e = string.match(src, "^[eE][+-]?%d+", i + #s)
							if e then
