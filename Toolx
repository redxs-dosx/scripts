-- Spooky Mode: recolors the whole gui between the Halloween orange and the normal blue
local Rainbow = { on = false, unlocked = false, wanted = false } -- filled in below
local Spooky = { on = true }
local function sameColor(a, b)
	return math.abs(a.R - b.R) < 0.004 and math.abs(a.G - b.G) < 0.004 and math.abs(a.B - b.B) < 0.004
end

function Spooky.apply(on)
	Spooky.on = on
	local from, to = theme.accent, on and theme.accentSpooky or theme.accentDefault
	if Rainbow.on then
		to = from -- Rainbow owns the accent colour, Spooky Mode only switches the logo and banner
	end
	if not sameColor(from, to) then
		local oldHex, newHex = from:ToHex(), to:ToHex()
		theme.accent = to
		toastColors.info = to
		for _, d in ipairs(gui:GetDescendants()) do
			if d:IsA("GuiObject") then
				if sameColor(d.BackgroundColor3, from) then
					d.BackgroundColor3 = to
				end
				if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
					if sameColor(d.TextColor3, from) then
						d.TextColor3 = to
					end
					if d.RichText and string.find(d.Text, oldHex, 1, true) then
						d.Text = (string.gsub(d.Text, oldHex, newHex))
					end
				elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then
					if sameColor(d.ImageColor3, from) then
						d.ImageColor3 = to
					end
				elseif d:IsA("ScrollingFrame") then
					if sameColor(d.ScrollBarImageColor3, from) then
						d.ScrollBarImageColor3 = to
					end
				end
			elseif d:IsA("UIStroke") then
				if sameColor(d.Color, from) then
					d.Color = to
				end
			end
		end
	end
	setLogo(on and "spooky" or "normal")
	if Spooky.banner then
		Spooky.banner.Visible = on
	end
end

-- Rainbow theme: hidden until it is unlocked from the Credits in Settings. The accent colour cycles through
-- every hue. Instead of scanning the whole gui every frame, a slow background scan finds everything that
-- currently has the accent colour, and a light 30 fps loop only recolours those.
Rainbow.file = SAVE_FOLDER .. "/rainbow.state" -- holds "unlocked" or "on"

function Rainbow.load()
	if not fileSystemAvailable() then
		return
	end
	pcall(function()
		if isfile(Rainbow.file) then
			local raw = readfile(Rainbow.file)
			if raw == "on" then
				Rainbow.unlocked, Rainbow.wanted = true, true
			elseif raw == "unlocked" then
				Rainbow.unlocked = true
			end
		end
	end)
end

function Rainbow.save()
	if not (fileSystemAvailable() and Rainbow.unlocked) then
		return
	end
	pcall(function()
		if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(SAVE_FOLDER) then
			makefolder(SAVE_FOLDER)
		end
		writefile(Rainbow.file, Rainbow.wanted and "on" or "unlocked")
	end)
end

do
	local RunService = game:GetService("RunService")
	local TICK = 1 / 30 -- colour updates per second
	local SPEED = 0.08 -- full colour cycles per second
	local RECENT_MAX = 150 -- how many past colours still count as "the accent colour"
	local SLICE = 600 -- instances looked at per frame while scanning

	local recent, recentOrder = {}, {}
	local tracked = {} -- { instance, property }
	local scanList, scanIndex, scanNew, scanWait = nil, 1, {}, 0
	local hue, acc, conn = 0, 0, nil

	local function colorKey(c)
		return math.floor(c.R * 255 + 0.5) * 65536 + math.floor(c.G * 255 + 0.5) * 256 + math.floor(c.B * 255 + 0.5)
	end

	local function remember(c)
		local k = colorKey(c)
		recent[k] = (recent[k] or 0) + 1
		table.insert(recentOrder, k)
		if #recentOrder > RECENT_MAX then
			local old = table.remove(recentOrder, 1)
			local n = (recent[old] or 1) - 1
			recent[old] = n > 0 and n or nil
		end
	end

	-- Adds every accent-coloured property of this instance to list
	local function examine(d, list)
		if d:IsA("GuiObject") then
			if recent[colorKey(d.BackgroundColor3)] then
				table.insert(list, { d, "BackgroundColor3" })
			end
			if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
				if recent[colorKey(d.TextColor3)] then
					table.insert(list, { d, "TextColor3" })
				end
			elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then
				if recent[colorKey(d.ImageColor3)] then
					table.insert(list, { d, "ImageColor3" })
				end
			elseif d:IsA("ScrollingFrame") then
				if recent[colorKey(d.ScrollBarImageColor3)] then
					table.insert(list, { d, "ScrollBarImageColor3" })
				end
			end
		elseif d:IsA("UIStroke") then
			if recent[colorKey(d.Color)] then
				table.insert(list, { d, "Color" })
			end
		end
	end

	local function step(dt)
		if not gui.Parent then
			return
		end
		acc += dt
		if acc >= TICK then
			hue = (hue + SPEED * acc) % 1
			acc = 0
			local color = Color3.fromHSV(hue, 0.68, 1)
			for i = 1, #tracked do
				local e = tracked[i]
				local inst, prop = e[1], e[2]
				-- only touch it if it still has an accent colour (a toggle that turned off has moved on)
				if inst.Parent and recent[colorKey(inst[prop])] then
					inst[prop] = color
				end
			end
			remember(color)
			theme.accent = color
			toastColors.info = color
		end

		-- background scan, a slice per frame, then a pause. New buttons and rows get picked up here
		if not scanList then
			scanWait -= dt
			if scanWait <= 0 then
				scanList, scanIndex, scanNew = gui:GetDescendants(), 1, {}
			end
		else
			local last = math.min(scanIndex + SLICE - 1, #scanList)
			for i = scanIndex, last do
				local d = scanList[i]
				if d.Parent then
					examine(d, scanNew)
				end
			end
			scanIndex = last + 1
			if scanIndex > #scanList then
				tracked, scanList, scanWait = scanNew, nil, 1
			end
		end
	end

	function Rainbow.set(on)
		on = on == true
		if Rainbow.on == on then
			return
		end
		Rainbow.on = on
		if on then
			hue = theme.accent:ToHSV() -- start from the current colour so nothing jumps
			recent, recentOrder = {}, {}
			remember(theme.accent)
			tracked, scanList, scanWait, acc = {}, nil, 0, 0
			conn = connect(RunService.Heartbeat, step)
		else
			if conn then
				conn:Disconnect()
				conn = nil
			end
			-- put everything that still has a rainbow colour back to the normal accent
			local to = Spooky.on and theme.accentSpooky or theme.accentDefault
			for _, d in ipairs(gui:GetDescendants()) do
				local list = {}
				examine(d, list)
				for _, e in ipairs(list) do
					e[1][e[2]] = to
				end
			end
			theme.accent, toastColors.info = to, to
			recent, recentOrder, tracked, scanList = {}, {}, {}, nil
		end
	end

	Rainbow.load()
end

