	-- Shows `text` on a button, then puts the old text back after `hold` seconds
	local function say(btn, original, text, hold)
		btn.Text = text
		if hold then
			task.delay(hold, function()
				if btn.Parent then
					btn.Text = original
				end
			end)
		end
	end

	local busy = {}

	local function runScript(item, btn)
		if busy[item] then
			return
		end
		if typeof(loadstring) ~= "function" then
			say(btn, "Run", "No exec", 1.4)
			return
		end
		busy[item] = true
		say(btn, "Run", "...")
		task.spawn(function()
			local source = getSource(item)
			if not source then
				busy[item] = nil
				say(btn, "Run", "Failed", 1.4)
				return
			end
			LoadLogger.ignore = true -- scripts run from the browser aren't logged, same as Keyboard / Dex
			local fn, err = loadstring(source)
			LoadLogger.ignore = false
			if not fn then
				busy[item] = nil
				warn("[Toolx] " .. item.title .. " failed to compile: " .. tostring(err))
				say(btn, "Run", "Bad script", 1.4)
				return
			end
			say(btn, "Run", "Ran", 1.4)
			notify("Running " .. item.title, "success")
			task.spawn(function()
				local ok, runErr = pcall(fn)
				if not ok then
					warn("[Toolx] " .. item.title .. " errored: " .. tostring(runErr))
					notify(item.title .. " errored (see console)", "error")
				end
			end)
			busy[item] = nil
		end)
	end

	local function copyScript(item, btn)
		task.spawn(function()
			say(btn, "Copy", "...")
			local source = getSource(item)
			if not source then
				say(btn, "Copy", "Failed", 1.4)
			elseif copyToClipboard(source) then
				say(btn, "Copy", "Copied!", 1.4)
			else
				say(btn, "Copy", "No clip", 1.4)
			end
		end)
	end

