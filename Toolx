local KEYBOARD_URL = "https://raw.githubusercontent.com/AZYsGithub/Delta-Scripts/main/MobileKeyboard.txt"
local DEX_URL = "https://raw.githubusercontent.com/infyiff/backup/main/dex.lua"

local function fetchUrl(url)
	local ok, body = pcall(function()
		return game:HttpGet(url)
	end)
	if ok and typeof(body) == "string" and #body > 0 then
		return body
	end
	-- fallback for executors without game:HttpGet
	local req = (typeof(request) == "function" and request)
		or (typeof(http_request) == "function" and http_request)
		or (typeof(syn) == "table" and syn.request)
	if req then
		local ok2, res = pcall(req, { Url = url, Method = "GET" })
		if ok2 and typeof(res) == "table" and typeof(res.Body) == "string" and #res.Body > 0 then
			return res.Body
		end
	end
	return nil
end

local remoteRunning = {}

-- Downloads a script and runs it, showing progress on the button's label.
-- It never logs to the Loadlogger, that is for scripts you run yourself.
local function runRemote(lbl, name, url)
	local original = lbl.Text
	local function status(text)
		lbl.Text = text
		task.delay(1.6, function()
			if lbl.Parent then
				lbl.Text = original
			end
		end)
	end

	if remoteRunning[name] then
		status(name .. " already running")
		return
	end
	if typeof(loadstring) ~= "function" then
		status("No loadstring")
		return
	end

	lbl.Text = "Loading " .. name .. "..."
	local source = fetchUrl(url)
	if not source then
		status("Couldn't download " .. name)
		return
	end

	LoadLogger.ignore = true
	local fn, err = loadstring(source)
	LoadLogger.ignore = false
	if not fn then
		warn("[Toolx] " .. name .. " failed to compile: " .. tostring(err))
		status(name .. " failed to load")
		return
	end

	remoteRunning[name] = true
	local ok, runErr = pcall(fn)
	if not ok then
		remoteRunning[name] = nil
		warn("[Toolx] " .. name .. " errored: " .. tostring(runErr))
		status(name .. " errored")
		return
	end
	status(name .. " loaded")
end

