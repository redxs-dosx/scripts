local function selectTab(tab)
	if currentTab == tab then
		return
	end
	currentTab = tab

	tween(indicator, 0.35, { Position = UDim2.new(0, 8, 0, tab.y) })

	-- keep the selected tab in view when the sidebar is scrolled
	local viewH = sidebarScroll.AbsoluteWindowSize.Y
	local top = sidebarScroll.CanvasPosition.Y
	if tab.y < top then
		tween(sidebarScroll, 0.3, { CanvasPosition = Vector2.new(0, math.max(tab.y - 10, 0)) })
	elseif tab.y + 32 > top + viewH then
		tween(sidebarScroll, 0.3, { CanvasPosition = Vector2.new(0, tab.y + 42 - viewH) })
	end

	for _, t in ipairs(tabs) do
		tween(t.button, 0.2, { TextColor3 = (t == tab) and theme.text or theme.dim })
		if t ~= tab and t.page.Visible then
			tween(t.page, 0.15, { GroupTransparency = 1 })
			task.delay(0.15, function()
				if currentTab ~= t then
					t.page.Visible = false
				end
			end)
		end
	end

	tab.page.Position = UDim2.fromOffset(0, 12)
	tab.page.GroupTransparency = 1
	tab.page.Visible = true
	tween(tab.page, 0.35, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })
end

-- Lays the sidebar buttons out again so hidden tabs leave no gap
local function relayoutTabs()
	local y = 10
	for _, t in ipairs(tabs) do
		if t.hidden then
			t.button.Visible = false
		else
			t.button.Visible = true
			t.y = y
			t.button.Position = UDim2.new(0, 8, 0, y)
			y += 36
		end
	end
	sidebarScroll.CanvasSize = UDim2.fromOffset(0, y + 6)
	if currentTab and not currentTab.hidden then
		tween(indicator, 0.25, { Position = UDim2.new(0, 8, 0, currentTab.y) })
	end
end

local function setTabHidden(tab, hidden)
	hidden = hidden == true
	if tab.hidden == hidden then
		return
	end
	tab.hidden = hidden
	if hidden and currentTab == tab and tabs[1] and tabs[1] ~= tab then
		selectTab(tabs[1])
	end
	relayoutTabs()
end

