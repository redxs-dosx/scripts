local Toolx -- public API table, assigned below
local tabs = {}
local currentTab

local function selectTab(tab)
	if currentTab == tab then
		return
	end
	currentTab = tab

	tween(indicator, 0.35, { Position = UDim2.new(0, 8, 0, tab.y) })

	for _, t in ipairs(tabs) do
		tween(t.button, 0.2, { TextColor3 = (t == tab) and theme.text or theme.dim })
		if t ~= tab and t.page.Visible then
			tween(t.page, 0.15, { GroupTransparency = 1 })
			task.delay(0.15, function()
				if currentTab ~= t then
					t.page.Visible = false
				end
			end)
		end
	end

	tab.page.Position = UDim2.fromOffset(0, 12)
	tab.page.GroupTransparency = 1
	tab.page.Visible = true
	tween(tab.page, 0.35, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })
end

local function addTab(name)
	local index = #tabs + 1
	local y = 10 + (index - 1) * 42

	local button = new("TextButton", {
		Name = name,
		Text = name,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
