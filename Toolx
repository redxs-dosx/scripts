-- Helper to resolve instance paths like "game.Players.LocalPlayer" or "workspace.Part"
local function resolveInstance(path)
	if not path or path == "" then return player end
	local lower = path:lower()
	if lower == "me" or lower == "player" or lower == "localplayer" then return player end
	if lower == "character" or "char" then return player.Character end
	if lower == "workspace" then return workspace end
	
	local current = game
	for part in path:gmatch("[^%.]+") do
		if current then
			current = current:FindFirstChild(part) or current[part]
		end
	end
	return current or workspace
end

-- Helper to parse tables from JSON or comma-separated lists
local function resolveTable(text)
	if not text or text == "" then return {} end
	local ok, res = pcall(function()
		return HttpService:JSONDecode(text)
	end)
	if ok and typeof(res) == "table" then
		return res
	end
	local t = {}
	for item in text:gmatch("[^,%s]+") do
		local num = tonumber(item)
		table.insert(t, num or item)
	end
	return t
end

