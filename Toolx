---------------------------------------------------------------------
-- Desync module (client box vs server box, freeze client / server)
---------------------------------------------------------------------
local Desync = {}
do
	local flags = { boxes = false, client = false, server = false }
	local boxClient, boxServer, ghost, serverPin
	local loopConn, addedConn, removingConn

	-- Both boxes use the same size
	local BOX_SIZE = Vector3.new(2.4, 2.4, 1.4)
	local GHOST_TRANSPARENCY = 0.5
	-- Roblox replicates your character about 20 times a second, so on average the server
	-- is half a send interval behind on top of the network travel time
	local SEND_HALF_INTERVAL = 0.025
	local HISTORY_SECONDS = 3

	local history = {}
	local smoothedOneWay = 0.05
	local lastStatUpdate = 0

	local function getRak()
		local rak
		pcall(function()
			rak = raknet
		end)
		if typeof(rak) == "table" then
			return rak
		end
		return nil
	end

	local function getChar()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		return char, hrp, hum
	end

	local function makeBox(name, color, size, zIndex)
		local part = Instance.new("Part")
		part.Name = name
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.CastShadow = false
		part.Transparency = 1
		part.Size = size
		local adorn = Instance.new("BoxHandleAdornment")
		adorn.Adornee = part
		adorn.Size = size
		adorn.Color3 = color
		adorn.Transparency = 0.55
		adorn.AlwaysOnTop = true
		adorn.ZIndex = zIndex or 5
		adorn.Visible = flags.boxes
		adorn.Parent = part
		part.Parent = workspace
		return part
	end

	local function destroyGhost()
		if ghost then
			ghost:Destroy()
			ghost = nil
		end
		local _, _, hum = getChar()
		local cam = workspace.CurrentCamera
		if cam and hum then
			cam.CameraSubject = hum
		end
	end

	local function createGhost()
		local char, hrp, hum = getChar()
		if not (char and hrp and hum) then
			return
		end
		if ghost then
			ghost:Destroy()
			ghost = nil
		end

		local oldArchivable = char.Archivable
		char.Archivable = true
		local clone = char:Clone()
		char.Archivable = oldArchivable
		if not clone then
			return
		end

		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BaseScript") then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				-- slightly see-through (invisible parts like the root stay invisible)
				if d.Transparency < GHOST_TRANSPARENCY then
					d.Transparency = GHOST_TRANSPARENCY
				end
			elseif d:IsA("Decal") or d:IsA("Texture") then
				if d.Transparency < GHOST_TRANSPARENCY then
					d.Transparency = GHOST_TRANSPARENCY
				end
			end
		end
		clone.Name = "ToolxGhost"
		-- No Humanoid on the clone: a Humanoid keeps forcing CanCollide back on for its limbs,
		-- which is what lets a clone bump into you. Without one it is just anchored, non-colliding parts.
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("Humanoid") then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.Massless = true
			end
		end
		clone.Parent = workspace
		ghost = clone

		-- the camera can follow a plain part, so use the clone's head
		local subject = clone:FindFirstChild("Head") or clone:FindFirstChild("HumanoidRootPart")
		local cam = workspace.CurrentCamera
		if cam and subject then
			cam.CameraSubject = subject
		end
	end

	-- One-way network latency (client -> server) in seconds
	local function sampleOneWay()
		local okPing, ping = pcall(function()
			return player:GetNetworkPing()
		end)
		if okPing and typeof(ping) == "number" and ping > 0 then
			return ping
		end
		local okStat, ms = pcall(function()
			return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
		end)
		if okStat and typeof(ms) == "number" and ms > 0 then
			return ms / 2000 -- round-trip ms -> one-way seconds
		end
		return nil
	end

	-- Where your root part was at a past moment, interpolated from recorded frames
	local function sampleHistory(target)
		local n = #history
		if n == 0 then
			return nil
		end
		if target <= history[1].t then
			return history[1].cf
		end
		for i = n, 2, -1 do
			local a, b = history[i - 1], history[i]
			if a.t <= target then
				local span = b.t - a.t
				local alpha = span > 0 and (target - a.t) / span or 1
				return a.cf:Lerp(b.cf, math.clamp(alpha, 0, 1))
			end
		end
		return history[1].cf
	end

	local function update()
		local _, hrp = getChar()
		if not hrp or not boxClient or not boxServer then
			return
		end

		-- your client simulates your character, so its real position is always your actual root part
		local clientCF = hrp.CFrame

		-- The server only knows where you were about one latency ago
		local now = os.clock()
		local oneWay = sampleOneWay()
		if oneWay then
			smoothedOneWay += (oneWay - smoothedOneWay) * 0.1
		end
		table.insert(history, { t = now, cf = hrp.CFrame })
		while #history > 2 and history[2].t < now - HISTORY_SECONDS do
			table.remove(history, 1)
		end
		local lag = smoothedOneWay + SEND_HALF_INTERVAL

		local serverCF = sampleHistory(now - lag) or hrp.CFrame
		if flags.server and serverPin then
			serverCF = serverPin
		end

		if Desync.OnStats and now - lastStatUpdate > 0.25 then
			lastStatUpdate = now
			Desync.OnStats(string.format(
				"Ping %d ms | green box trails you by %d ms",
				math.floor(smoothedOneWay * 2000 + 0.5),
				math.floor(lag * 1000 + 0.5)
			))
		end

		boxClient.CFrame = clientCF
		boxServer.CFrame = serverCF

		-- the clone sits exactly on the green box, so you see (and your camera follows)
		-- the delayed position the server has for you
		if flags.client and ghost then
			ghost:PivotTo(serverCF)
		end

		local a = boxClient:FindFirstChildOfClass("BoxHandleAdornment")
		local b = boxServer:FindFirstChildOfClass("BoxHandleAdornment")
		if a then a.Visible = flags.boxes end
		if b then b.Visible = flags.boxes end
	end

	local function onCharacterRemoving()
		if ghost then
			ghost:Destroy()
			ghost = nil
		end
		serverPin = nil
		table.clear(history)
	end

	local function onCharacterAdded(char)
		local hrp = char:WaitForChild("HumanoidRootPart", 5)
		task.wait(0.25)
		table.clear(history)
		if not hrp or not flags.client and not flags.server then
			return
		end
		if flags.client then
			createGhost()
		end
		if flags.server then
			serverPin = hrp.CFrame
		end
	end

	local function startLoop()
		if loopConn then
			return
		end
		-- blue = where the client thinks you are, green = where the server thinks you are
		boxClient = makeBox("ToolxClientBox", Color3.fromRGB(70, 130, 255), BOX_SIZE, 6)
		boxServer = makeBox("ToolxServerBox", Color3.fromRGB(60, 220, 120), BOX_SIZE, 5)
		-- run just before the camera updates so the camera follows the clone without an extra frame of delay
		RunService:BindToRenderStep("ToolxDesync", Enum.RenderPriority.Camera.Value - 1, update)
		loopConn = true
		addedConn = player.CharacterAdded:Connect(onCharacterAdded)
		removingConn = player.CharacterRemoving:Connect(onCharacterRemoving)
	end

	local function stopLoop()
		table.clear(history)
		if Desync.OnStats then
			Desync.OnStats("Ping: --")
		end
		if loopConn then
			pcall(function()
				RunService:UnbindFromRenderStep("ToolxDesync")
			end)
			loopConn = nil
		end
		if addedConn then
			addedConn:Disconnect()
			addedConn = nil
		end
		if removingConn then
			removingConn:Disconnect()
			removingConn = nil
		end
		if boxClient then
			boxClient:Destroy()
			boxClient = nil
		end
		if boxServer then
			boxServer:Destroy()
			boxServer = nil
		end
	end

	local function refresh()
		if flags.boxes or flags.client or flags.server then
			startLoop()
		else
			stopLoop()
		end
	end

	function Desync.SetBoxes(on)
		flags.boxes = on
		refresh()
	end

	function Desync.SetClientFreeze(on)
		flags.client = on
		if on then
			refresh()
			createGhost()
		else
			destroyGhost()
			refresh()
		end
	end

	function Desync.SetServerFreeze(on)
		flags.server = on
		refresh()
		if on then
			-- pin the green box where the server last saw you (your position one latency ago)
			local _, hrp = getChar()
			local lag = smoothedOneWay + SEND_HALF_INTERVAL
			serverPin = sampleHistory(os.clock() - lag) or (hrp and hrp.CFrame)
		else
			serverPin = nil
		end

		local rak = getRak()
		if rak and typeof(rak.desync) == "function" then
			pcall(rak.desync, on)
		else
			warn("[Toolx] RakNet not detected")
		end
	end

	function Desync.IsRaknetOn()
		local rak = getRak()
		if not rak or typeof(rak.is_enabled) ~= "function" then
			return false
		end
		local ok, value = pcall(rak.is_enabled)
		return (ok and value) and true or false
	end

	function Desync.Unload()
		local wasServer = flags.server
		flags.boxes = false
		flags.client = false
		flags.server = false
		destroyGhost()
		serverPin = nil
		stopLoop()
		if wasServer then
			local rak = getRak()
			if rak and typeof(rak.desync) == "function" then
				pcall(rak.desync, false)
			end
		end
	end

	if getRak() then
		print("[Toolx] RakNet detected")
	else
		print("[Toolx] RakNet not detected")
	end
end

