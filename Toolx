-- Options created after startup (a module building its UI) still get their saved value back
setmetatable(registry, {
	__newindex = function(t, key, comp)
		rawset(t, key, comp)
		if not (Modules.startupDone and keepEnabled and typeof(key) == "string" and typeof(comp) == "table" and comp.Get and comp.Set) then
			return
		end
		local value = savedData.options[key]
		if value ~= nil and typeof(value) == typeof(comp.Get()) then
			task.defer(function()
				local was = loadingOptions
				loadingOptions = true
				pcall(comp.Set, value)
				loadingOptions = was
			end)
		end
	end,
})
do
	local function getJson(url)
		local body = fetchUrl(url)
		if not body then
			return nil
		end
		local ok, data = pcall(function()
			return HttpService:JSONDecode(body)
		end)
		return (ok and typeof(data) == "table") and data or nil
	end

	-- Only the first line counts
	function Modules.parseHeader(body)
		body = body:gsub("^\239\187\191", "") -- strip a UTF-8 BOM
		local first = body:match("^[^\r\n]*") or ""
		first = first:gsub("%-%-.*$", "")
		local name, value = first:match("^%s*local%s+([%w_]+)%s*=%s*(.-)%s*;?%s*$")
		if not name or name:lower() ~= "gameid" then
			return nil
		end
		local ids = {}
		for id in value:gmatch("%d+") do
			table.insert(ids, id)
		end
		return #ids > 0 and ids or nil
	end

	function Modules.rebuildKnown()
		local known = {}
		for _, item in ipairs(Modules.items or {}) do
			for _, id in ipairs(item.ids) do
				known[id] = true
			end
		end
		for _, info in pairs(Modules.info) do
			if info.placeId then
				known[tostring(info.placeId)] = true
			end
			if info.universeId then
				known[tostring(info.universeId)] = true
			end
		end
		Modules.known = known
	end

	-- One tree call lists the repo, then the files are downloaded a few at a time
	function Modules.build()
		local base = "https://raw.githubusercontent.com/" .. Modules.owner .. "/" .. Modules.repo .. "/" .. Modules.branch .. "/"
		local data = getJson("https://api.github.com/repos/" .. Modules.owner .. "/" .. Modules.repo .. "/git/trees/" .. Modules.branch .. "?recursive=1")
		if not data or typeof(data.tree) ~= "table" then
			return nil, "Couldn't read the modules repo. GitHub may be rate limiting you, try again in a while."
		end
		local files = {}
		for _, node in ipairs(data.tree) do
			if typeof(node) == "table" and node.type == "blob" and typeof(node.path) == "string" and node.path:lower():match("%.luau?$") then
				table.insert(files, node.path)
			end
		end

		local results, cursor, active = {}, 0, 0
		local function worker()
			while true do
				cursor += 1
				local i = cursor
				local path = files[i]
				if not path then
					break
				end
				local encoded = (path:gsub("[^/]+", function(seg)
					return HttpService:UrlEncode(seg)
				end))
				local url = base .. encoded
				local body = fetchUrl(url)
				local ids = body and Modules.parseHeader(body)
				if ids then
					local file = path:match("([^/]+)$") or path
					results[i] = { path = path, title = (file:gsub("%.luau?$", "")), ids = ids, source = body, rawUrl = url }
				end
			end
			active -= 1
		end
		for _ = 1, math.min(8, #files) do
			active += 1
			task.spawn(worker)
		end
		local waited = 0
		while active > 0 and waited < 60 do
			task.wait(0.1)
			waited += 0.1
		end

		local items = {}
		for i = 1, #files do
			if results[i] then
				table.insert(items, results[i])
			end
		end
		return items
	end

	-- Loaded once per session; Load(true) pulls the repo again
	function Modules.Load(force)
		if force and not Modules.loading then
			-- pull the repo again, but keep the old data if that fails
			Modules.loading = true
			local ok, items, err = pcall(Modules.build)
			Modules.loading = false
			if ok and items then
				Modules.items = items
				Modules.info = {}
				Modules.rebuildKnown()
				return items
			end
			return Modules.items, (ok and err) or "Couldn't read the modules repo."
		end
		if Modules.items then
			return Modules.items
		end
		if Modules.loading then
			local waited = 0
			while Modules.loading and waited < 70 do
				task.wait(0.2)
				waited += 0.2
			end
			if Modules.items then
				return Modules.items
			end
			return nil, "The modules repo didn't finish loading."
		end
		Modules.loading = true
		local ok, items, err = pcall(Modules.build)
		Modules.loading = false
		if not ok then
			return nil, "Couldn't read the modules repo."
		end
		if items then
			Modules.items = items
			Modules.rebuildKnown()
		end
		return items, err
	end

	-- A module's id can be a place id or a universe id, so work out both plus the game's name
	local function resolveOne(id)
		local info = { id = id }
		local universe
		local d = getJson("https://apis.roblox.com/universes/v1/places/" .. id .. "/universe")
		if d and d.universeId then
			universe = tostring(d.universeId)
			info.placeId = id
		else
			universe = id
		end
		local g = getJson("https://games.roblox.com/v1/games?universeIds=" .. universe)
		local entry = g and typeof(g.data) == "table" and g.data[1]
		if typeof(entry) == "table" then
			info.name = entry.name and tostring(entry.name) or nil
			info.players = tonumber(entry.playing) or 0
			info.universeId = tostring(entry.id or universe)
			info.placeId = info.placeId or (entry.rootPlaceId and tostring(entry.rootPlaceId)) or nil
		elseif info.placeId then
			info.universeId = universe
			pcall(function()
				info.name = game:GetService("MarketplaceService"):GetProductInfo(tonumber(id)).Name
			end)
		end
		return info
	end

	function Modules.Resolve()
		local items = Modules.Load()
		if not items then
			return false
		end
		if Modules.resolving then
			local waited = 0
			while Modules.resolving and waited < 70 do
				task.wait(0.2)
				waited += 0.2
			end
			return true
		end
		local todo, seen = {}, {}
		for _, item in ipairs(items) do
			for _, id in ipairs(item.ids) do
				if not Modules.info[id] and not seen[id] then
					seen[id] = true
					table.insert(todo, id)
				end
			end
		end
		if #todo == 0 then
			return true
		end
		Modules.resolving = true
		local cursor, active = 0, 0
		local function worker()
			while true do
				cursor += 1
				local id = todo[cursor]
				if not id then
					break
				end
				local ok, info = pcall(resolveOne, id)
				Modules.info[id] = ok and info or { id = id }
			end
			active -= 1
		end
		for _ = 1, math.min(6, #todo) do
			active += 1
			task.spawn(worker)
		end
		local waited = 0
		while active > 0 and waited < 60 do
			task.wait(0.1)
			waited += 0.1
		end
		Modules.resolving = false
		Modules.rebuildKnown()
		return true
	end

	-- One entry per supported game, each with the modules that belong to it
	function Modules.Games()
		local items, err = Modules.Load()
		if not items then
			return nil, err
		end
		Modules.Resolve()
		local byKey, list = {}, {}
		for _, item in ipairs(items) do
			for _, id in ipairs(item.ids) do
				local info = Modules.info[id] or {}
				local key = info.universeId or id
				local g = byKey[key]
				if not g then
					g = {
						id = id,
						universeId = info.universeId,
						placeId = info.placeId or id,
						name = info.name or ("Game " .. id),
						players = info.players or 0,
						modules = {},
					}
					byKey[key] = g
					table.insert(list, g)
				end
				local dupe = false
				for _, m in ipairs(g.modules) do
					if m == item then
						dupe = true
					end
				end
				if not dupe then
					table.insert(g.modules, item)
				end
			end
		end
		table.sort(list, function(a, b)
			return a.name:lower() < b.name:lower()
		end)
		return list
	end

	-- Modules that belong to the game you're in right now
	function Modules.ForCurrentGame()
		local out = {}
		local place, uni = tostring(game.PlaceId), tostring(game.GameId)
		for _, item in ipairs(Modules.items or {}) do
			for _, id in ipairs(item.ids) do
				local info = Modules.info[id]
				if id == place or id == uni or (info and (info.universeId == uni or info.placeId == place)) then
					table.insert(out, item)
					break
				end
			end
		end
		return out
	end

	function Modules.CurrentName()
		local place, uni = tostring(game.PlaceId), tostring(game.GameId)
		for _, item in ipairs(Modules.ForCurrentGame()) do
			for _, id in ipairs(item.ids) do
				local info = Modules.info[id]
				if info and info.name and (id == place or id == uni or info.universeId == uni or info.placeId == place) then
					return info.name
				end
			end
		end
		return (game.Name and game.Name ~= "" and game.Name) or "Module"
	end

	function Modules.IsSupported(universeId, placeId)
		return Modules.known[tostring(universeId)] == true or Modules.known[tostring(placeId)] == true
	end

	-- Games in Roblox's own lists, supported ones first (keeps the original order inside each group)
	function Modules.SortSupported(list)
		local first, rest = {}, {}
		for _, g in ipairs(list) do
			if Modules.IsSupported(g.universeId, g.placeId) then
				g.supported = true
				table.insert(first, g)
			else
				table.insert(rest, g)
			end
		end
		for _, g in ipairs(rest) do
			table.insert(first, g)
		end
		return first
	end

	-- Every supported game, shaped like a Roblox list entry so the Main tab can draw it
	function Modules.SupportedGames(query)
		local games, err = Modules.Games()
		if not games then
			return nil, err
		end
		local q = (query or ""):lower()
		local out = {}
		for _, g in ipairs(games) do
			if q == "" or g.name:lower():find(q, 1, true) then
				table.insert(out, {
					universeId = g.universeId,
					placeId = tonumber(g.placeId) or g.placeId,
					name = g.name,
					players = g.players,
					up = 0,
					down = 0,
					supported = true,
				})
			end
		end
		if #out == 0 then
			if q ~= "" then
				return nil, 'No supported games match "' .. query .. '".'
			end
			return nil, "No supported games yet."
		end
		return out
	end
end

