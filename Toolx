-- Restore saved options (only when "Keep options" was on last time)
if keepEnabled then
	loadingOptions = true
	for key, comp in pairs(registry) do
		local value = savedData.options[key]
		local available = not (comp.IsEnabled and not comp.IsEnabled())
		if value ~= nil and available and typeof(value) == typeof(comp.Get()) then
			pcall(comp.Set, value)
		end
	end
	loadingOptions = false

	-- make sure the saved topbar really gets applied (size first, then style)
	local savedStyle = savedData.options["world.topbar"]
	if savedStyle == "2018" or savedStyle == "2021" then
		local savedSize = savedData.options["world.topbarSize"]
		task.spawn(function()
			task.wait(0.5)
			if closing then
				return
			end
			if typeof(savedSize) == "number" then
				pcall(Topbar.SetScale, savedSize)
			end
			pcall(Topbar.Set, savedStyle)
		end)
	end
end

