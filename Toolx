local function getBuiltArguments()
	local args = {}
	for _, item in ipairs(customArgsList) do
		if item.type == "String" then
			table.insert(args, item.val)
		elseif item.type == "Number" then
			table.insert(args, tonumber(item.val) or 0)
		elseif item.type == "Boolean" then
			table.insert(args, item.val:lower() == "true")
		elseif item.type == "Instance" then
			table.insert(args, resolveInstance(item.val))
		elseif item.type == "Table" then
			table.insert(args, resolveTable(item.val))
		end
	end
	if #args == 0 then
		table.insert(args, "Toolx Manual Fire")
	end
	return args
end

