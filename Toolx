	-- A row that drops open to a short list. Tap it, pick an option and that option turns on (only one at a time).
	-- Tap the row again to turn it off. The list closes when you scroll or switch tabs.
	-- callback(optionName or nil) fires whenever it changes; Set(name or nil) / Get() control it from code.
	function api:DropToggle(text, options, callback)
		local HEAD, OPT, GAP = 38, 30, 4
		local openH = HEAD + GAP + #options * (OPT + GAP)

		local wrap = new("Frame", {
			Size = UDim2.new(1, 0, 0, HEAD),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			LayoutOrder = nextOrder(),
		}, scroller)
		local head = new("TextButton", {
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.new(1, 0, 0, HEAD),
			BackgroundColor3 = theme.surface,
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
		}, wrap)
		corner(head, 8)
		stroke(head, 0.94)
		new("TextLabel", {
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = theme.text,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(0.5, -12, 1, 0),
		}, head)
		local status = new("TextLabel", {
			Text = "Off",
			Font = Enum.Font.GothamMedium,
			TextSize = 12,
			TextColor3 = theme.dim,
			TextXAlignment = Enum.TextXAlignment.Right,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -32, 0, 0),
			Size = UDim2.new(0.5, -32, 1, 0),
		}, head)
		local arrow = new("TextLabel", {
			Text = "v",
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextColor3 = theme.dim,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
		}, head)

		local active = nil
		local open = false
		local suppressUntil = 0 -- scrolling we do ourselves (to bring the list into view) shouldn't close it
		local buttons = {}

		local function render()
			status.Text = active or "Off"
			tween(status, 0.2, { TextColor3 = active and theme.accent or theme.dim })
			for opt, b in pairs(buttons) do
				local on = opt == active
				tween(b, 0.2, {
					BackgroundColor3 = on and theme.accent or theme.off,
					TextColor3 = on and theme.white or theme.dim,
				})
			end
		end

		local function setOpen(v)
			if open == v then
				return
			end
			open = v
			tween(wrap, 0.25, { Size = UDim2.new(1, 0, 0, v and openH or HEAD) })
			tween(arrow, 0.25, { Rotation = v and 180 or 0 })
			if v then
				-- scroll down a little if the list would run off the bottom of the page
				local scale = wrap.AbsoluteSize.Y / HEAD
				if scale <= 0 then
					scale = 1
				end
				local bottom = wrap.AbsolutePosition.Y + openH * scale
				local limit = scroller.AbsolutePosition.Y + scroller.AbsoluteSize.Y
				if bottom > limit then
					suppressUntil = os.clock() + 0.6
					tween(scroller, 0.25, {
						CanvasPosition = Vector2.new(0, scroller.CanvasPosition.Y + (bottom - limit) + 8),
					})
				end
			end
		end

		local function set(opt, silent)
			if opt ~= nil and buttons[opt] == nil then
				return
			end
			if opt == active then
				return
			end
			active = opt
			render()
			if callback and not silent then
				task.spawn(callback, opt)
			end
		end

		for i, opt in ipairs(options) do
			local b = new("TextButton", {
				Text = opt,
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = theme.dim,
				AutoButtonColor = false,
				BackgroundColor3 = theme.off,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(0, HEAD + GAP + (i - 1) * (OPT + GAP)),
				Size = UDim2.new(1, 0, 0, OPT),
			}, wrap)
			corner(b, 8)
			buttons[opt] = b
			connect(b.Activated, function()
				set(opt)
				setOpen(false)
			end)
		end
		render()

		connect(head.Activated, function()
			if active then
				set(nil) -- already on: tapping again turns it off
				setOpen(false)
			else
				setOpen(not open)
			end
		end)

		-- close when the page is scrolled or the tab is switched away
		connect(scroller:GetPropertyChangedSignal("CanvasPosition"), function()
			if open and os.clock() > suppressUntil then
				setOpen(false)
			end
		end)
		connect(page:GetPropertyChangedSignal("Visible"), function()
			if not page.Visible then
				setOpen(false)
			end
		end)

		return {
			Set = set,
			Get = function()
				return active
			end,
		}
	end

	-- Press-a-key picker: tap the row, then press the key to bind it (Esc cancels, Backspace clears).
	-- Get / Set use the KeyCode name ("RightShift"), or "None". callback(name) fires when it changes.
	function api:Keybind(text, default, callback, key)
		local current = default or "None"
		local listening = false
		local listenConn

		local r = row(38)
		new("TextLabel", {
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = theme.text,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(1, -130, 1, 0),
		}, r)
		local chip = new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(106, 24),
			BackgroundColor3 = theme.off,
			BorderSizePixel = 0,
		}, r)
		corner(chip, 6)
		local keyLabel = new("TextLabel", {
			Text = current,
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextColor3 = theme.accent,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
		}, chip)

		local function show()
			keyLabel.Text = listening and "Press a key..." or current
			keyLabel.TextColor3 = listening and theme.amber or theme.accent
		end

		local function set(name, silent)
			if typeof(name) ~= "string" then
				return
			end
			local valid = name == "None" or (pcall(function()
				return Enum.KeyCode[name]
			end))
			if not valid then
				return
			end
			local changed = name ~= current
			current = name
			show()
			if changed and not silent then
				if callback then
					task.spawn(callback, name)
				end
				if key then
					optionChanged()
				end
			end
		end

		local function stopListening()
			listening = false
			if listenConn then
				listenConn:Disconnect()
				listenConn = nil
			end
			-- clear on the next resumption point so the same key press can't also toggle the window
			task.defer(function()
				capturingKey = false
			end)
			show()
		end

		connect(r.MouseEnter, function()
			tween(r, 0.15, { BackgroundTransparency = 0.2 })
		end)
		connect(r.MouseLeave, function()
			tween(r, 0.15, { BackgroundTransparency = 0.35 })
		end)
		connect(r.Activated, function()
			if listening then
				stopListening()
				return
			end
			listening = true
			capturingKey = true
			show()
			listenConn = connect(UserInputService.InputBegan, function(input)
				if input.UserInputType ~= Enum.UserInputType.Keyboard then
					return
				end
				if input.KeyCode == Enum.KeyCode.Escape then
					stopListening()
				elseif input.KeyCode == Enum.KeyCode.Backspace then
					stopListening()
					set("None")
				elseif input.KeyCode ~= Enum.KeyCode.Unknown then
					stopListening()
					set(input.KeyCode.Name)
				end
			end)
		end)

		local comp = {
			Set = set,
			Get = function()
				return current
			end,
		}
		if key then
			registry[key] = comp
		end
		return comp
	end

	-- Key / value row. Tapping calls onTap(currentValue); if it returns a string, that text flashes in the value.
	function api:InfoRow(key, value, onTap)
		local r = row(30)
		new("TextLabel", {
			Text = key,
