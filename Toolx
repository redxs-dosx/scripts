	-- Scrolling box of rich-text lines (used for chat logs)
	function api:LogBox(height, maxLines, emptyText)
		maxLines = maxLines or 200
		local r = new("Frame", {
			Size = UDim2.new(1, 0, 0, height),
			BackgroundColor3 = theme.surface,
			BackgroundTransparency = 0.45,
			BorderSizePixel = 0,
			LayoutOrder = nextOrder(),
		}, scroller)
		corner(r, 8)
		stroke(r, 0.94)

		local list = new("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = theme.accent,
			ScrollBarImageTransparency = 0.4,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
		}, r)
		new("UIPadding", {
			PaddingTop = UDim.new(0, 6),
			PaddingBottom = UDim.new(0, 6),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}, list)
		new("UIListLayout", {
			Padding = UDim.new(0, 3),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, list)

		local emptyLabel = new("TextLabel", {
			Text = emptyText or "No messages yet",
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextColor3 = theme.dim,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
		}, r)

		local labels = {}
		local lineCount = 0
		local box = {}

		-- onClick (optional) makes the line tappable; if it returns a string, that text flashes on the line
		function box.Add(richText, onClick)
			-- only auto-scroll if the reader is already at the bottom
			local nearBottom = list.CanvasPosition.Y + list.AbsoluteWindowSize.Y >= list.AbsoluteCanvasSize.Y - 24
			lineCount += 1
			local lbl = new(onClick and "TextButton" or "TextLabel", {
				Text = richText,
				RichText = true,
				Font = Enum.Font.Gotham,
				TextSize = 12,
				TextColor3 = theme.text,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				BackgroundTransparency = 1,
				AutomaticSize = Enum.AutomaticSize.Y,
				Size = UDim2.new(1, 0, 0, 0),
				LayoutOrder = lineCount,
			}, list)
			if onClick then
				lbl.AutoButtonColor = false
				lbl.BackgroundColor3 = theme.accent
				lbl.Activated:Connect(function()
					lbl.BackgroundTransparency = 0.7
					tween(lbl, 0.4, { BackgroundTransparency = 1 })
					local result = onClick()
					if typeof(result) == "string" then
						lbl.Text = '<font color="#8c9bff">' .. result .. "</font>"
						task.delay(1, function()
							if lbl.Parent then
								lbl.Text = richText
							end
						end)
					end
				end)
			end
			table.insert(labels, lbl)
			if #labels > maxLines then
				table.remove(labels, 1):Destroy()
			end
			emptyLabel.Visible = false
			if nearBottom then
				task.delay(0.03, function()
					if list.Parent then
						list.CanvasPosition = Vector2.new(0, list.AbsoluteCanvasSize.Y)
					end
				end)
			end
			return lbl
		end

		function box.Clear()
			for _, l in ipairs(labels) do
				l:Destroy()
			end
			table.clear(labels)
			emptyLabel.Visible = true
		end

		return box
	end

	function api:Slider(text, min, max, default, callback, key)
		local r = row(54)
		local value = math.clamp(default, min, max)

		new("TextLabel", {
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = theme.text,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(1, -80, 0, 20),
		}, r)
		local valueLabel = new("TextLabel", {
			Text = tostring(value),
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			TextColor3 = theme.accent,
			TextXAlignment = Enum.TextXAlignment.Right,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 6),
			Size = UDim2.fromOffset(60, 20),
		}, r)

		local hit = new("Frame", {
			Active = true,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, 28),
			Size = UDim2.new(1, 0, 0, 24),
		}, r)
		local bar = new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 12, 0.5, 0),
			Size = UDim2.new(1, -24, 0, 6),
			BackgroundColor3 = theme.off,
			BorderSizePixel = 0,
		}, hit)
		corner(bar, 3)
		local fill = new("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = theme.accent,
			BorderSizePixel = 0,
		}, bar)
		corner(fill, 3)
		local knob = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = theme.white,
			BorderSizePixel = 0,
		}, bar)
		corner(knob, 7)

		local function setValue(v, silent)
			v = math.clamp(math.floor(v + 0.5), min, max)
			local changed = v ~= value
			value = v
			valueLabel.Text = tostring(v)
			local alpha = (v - min) / (max - min)
			fill.Size = UDim2.fromScale(alpha, 1)
			knob.Position = UDim2.fromScale(alpha, 0.5)
			if changed and not silent and callback then
				task.spawn(callback, v)
			end
			if changed and not silent and key then
				optionChanged()
			end
		end
		setValue(value, true)

		local dragging = false
		local function fromX(x)
			local w = bar.AbsoluteSize.X
			if w <= 0 then
				return
			end
			local alpha = math.clamp((x - bar.AbsolutePosition.X) / w, 0, 1)
			setValue(min + alpha * (max - min))
		end

		connect(hit.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				scroller.ScrollingEnabled = false
				fromX(input.Position.X)
				local c
				c = input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						scroller.ScrollingEnabled = true
						c:Disconnect()
					end
				end)
			end
		end)
		connect(UserInputService.InputChanged, function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				fromX(input.Position.X)
			end
		end)

		local comp = {
			Set = setValue,
			Get = function()
				return value
			end,
		}
		if key then
			registry[key] = comp
		end
		return comp
	end

