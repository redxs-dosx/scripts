local gui = new("ScreenGui", {
	Name = "Toolx",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 999,
})

local function mount()
	local candidates = {}
	if typeof(gethui) == "function" then
		table.insert(candidates, function()
			return gethui()
		end)
	end
	table.insert(candidates, function()
		return game:GetService("CoreGui")
	end)
	table.insert(candidates, function()
		return player:WaitForChild("PlayerGui")
	end)

	for _, get in ipairs(candidates) do
		local ok, parent = pcall(get)
		if ok and parent then
			pcall(function()
				local old = parent:FindFirstChild("Toolx")
				if old then
					old:Destroy()
				end
			end)
			local assigned = pcall(function()
				gui.Parent = parent
			end)
			if assigned and gui.Parent == parent then
				return true
			end
		end
	end
	return false
end

if not mount() then
	warn("[Toolx] could not find a place to mount the gui")
	return
end

