	local CONSENT_VERSION = 1 -- raise this number if the notice changes and should be shown again
	local CONSENT_FILE = SAVE_FOLDER .. "/consent.json"
	local canSave = fileSystemAvailable()

	local function alreadyAccepted()
		if not canSave then
			return false
		end
		local ok, accepted = pcall(function()
			if not isfile(CONSENT_FILE) then
				return false
			end
			local data = HttpService:JSONDecode(readfile(CONSENT_FILE))
			return typeof(data) == "table" and (tonumber(data.version) or 0) >= CONSENT_VERSION
		end)
		return ok and accepted == true
	end

	local function saveAccepted()
		if not canSave then
			return
		end
		pcall(function()
			if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(SAVE_FOLDER) then
