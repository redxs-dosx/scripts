		end

		local highlight = makeHighlighter()
		local overlay = new("TextLabel", {
			Name = "Syntax",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			RichText = true,
			Font = EDITOR_FONT,
			TextSize = EDITOR_SIZE,
			TextWrapped = true,
			TextColor3 = theme.text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Active = false,
			ZIndex = 3,
		}, codeBox)

		local MAX_HIGHLIGHT = 20000 -- past this the rich text gets slow, so show plain text instead
		local function refreshHighlight()
			local src = codeBox.Text
			if src == "" or #src > MAX_HIGHLIGHT then
				overlay.Text = ""
				codeBox.TextTransparency = 0
				return
			end
			local ok, rich = pcall(highlight, src)
			if ok and type(rich) == "string" then
				overlay.Text = rich
				codeBox.TextTransparency = 1
			else
				overlay.Text = ""
				codeBox.TextTransparency = 0
			end
		end

		-----------------------------------------------------------------
		-- Scrolling: canvas height follows the text, the scrollbar is thicker,
		-- touch-drag scrolls the editor, and typing keeps the cursor in view.
		-----------------------------------------------------------------
		local function relayout()
			local viewH = editor.AbsoluteWindowSize.Y
			local h = math.max(viewH, codeBox.TextBounds.Y + PAD_Y * 2 + 24)
			codeBox.Size = UDim2.new(1, 0, 0, h)
			editor.CanvasSize = UDim2.fromOffset(0, h)
		end

		local function maxScroll()
			return math.max(0, editor.CanvasSize.Y.Offset - editor.AbsoluteWindowSize.Y)
		end

		local function scrollTo(y)
			editor.CanvasPosition = Vector2.new(0, math.clamp(y, 0, maxScroll()))
		end

		local function followCursor()
			if not codeBox:IsFocused() then
				return
			end
			local text = codeBox.Text
			local cursor = codeBox.CursorPosition
			if cursor < 1 or #text > 30000 then
				return
			end
			local ok, size = pcall(function()
				return TextService:GetTextSize(string.sub(text, 1, cursor - 1) .. "x", EDITOR_SIZE, EDITOR_FONT, Vector2.new(math.max(codeBox.AbsoluteSize.X - PAD_X * 2, 20), 100000))
			end)
			if not ok then
				return
			end
			local lineBottom = size.Y + PAD_Y
			local lineTop = lineBottom - EDITOR_SIZE - 4
			local viewH = editor.AbsoluteWindowSize.Y
			local top = editor.CanvasPosition.Y
			if lineBottom > top + viewH - 4 then
				scrollTo(lineBottom - viewH + 8)
			elseif lineTop < top then
				scrollTo(lineTop - 4)
			end
