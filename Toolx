-- Scanner tab
---------------------------------------------------------------------
local scannerTab = addTab("Scanner")

scannerTab:Section("Backdoor Scanner")
scannerTab:Label("Scans ReplicatedStorage and Workspace for responsive remotes. Tap any discovered remote to fire it.")

local scanResultsBox = scannerTab:LogBox(140, 40, "No scan performed yet")

scannerTab:Button("Run Scan", function(lbl)
	lbl.Text = "Scanning..."
	scanResultsBox.Clear()
	
	task.spawn(function()
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local Workspace = game:GetService("Workspace")
		local payloads = {
			"print('Toolx Backdoor Scan Active')",
			"game:GetService('HttpService')",
		}
		
		local count = 0
		local containers = { ReplicatedStorage, Workspace }
		
		for _, container in ipairs(containers) do
			for _, descendant in ipairs(container:GetDescendants()) do
				if descendant:IsA("RemoteEvent") or descendant:IsA("RemoteFunction") then
					for _, payload in ipairs(payloads) do
						local ok = pcall(function()
							if descendant:IsA("RemoteEvent") then
								descendant:FireServer(payload)
							elseif descendant:IsA("RemoteFunction") then
								descendant:InvokeServer(payload)
							end
						end)
						if ok then
							count += 1
							local remoteObj = descendant
							scanResultsBox.Add(
								string.format('<font color="#4cc978">%s</font> (%s)', escapeRich(remoteObj.Name), escapeRich(remoteObj.ClassName)),
								function()
									local fireOk = pcall(function()
										if remoteObj:IsA("RemoteEvent") then
											remoteObj:FireServer("Toolx Manual Fire")
										elseif remoteObj:IsA("RemoteFunction") then
											remoteObj:InvokeServer("Toolx Manual Fire")
										end
									end)
									if fireOk then
										notify("Successfully fired: " + remoteObj.Name, "success")
										return "Fired!"
									else
										notify("Failed to fire: " + remoteObj.Name, "error")
										return "Error"
									end
								end
							)
							break
						end
					end
				end
			end
		end
		
		lbl.Text = "Run Scan"
		notify(string.format("Scan complete: found %d responsive remotes", count), "success")
	end)
end)

scannerTab:Section("Remote Spy")
scannerTab:Label("Monitors and logs all client-to-server FireServer and InvokeServer calls in real time.")

local remoteSpyBox = scannerTab:LogBox(140, 50, "Remote spy is off")
local originalNamecall
local spyEnabled = false

scannerTab:Toggle("Enable Remote Spy", false, function(state)
	spyEnabled = state
	if state then
		if typeof(hookmetamethod) ~= "function" or typeof(getnamecallmethod) ~= "function" then
			notify("Remote spy requires hookmetamethod", "error")
			return
		end
		if not originalNamecall then
			local ok = pcall(function()
				originalNamecall = hookmetamethod(game, "__namecall", function(self, ...)
					if spyEnabled and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
						local method = getnamecallmethod()
						if method == "FireServer" or method == "InvokeServer" then
							local args = {...}
							local argStrs = {}
							for _, arg in ipairs(args) do
								table.insert(argStrs, tostring(arg))
							end
							local timeStr = os.date("%H:%M:%S")
							remoteSpyBox.Add(string.format(
								'<font color="#9090a6">[%s]</font> <font color="#6c80ff">%s</font> (%s) -> %s',
								timeStr,
								escapeRich(self.Name),
								method,
								escapeRich(table.concat(argStrs, ", "))
							))
						end
					end
					return originalNamecall(self, ...)
				end)
			end)
			if not ok then
				notify("Failed to hook metamethod for spy", "error")
			end
		end
		notify("Remote spy enabled", "success")
	else
		notify("Remote spy disabled", "info")
	end
end, "scanner.remotespy")

scannerTab:Button("Clear Spy Logs", function(lbl)
	remoteSpyBox.Clear()
	flashLabel(lbl, "Cleared")
end)
