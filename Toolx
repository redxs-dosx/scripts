	-- Module tab ------------------------------------------------------
	-- Every module for this game is run as  fn(Tab, Toolx, info)  and builds its UI straight into this tab.
	local moduleHeader = moduleTab:Section("Module")
	local moduleNote = moduleTab:Label("")
	local reloadModule -- forward declaration
	moduleTab:Button("Reload module", function()
		reloadModule()
	end)

	local moduleScroller = moduleTab.page:FindFirstChildOfClass("ScrollingFrame")
	local moduleBase = {} -- everything in the tab before a module ran, so a reload can clear the rest
	for _, c in ipairs(moduleScroller:GetChildren()) do
		moduleBase[c] = true
	end
	local moduleUnloaders = {}
	local baseKeys -- option keys that existed before the module ran
	local moduleRun = 0
	local lastModuleKey

	-- Tab:OnUnload(fn) lets a module stop its loops / connections when it is reloaded or Toolx closes
	function moduleTab.OnUnload(_, fn)
		if typeof(fn) == "function" then
			table.insert(moduleUnloaders, fn)
		end
	end

	local function unloadModule()
		moduleRun += 1
		for i = #moduleUnloaders, 1, -1 do
			pcall(moduleUnloaders[i])
		end
		table.clear(moduleUnloaders)
		for _, c in ipairs(moduleScroller:GetChildren()) do
			if not moduleBase[c] then
				c:Destroy()
			end
		end
		if baseKeys then
			-- remember the module's option values so they come back next time
			for key, comp in pairs(registry) do
				if not baseKeys[key] then
					pcall(function()
						savedData.options[key] = comp.Get()
					end)
					registry[key] = nil
				end
			end
			baseKeys = nil
		end
	end
	Modules.Unload = unloadModule

	local function showModuleError(item, text)
		warn("[Toolx] module " .. item.title .. ": " .. text)
		notify("Module " .. item.title .. " failed (see console)", "error")
		moduleTab:Label("Module " .. item.title .. " failed: " .. text)
	end

	local function loadModule(items)
		unloadModule()
		local run = moduleRun
		baseKeys = {}
		for key in pairs(registry) do
			baseKeys[key] = true
		end
		task.spawn(function()
			local waited = 0
			while not Toolx and waited < 10 do
				task.wait(0.1)
				waited += 0.1
			end
			for _, item in ipairs(items) do
				if run ~= moduleRun or not gui.Parent then
					return
				end
				if typeof(loadstring) ~= "function" then
					moduleTab:Label("Your executor can't run modules (no loadstring).")
					return
				end
				LoadLogger.ignore = true -- modules aren't logged, same as scripts run from the browser
				local fn, err = loadstring(item.source)
				LoadLogger.ignore = false
				if not fn then
					showModuleError(item, tostring(err))
				else
					local ok, runErr = pcall(fn, moduleTab, Toolx, {
						title = item.title,
						path = item.path,
						gameId = tostring(game.GameId),
						placeId = tostring(game.PlaceId),
					})
					if not ok and run == moduleRun then
						showModuleError(item, tostring(runErr))
					end
				end
			end
		end)
	end

	-- Shows the Module tab (named after the game) and builds the module(s) when this game has one,
	-- hides the tab otherwise
	function updateModuleTab(force)
		local items = Modules.ForCurrentGame()
		if #items == 0 then
			if lastModuleKey then
				unloadModule()
			end
			lastModuleKey = nil
			setTabHidden(moduleTab, true)
			return
		end
		local name = Modules.CurrentName()
		setTabName(moduleTab, name)
		moduleHeader.Text = string.upper(name)
		local key = ""
		for _, item in ipairs(items) do
			key ..= item.path .. "|"
		end
		if force or key ~= lastModuleKey then
			lastModuleKey = key
			moduleNote.Text = "Official module" .. (#items == 1 and "" or "s") .. " for this game, loaded from the modules repo."
			loadModule(items)
		end
		setTabHidden(moduleTab, false)
	end

	function reloadModule()
		task.spawn(function()
			local _, err = Modules.Load(true)
			pcall(Modules.Resolve)
			if not gui.Parent then
				return
			end
			updateModuleTab(true)
			if err then
				notify("Couldn't re-download, reloaded the saved copy", "warn")
			else
				notify("Module reloaded", "success")
			end
		end)
	end

	-- Check the repo in the background as soon as Toolx opens
	task.spawn(function()
		pcall(Modules.Load)
		if gui.Parent then
			updateModuleTab() -- ids that match this game directly show up straight away
		end
	end)
	loadGames(false)
end

