---------------------------------------------------------------------
-- Coordinates: live position, teleport to coordinates, preset / auto / custom maps
---------------------------------------------------------------------
local positionText, worldPosRow, settingsPosRow
do
	-- Built-in presets. Add a game by PlaceId or GameId (Settings > Info shows both):
	-- { name = "Game", ids = { 1234567890 }, maps = { { name = "Map", locs = { { "Spot", x, y, z } } } } }
	local GAME_PRESETS = {}

	local MAPS_FILE = SAVE_FOLDER .. "/maps.json"
	local gameKey = game.GameId
	local customMaps = {} -- every custom map on disk, all games: { name, gameId, locs = { { name, x, y, z } } }
	local autoMaps = {} -- found by scanning this server: Spawns, Landmarks

	local function getRoot()
		local char = player.Character
		return char and char:FindFirstChild("HumanoidRootPart")
	end

	function positionText()
		local root = getRoot()
		if not root then
			return "N/A"
		end
		local p = root.Position
		return string.format("%.1f, %.1f, %.1f", p.X, p.Y, p.Z)
	end

	-- Read the first three numbers out of text like "10, 50.5, -300" or "(10 50 -300)"
	local function parseCoords(text)
		local nums = {}
		for n in string.gmatch(text or "", "-?%d+%.?%d*") do
			table.insert(nums, tonumber(n))
		end
		if #nums >= 3 and nums[1] and nums[2] and nums[3] then
			return nums[1], nums[2], nums[3]
		end
		return nil
	end

	-- Custom maps are kept in their own file so they survive even when "Keep options" is off
	if fileSystemAvailable() then
		pcall(function()
			if not isfile(MAPS_FILE) then
				return
			end
			local data = HttpService:JSONDecode(readfile(MAPS_FILE))
			if typeof(data) ~= "table" or typeof(data.maps) ~= "table" then
				return
			end
			for _, m in ipairs(data.maps) do
				if typeof(m) == "table" and typeof(m.name) == "string" and typeof(m.locs) == "table" then
					local map = { name = m.name, gameId = tonumber(m.gameId) or 0, kind = "custom", locs = {} }
					for _, l in ipairs(m.locs) do
						if typeof(l) == "table" and typeof(l.name) == "string" and tonumber(l.x) and tonumber(l.y) and tonumber(l.z) then
							table.insert(map.locs, { name = l.name, x = tonumber(l.x), y = tonumber(l.y), z = tonumber(l.z) })
						end
					end
					table.insert(customMaps, map)
				end
			end
		end)
	end

	local function saveMaps()
		if not fileSystemAvailable() then
			return false
		end
		local out = {}
		for _, m in ipairs(customMaps) do
			table.insert(out, { name = m.name, gameId = m.gameId, locs = m.locs })
		end
		pcall(function()
			if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(SAVE_FOLDER) then
				makefolder(SAVE_FOLDER)
			end
		end)
		return (pcall(function()
			writefile(MAPS_FILE, HttpService:JSONEncode({ maps = out }))
		end))
	end

	-- Every map to show for this game: presets, then scanned, then your own
	local function allMaps()
		local list = {}
		for _, g in ipairs(GAME_PRESETS) do
			local match = false
			for _, id in ipairs(g.ids or {}) do
				if id == game.PlaceId or id == game.GameId then
					match = true
				end
			end
			if match then
				for _, m in ipairs(g.maps or {}) do
					local map = { name = m.name, kind = "preset", locs = {} }
					for _, l in ipairs(m.locs or {}) do
						table.insert(map.locs, { name = l[1], x = l[2], y = l[3], z = l[4] })
					end
					table.insert(list, map)
				end
			end
		end
		for _, m in ipairs(autoMaps) do
			table.insert(list, m)
		end
		for _, m in ipairs(customMaps) do
			if m.gameId == gameKey then
				table.insert(list, m)
			end
		end
		return list
	end

	-- Scan the workspace for spawn pads and big top-level models
	local function scanWorld()
		local spawns = { name = "Spawns (scanned)", kind = "auto", locs = {} }
		local landmarks = { name = "Landmarks (scanned)", kind = "auto", locs = {} }
		local used = {}
		local function uniqueName(base)
			used[base] = (used[base] or 0) + 1
			return used[base] == 1 and base or (base .. " " .. used[base])
		end

		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("SpawnLocation") and #spawns.locs < 40 then
				local p = d.Position + Vector3.new(0, d.Size.Y / 2 + 3, 0)
				local label = d.Name
				if d.Neutral == false and d.TeamColor then
					label = label .. " (" .. tostring(d.TeamColor) .. ")"
				end
				table.insert(spawns.locs, { name = uniqueName(label), x = p.X, y = p.Y, z = p.Z })
			end
		end

		local found = {}
		for _, child in ipairs(workspace:GetChildren()) do
			if child:IsA("Model") and not Players:GetPlayerFromCharacter(child) and not child:FindFirstChildOfClass("Humanoid") then
				local ok, cf, size = pcall(function()
					return child:GetBoundingBox()
				end)
				if ok and cf and size then
					table.insert(found, { name = child.Name, pos = cf.Position + Vector3.new(0, size.Y / 2 + 4, 0), vol = size.X * size.Y * size.Z })
				end
			end
		end
		table.sort(found, function(a, b)
			return a.vol > b.vol
		end)
		for i = 1, math.min(#found, 40) do
			local f = found[i]
			table.insert(landmarks.locs, { name = uniqueName(f.name), x = f.pos.X, y = f.pos.Y, z = f.pos.Z })
		end

		autoMaps = {}
		if #spawns.locs > 0 then
			table.insert(autoMaps, spawns)
		end
		if #landmarks.locs > 0 then
			table.insert(autoMaps, landmarks)
		end
		return #spawns.locs, #landmarks.locs
	end

	-----------------------------------------------------------------
	-- UI
	-----------------------------------------------------------------
	worldTab:Section("Coordinates")
	local coordBox
	worldPosRow = worldTab:InfoRow("Your position", positionText(), function(shown)
		if shown ~= "N/A" and coordBox then
			coordBox.Set(shown)
		end
		return copyToClipboard(shown) and "Copied!" or "Filled in below"
	end)
	coordBox = worldTab:TextInput("X, Y, Z", "e.g. 0, 50, 0")
	worldTab:Button("Teleport to coordinates", function()
		local x, y, z = parseCoords(coordBox.Get())
		if not x then
			notify("Type three numbers, like 0, 50, 0", "warn")
			return
		end
		if Teleport.ToPosition(Vector3.new(x, y, z)) then
			notify(string.format("Teleported to %.0f, %.0f, %.0f", x, y, z), "success")
		else
			notify("Your character isn't loaded", "error")
		end
	end)
	worldTab:Label("Tap Your position to copy it and fill the box. Coordinates also show in Settings > Info.")

	worldTab:Section("Maps")
	local mapNote = worldTab:Label("Tap a map, then a location. Preset and scanned maps are read-only: duplicate one to edit it.")
	local mapsBox = worldTab:LogBox(96, 60, "No maps yet")
	local locsBox = worldTab:LogBox(150, 120, "Select a map above")

	local selectedMap, selectedLoc
	local refreshMaps

	local function kindTag(kind)
		if kind == "preset" then
			return ' <font color="' .. accentHex() .. '">[preset]</font>'
		elseif kind == "auto" then
			return ' <font color="#f2b23c">[scanned]</font>'
		end
		return ' <font color="#9090a6">[yours]</font>'
	end

	local function refreshLocs()
		locsBox.Clear()
		if not selectedMap then
			return
		end
		for _, loc in ipairs(selectedMap.locs) do
			local base = escapeRich(loc.name) .. ' <font color="#9090a6">' .. string.format("%.0f, %.0f, %.0f", loc.x, loc.y, loc.z) .. "</font>"
			local label
			label = locsBox.Add(base, function()
				selectedLoc = (selectedLoc == loc) and nil or loc
				refreshLocs()
			end)
			if selectedLoc == loc then
				label.Text = '<font color="' .. accentHex() .. '"><b>\u{25B6}</b></font> <b>' .. escapeRich(loc.name) .. "</b>" .. ' <font color="#9090a6">' .. string.format("%.0f, %.0f, %.0f", loc.x, loc.y, loc.z) .. "</font>"
			end
		end
	end

	function refreshMaps()
		local list = allMaps()
		-- keep the selection only if that map still exists
		local still = false
		for _, m in ipairs(list) do
			if m == selectedMap then
				still = true
			end
		end
		if not still then
			selectedMap, selectedLoc = nil, nil
		end
		mapsBox.Clear()
		for _, m in ipairs(list) do
