	    local lastBeat, lastPoll = -1e9, -1e9
	    while gui.Parent and P.running do
	      local now = os.clock()
	      if P.share and (P.beatNow or now - lastBeat >= PRESENCE.beat) then
	        P.beatNow, lastBeat = false, now
	        if not pcall(beat) then
	          P.beatOk, P.errs.beat = false, "Updating your entry failed."
