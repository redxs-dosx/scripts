-- Chat logger: "[HH:MM:SS] username: message"
---------------------------------------------------------------------
local ChatLog = { entries = {} }
do
	local MAX_ENTRIES = 500
	local conns = {}
	local playerConns = {}

	local function add(name, text)
		local entry = { time = os.date("%H:%M:%S"), name = name, text = text }
		table.insert(ChatLog.entries, entry)
		if #ChatLog.entries > MAX_ENTRIES then
			table.remove(ChatLog.entries, 1)
		end
		if ChatLog.OnMessage then
			pcall(ChatLog.OnMessage, entry)
		end
	end

	function ChatLog.Format(entry)
		return string.format("[%s] %s: %s", entry.time, entry.name, entry.text)
	end

	function ChatLog.GetText()
		local lines = {}
		for _, entry in ipairs(ChatLog.entries) do
			table.insert(lines, ChatLog.Format(entry))
		end
		return table.concat(lines, "\n")
	end

	function ChatLog.Clear()
		table.clear(ChatLog.entries)
	end

	function ChatLog.Stop()
		for _, c in ipairs(conns) do
			c:Disconnect()
		end
		table.clear(conns)
		for _, c in pairs(playerConns) do
			c:Disconnect()
		end
		table.clear(playerConns)
	end

	-- TextChatService hands the text over with rich text characters escaped
	local function unescape(s)
		s = s:gsub("&lt;", "<")
		s = s:gsub("&gt;", ">")
		s = s:gsub("&quot;", '"')
		s = s:gsub("&apos;", "'")
		s = s:gsub("&amp;", "&")
		return s
	end

	local TextChatService
	local usingTextChat = false
	pcall(function()
		TextChatService = game:GetService("TextChatService")
		usingTextChat = TextChatService.ChatVersion == Enum.ChatVersion.TextChatService
	end)

	if usingTextChat then
		table.insert(conns, TextChatService.MessageReceived:Connect(function(message)
			local source = message.TextSource
			if not source then
				return -- system message, nobody said it
			end
			local sender = Players:GetPlayerByUserId(source.UserId)
			add(sender and sender.Name or ("User " .. source.UserId), unescape(message.Text))
		end))
	else
		-- legacy chat
		local function hook(p)
			if playerConns[p] then
				return
			end
			playerConns[p] = p.Chatted:Connect(function(msg)
				add(p.Name, msg)
			end)
		end
		for _, p in ipairs(Players:GetPlayers()) do
			hook(p)
		end
		table.insert(conns, Players.PlayerAdded:Connect(hook))
		table.insert(conns, Players.PlayerRemoving:Connect(function(p)
			if playerConns[p] then
				playerConns[p]:Disconnect()
				playerConns[p] = nil
			end
		end))
	end
end

---------------------------------------------------------------------
-- Loadlogger: records scripts that get run through loadstring while it is on
---------------------------------------------------------------------
local LoadLogger = { entries = {}, hooks = {}, ignore = false }
do
	local MAX_ENTRIES = 30
	local enabled = false
	local original, wrapper
	local fetched, fetchedOrder = {}, {}
	local httpHookTried = false

	local function getEnv()
		local ok, env = pcall(function()
			return getgenv()
		end)
		if ok and typeof(env) == "table" then
			return env
		end
		return nil
	end

	local function remember(body, url)
		if fetched[body] == nil then
			table.insert(fetchedOrder, body)
			if #fetchedOrder > 10 then
				fetched[table.remove(fetchedOrder, 1)] = nil
			end
		end
		fetched[body] = url
	end

	-- Remember which URL a downloaded script came from, so the log can copy the one-liner.
	-- Executors wire up game:HttpGet differently, so try every route we can.
	local function tryHook(label, install)
		if pcall(install) then
			table.insert(LoadLogger.hooks, label)
		end
	end

	local function hookHttpGet()
		if httpHookTried then
			return
		end
		httpHookTried = true

		-- route 1: replace the HttpGet / HttpGetAsync functions themselves
		for _, name in ipairs({ "HttpGet", "HttpGetAsync" }) do
			tryHook(name, function()
				if typeof(hookfunction) ~= "function" then
					error("hookfunction unavailable")
				end
				local target = game[name]
				if typeof(target) ~= "function" then
					error("not a function")
				end
				local old
				local function replacement(self, url, ...)
					local result = old(self, url, ...)
					if enabled and typeof(result) == "string" and typeof(url) == "string" then
						pcall(remember, result, url)
					end
					return result
				end
				if typeof(newcclosure) == "function" then
					replacement = newcclosure(replacement)
				end
				old = hookfunction(target, replacement)
			end)
		end

		-- route 2: catch the method call itself (for executors that resolve HttpGet through __namecall)
		tryHook("namecall", function()
			if typeof(hookmetamethod) ~= "function" or typeof(getnamecallmethod) ~= "function" then
				error("hookmetamethod unavailable")
			end
			local old
			local function handler(self, ...)
				local method = getnamecallmethod()
				if enabled and (method == "HttpGet" or method == "HttpGetAsync") and self == game then
					local url = ...
					local result = old(self, ...)
					if typeof(result) == "string" and typeof(url) == "string" then
						pcall(remember, result, url)
					end
					return result
				end
				return old(self, ...)
			end
			if typeof(newcclosure) == "function" then
				handler = newcclosure(handler)
			end
			old = hookmetamethod(game, "__namecall", handler)
		end)
	end

	local function record(source)
		local url = fetched[source]
		local preview = ""
		for line in source:sub(1, 2000):gmatch("[^\r\n]+") do
			if line:find("%S") then
				preview = line:match("^%s*(.-)%s*$")
				break
			end
		end
		if #preview > 70 then
			preview = preview:sub(1, 70) .. "..."
		end
		local entry = {
			time = os.date("%H:%M:%S"),
			url = url,
			preview = preview,
			size = #source,
			-- tapping a log line copies this
			copy = url and string.format('loadstring(game:HttpGet("%s"))()', url) or source,
		}
		table.insert(LoadLogger.entries, entry)
		if #LoadLogger.entries > MAX_ENTRIES then
			table.remove(LoadLogger.entries, 1)
		end
		if LoadLogger.OnEntry then
			pcall(LoadLogger.OnEntry, entry)
		end
	end

	function LoadLogger.Start()
		if enabled then
			return true
		end
		local env = getEnv()
		if not env or typeof(env.loadstring) ~= "function" then
			warn("[Toolx] Loadlogger can't find loadstring")
			return false
		end
		if env.loadstring ~= wrapper then
			original = env.loadstring
		end
		wrapper = wrapper or function(source, ...)
			if enabled and not LoadLogger.ignore and typeof(source) == "string" then
				pcall(record, source)
			end
			return original(source, ...)
		end
		local ok = pcall(function()
			env.loadstring = wrapper
		end)
		if not ok then
			warn("[Toolx] Loadlogger couldn't hook loadstring")
			return false
		end
		enabled = true
		hookHttpGet()
		return true
	end

	function LoadLogger.Stop()
		enabled = false
		local env = getEnv()
		if env and wrapper and env.loadstring == wrapper then
			pcall(function()
				env.loadstring = original
			end)
		end
	end

	function LoadLogger.Clear()
		table.clear(LoadLogger.entries)
	end

	function LoadLogger.IsEnabled()
		return enabled
	end
end

