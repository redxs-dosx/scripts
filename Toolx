---------------------------------------------------------------------
-- Saved options ("Keep options" setting)
---------------------------------------------------------------------
local SAVE_FOLDER = "Toolx"
local SAVE_FILE = "Toolx/options.json"

local registry = {} -- option key -> component (Get / Set)
local savedData = { keep = false, options = {} } -- what was on disk when the script started
local keepEnabled = false
local loadingOptions = false
local saveToken = 0

local function fileSystemAvailable()
	return typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
end

local function writeSaveFile(data)
	if not fileSystemAvailable() then
		return false
	end
	pcall(function()
		if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(SAVE_FOLDER) then
			makefolder(SAVE_FOLDER)
		end
	end)
	return (pcall(function()
		writefile(SAVE_FILE, HttpService:JSONEncode(data))
	end))
end

local function saveOptions()
	if not keepEnabled then
		return
	end
	local options = {}
	-- options that aren't on screen right now (a module of another game) stay on disk
	for key, value in pairs(savedData.options) do
		if registry[key] == nil then
			options[key] = value
		end
	end
	for key, comp in pairs(registry) do
		options[key] = comp.Get()
	end
	writeSaveFile({ keep = true, options = options })
end

-- Turning "Keep options" off wipes the stored options so the next run starts on defaults
local function clearSavedOptions()
	writeSaveFile({ keep = false, options = {} })
end

-- Called whenever the user changes an option; writes are batched so dragging a slider doesn't spam the disk
local function optionChanged()
	if loadingOptions or not keepEnabled then
		return
	end
	saveToken += 1
	local id = saveToken
	task.delay(0.4, function()
		if id == saveToken then
			saveOptions()
		end
	end)
end

if fileSystemAvailable() then
	local ok, raw = pcall(function()
		if isfile(SAVE_FILE) then
			return readfile(SAVE_FILE)
		end
		return nil
	end)
	if ok and raw then
		local okDecode, data = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if okDecode and typeof(data) == "table" then
			savedData.keep = data.keep == true
			if typeof(data.options) == "table" then
				savedData.options = data.options
			end
		end
	end
end
keepEnabled = savedData.keep and fileSystemAvailable()

