	-- Segmented picker: one button per option, callback(name) fires when the choice changes
	function api:Choice(text, options, default, callback, key)
		local r = row(66)
		new("TextLabel", {
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = theme.text,
			TextXAlignment = Enum.TextXAlignment.Left,
