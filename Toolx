		end)
		connect(UserInputService.InputEnded, function(input)
			if input == dragInput then
				dragInput = nil
			end
		end)

		connect(codeBox:GetPropertyChangedSignal("Text"), function()
			refreshHighlight()
			relayout()
			task.defer(function()
				relayout()
				followCursor()
			end)
		end)
		connect(codeBox:GetPropertyChangedSignal("CursorPosition"), followCursor)
		connect(codeBox:GetPropertyChangedSignal("TextBounds"), relayout)
		connect(editor:GetPropertyChangedSignal("AbsoluteSize"), relayout)

		refreshHighlight()
		relayout()
		task.defer(relayout)
	end)()

	-----------------------------------------------------------------
	-- Buttons: Execute, Clear, Paste, Copy, Scan
	-----------------------------------------------------------------
	local buttonRow = executeTab:Container(34)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, buttonRow)

	local function makeButton(text, order, primary, callback)
		local b = new("TextButton", {
			Text = text,
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextScaled = true,
			TextColor3 = theme.text,
			AutoButtonColor = false,
			BackgroundColor3 = primary and theme.accent or theme.surface,
			BackgroundTransparency = primary and 0.1 or 0.35,
			BorderSizePixel = 0,
			Size = UDim2.new(0.2, -4, 1, 0),
			LayoutOrder = order,
		}, buttonRow)
		corner(b, 8)
		stroke(b, 0.94)
		new("UITextSizeConstraint", { MaxTextSize = 12, MinTextSize = 8 }, b)
		new("UIPadding", { PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3) }, b)
		local base = primary and 0.1 or 0.35
		connect(b.MouseEnter, function()
			tween(b, 0.15, { BackgroundTransparency = math.max(base - 0.2, 0) })
		end)
		connect(b.MouseLeave, function()
			tween(b, 0.15, { BackgroundTransparency = base })
		end)
		connect(b.Activated, function()
			task.spawn(callback)
		end)
		return b
	end

	executeTab:Section("Result")
	local resultLabel = executeTab:Label("Nothing yet. Tap Scan to check a script before you run it.")
	resultLabel.RichText = true
	local function setResult(text)
		resultLabel.Text = text
		resultLabel.TextColor3 = theme.text
	end

	local function runCode(source)
		if typeof(loadstring) ~= "function" then
			notify("Your executor has no loadstring", "error")
			return
		end
		local fn, err = loadstring(source)
		if not fn then
			setResult('<font color="' .. hexOf(theme.red) .. '"><b>Syntax error</b></font>\n' .. escapeRich(tostring(err)))
			notify("Syntax error. See the Execute tab.", "error", 3)
			return
		end
		setResult("Script is running.")
		notify("Running script", "success")
		task.spawn(function()
			local ok, runErr = pcall(fn)
			if not ok then
				warn("[Toolx] Execute errored: " .. tostring(runErr))
				setResult('<font color="' .. hexOf(theme.red) .. '"><b>Script errored</b></font>\n' .. escapeRich(tostring(runErr)))
				notify("Script errored (see console)", "error", 3)
			end
		end)
	end

	local pendingUntil = 0
	local executeBtn
	local function resetExecute()
		pendingUntil = 0
		if executeBtn then
			executeBtn.Text = "Execute"
		end
	end

	executeBtn = makeButton("Execute", 1, true, function()
		local source = codeBox.Text
		if string.match(source, "^%s*$") then
			notify("Nothing to run", "warn")
			return
		end
		local report, high = describe(source)
		if high > 0 and os.clock() > pendingUntil then
			-- dangerous findings: show them and ask for a second tap
			setResult(report)
			pendingUntil = os.clock() + 8
			executeBtn.Text = "Run anyway?"
			notify("Dangerous findings. Tap again to run anyway.", "error", 4)
			task.delay(8, function()
				if executeBtn.Parent and os.clock() >= pendingUntil then
					executeBtn.Text = "Execute"
				end
			end)
			return
		end
		resetExecute()
		runCode(source)
	end)

	makeButton("Clear", 2, false, function()
		codeBox.Text = ""
		setResult("Cleared.")
		resetExecute()
	end)

	makeButton("Paste", 3, false, function()
		local reader = (typeof(getclipboard) == "function" and getclipboard)
			or (typeof(fromclipboard) == "function" and fromclipboard)
			or (typeof(readclipboard) == "function" and readclipboard)
		if not reader then
			notify("Your executor can't read the clipboard. Long-press the box to paste.", "warn", 4)
			return
		end
		local ok, clip = pcall(reader)
		if not ok or typeof(clip) ~= "string" or clip == "" then
			notify("Clipboard is empty", "warn")
			return
		end
		local current = codeBox.Text
		if current ~= "" and string.sub(current, -1) ~= "\n" then
			current ..= "\n"
		end
		codeBox.Text = current .. clip
		notify("Pasted", "success")
	end)

	makeButton("Copy", 4, false, function()
		if codeBox.Text == "" then
			notify("Nothing to copy", "warn")
			return
		end
		if copyToClipboard(codeBox.Text) then
			notify("Copied", "success")
		else
			notify("Your executor can't set the clipboard", "error")
		end
	end)

	makeButton("Scan", 5, false, function()
		local source = codeBox.Text
		if string.match(source, "^%s*$") then
			notify("Nothing to scan", "warn")
			return
		end
		local report, _, verdict, kind = describe(source)
		setResult(report)
		notify("Scan: " .. verdict, kind, 3)
	end)

	connect(codeBox:GetPropertyChangedSignal("Text"), resetExecute)

	executeTab:Label("Paste adds the clipboard to the end of your script. Execute scans first and asks you to tap again if it finds something dangerous.")
end

