	-- Loading
	-----------------------------------------------------------------
	function load(query)
		requestId += 1
		local id = requestId
		local searching = query ~= nil and query ~= ""
		local currentMode = mode

		sectionLabel.Text = string.upper(
			(searching and ('Results for "' .. query .. '"') or ((currentMode == "Scripts" and provider == "xScripts") and "All scripts" or ("Trending " .. string.lower(currentMode))))
				.. (currentMode == "Scripts" and (" - " .. provider) or "")
		)
		if currentMode == "Games" and FS.sort == "Supported only" and not searching then
			sectionLabel.Text = "SUPPORTED GAMES"
		end
		clearResults()
		showMessage("Loading...")

		task.spawn(function()
			local ok, items, err = pcall(function()
				if currentMode == "Scripts" then
					local flt, filterErr = FS.collect()
					if not flt then
						return nil, filterErr
					end
					return FS.fetch(searching and query or nil, flt)
				end
				local sort = FS.sort
				if sort == "Supported only" then
					return Modules.SupportedGames(searching and query or nil)
				end
				local list, gamesErr
				if searching then
					list, gamesErr = searchGames(query)
				else
					list, gamesErr = trendingGames()
				end
				if list and sort == "Supported first" then
					Modules.Load()
					list = Modules.SortSupported(list)
				end
				return list, gamesErr
			end)
			if id ~= requestId or not gui.Parent then
				return -- a newer request replaced this one
			end
			clearResults()
			if not ok then
				showMessage("Something went wrong while loading. Tap Search to try again.")
				return
			end
			if not items then
				showMessage((err or "Nothing to show.") .. " Tap Search to try again.")
				return
			end
			if currentMode == "Scripts" then
				renderScripts(items)
			else
				renderGames(items)
			end
		end)
	end

