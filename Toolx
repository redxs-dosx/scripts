-- Pulls "98% (204/208)" out of a test's summary line
local function parseSummary(message)
	local pct, passed, total = message:match("(%d+)%s*%%[^\n]-%((%d+)%s+out of%s+(%d+)%)")
	if not pct then
		pct, passed, total = message:match("(%d+)%s*%%[^\n]-%((%d+)%s*/%s*(%d+)%)")
	end
	if pct then
		return string.format("%s%% (%s/%s)", pct, passed, total)
	end
	if message:lower():find("success rate", 1, true) then
		local p = message:match("(%d+)%s*%%")
		if p then
			return p .. "%"
		end
	end
	return nil
end

-- Runs the UNC / sUNC test script and reads its result out of the console output
local compatRunning = {}
local function runCompat(name, url, target)
	if compatRunning[name] then
		return
	end
	if typeof(loadstring) ~= "function" then
		target.Set("No loadstring")
		return
	end
	compatRunning[name] = true
	target.Set("Running...")

	local result
	local conn = LogService.MessageOut:Connect(function(message)
		if not result then
			result = parseSummary(message)
		end
	end)

	task.spawn(function()
		local function finish(text)
			conn:Disconnect()
			compatRunning[name] = nil
			target.Set(text)
		end

		local source = fetchUrl(url)
		if not source then
			finish("Download failed")
			return
		end

		LoadLogger.ignore = true
		local fn, err = loadstring(source)
		LoadLogger.ignore = false
		if not fn then
			warn("[Toolx] " .. name .. " test failed to compile: " .. tostring(err))
			finish("Failed to load")
			return
		end

		local ok, runErr = pcall(fn)
		if not ok then
			warn("[Toolx] " .. name .. " test errored: " .. tostring(runErr))
			if not result then
				finish("Errored")
				return
			end
		end

		-- the test keeps printing for a while, wait for its summary line
		local waited = 0
		while not result and waited < 120 do
			task.wait(0.5)
			waited += 0.5
		end
		finish(result or "Done, see console")
	end)
end

