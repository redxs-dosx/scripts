	-----------------------------------------------------------------
	-- Players online (Firebase Realtime Database, anonymous auth)
	-- Setup: fill in PRESENCE.url and PRESENCE.apiKey (see firebase-rules.json)
	-----------------------------------------------------------------
	local PRESENCE = {
	  url = "https://toolx-277de-default-rtdb.firebaseio.com", -- Realtime Database URL, no trailing slash
	  apiKey = "AIzaSyD3LVSKlH0jSffSGs-CYsvAYOTHZRRxAUo",                     -- Project settings > Web API key
	  beat = 30,    -- seconds between "I'm here" updates
	  poll = 60,    -- seconds between list refreshes
	  window = 90,  -- seen within this many seconds = online
	  limit = 100,  -- most entries downloaded per refresh (keeps bandwidth bounded)
	  authFile = SAVE_FOLDER .. "/presence.auth",
	}
	local P = {
	  token = nil, refresh = nil, uid = nil, expires = 0,
	  offset = 0, share = true, running = true,
	  users = {}, errs = {}, beatOk = false, beatNow = true, pollNow = true,
	}
	local presenceConfigured = not (
	  string.find(PRESENCE.url, "YOUR-PROJECT", 1, true) or string.find(PRESENCE.apiKey, "YOUR_", 1, true)
	)

	local function httpReq(opts)
	  local req = (typeof(request) == "function" and request)
	    or (typeof(http_request) == "function" and http_request)
	    or (typeof(syn) == "table" and syn.request)
	  if not req then
	    return nil, 0, "Your executor has no request() function."
	  end
	  local ok, res = pcall(req, opts)
	  if not ok or typeof(res) ~= "table" then
	    return nil, 0, "Couldn't reach Firebase."
	  end
	  return res, tonumber(res.StatusCode) or 0
	end

	local function decode(body)
	  local ok, data = pcall(function()
	    return HttpService:JSONDecode(body)
	  end)
	  return ok and data or nil
	end

	local function saveRefreshToken()
	  if not fileSystemAvailable() or not P.refresh then
	    return
	  end
	  pcall(function()
	    if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(SAVE_FOLDER) then
	      makefolder(SAVE_FOLDER)
	    end
	    writefile(PRESENCE.authFile, P.refresh)
	  end)
	end

	if fileSystemAvailable() then
	  pcall(function()
	    if isfile(PRESENCE.authFile) then
	      local raw = readfile(PRESENCE.authFile)
	      if typeof(raw) == "string" and #raw > 20 then
	        P.refresh = raw
	      end
	    end
	  end)
	end

	-- Errors are kept per step so a failed write can't be hidden by a successful read
	local function currentErr()
		return P.errs.auth or P.errs.beat or P.errs.read
	end

	-- The text Firebase sends back with an error, e.g. "Permission denied"
	local function serverMessage(res)
		local d = res and res.Body and decode(res.Body)
		if typeof(d) == "table" and d.error ~= nil then
			if typeof(d.error) == "table" then
				return tostring(d.error.message or "")
			end
			return tostring(d.error)
		end
		return ""
	end

	local function authenticate()
		if P.token and os.time() < P.expires - 60 then
			return true
		end
		local key = PRESENCE.apiKey
		if P.refresh then
			local res, status = httpReq({
				Url = "https://securetoken.googleapis.com/v1/token?key=" .. key,
				Method = "POST",
				Headers = { ["Content-Type"] = "application/x-www-form-urlencoded" },
				Body = "grant_type=refresh_token&refresh_token=" .. HttpService:UrlEncode(P.refresh),
			})
			local d = res and status == 200 and decode(res.Body)
			if d and d.id_token then
				P.token, P.uid = d.id_token, d.user_id
				P.refresh = d.refresh_token or P.refresh
				P.expires = os.time() + (tonumber(d.expires_in) or 3600)
				P.errs.auth = nil
				saveRefreshToken()
				return true
			end
			P.refresh = nil
		end
		local res, status, why = httpReq({
			Url = "https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=" .. key,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = '{"returnSecureToken":true}',
		})
		if not res then
			P.errs.auth = why
			return false
		end
		local d = decode(res.Body)
		if status == 200 and d and d.idToken then
			P.token, P.refresh, P.uid = d.idToken, d.refreshToken, d.localId
			P.expires = os.time() + (tonumber(d.expiresIn) or 3600)
			P.errs.auth = nil
			saveRefreshToken()
			return true
		end
		local msg = d and d.error and tostring(d.error.message) or ""
		if string.find(msg, "OPERATION_NOT_ALLOWED", 1, true) or string.find(msg, "ADMIN_ONLY", 1, true) then
			P.errs.auth = "Turn on Anonymous sign-in in Firebase (Authentication > Sign-in method)."
		elseif string.find(msg, "API key", 1, true) then
			P.errs.auth = "The Firebase API key isn't valid."
		else
			P.errs.auth = "Firebase sign-in failed (" .. status .. ")" .. (msg ~= "" and (": " .. msg) or ".")
		end
		return false
	end

	local function dbUrl(path, extra)
		return PRESENCE.url .. path .. ".json?auth=" .. P.token .. (extra or "")
	end

	local function beat()
		if not authenticate() then
			P.beatOk = false
			return false
		end
		local res, status, why = httpReq({
			Url = dbUrl("/presence/" .. P.uid),
			Method = "PUT",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({
				n = player.Name,
				d = player.DisplayName,
				t = { [".sv"] = "timestamp" },
			}),
		})
		if not res then
			P.errs.beat, P.beatOk = why, false
			return false
		end
		if status == 200 then
			local d = decode(res.Body)
			if typeof(d) == "table" and tonumber(d.t) then
				P.offset = d.t - os.time() * 1000 -- server clock vs this device's clock
			end
			P.errs.beat, P.beatOk = nil, true
			return true
		end
		P.beatOk = false
		local msg = serverMessage(res)
		local lower = msg:lower()
		if status == 401 and string.find(lower, "token", 1, true) then
			P.token = nil -- expired or invalid, sign in again next time
			P.errs.beat = "Firebase rejected the sign-in."
		elseif status == 401 or status == 403 then
			P.errs.beat = "Firebase rules blocked your entry. Publish firebase-rules.json (Realtime Database > Rules)."
		else
			P.errs.beat = "Firebase refused your entry (" .. status .. ")" .. (msg ~= "" and (": " .. msg) or ".")
		end
		return false
	end

	local function leave()
		if not (P.token and P.uid) then
			return
		end
		httpReq({ Url = dbUrl("/presence/" .. P.uid), Method = "DELETE" })
	end

	local function fetchOnline()
		if not authenticate() then
			return
		end
		local cutoff = os.time() * 1000 + P.offset - PRESENCE.window * 1000
		local res, status, why = httpReq({
			Url = dbUrl("/presence", string.format("&orderBy=%%22t%%22&startAt=%.0f&limitToLast=%d", cutoff, PRESENCE.limit)),
			Method = "GET",
		})
		if not res then
			P.errs.read = why
			return
		end
		if status ~= 200 then
			local msg = serverMessage(res)
			local lower = msg:lower()
			if status == 401 and string.find(lower, "token", 1, true) then
				P.token = nil
				P.errs.read = "Firebase rejected the sign-in."
			elseif status == 401 or status == 403 then
				P.errs.read = "Firebase rules blocked reading the list. Publish firebase-rules.json."
			elseif status == 400 and string.find(lower, "index", 1, true) then
				P.errs.read = 'The database needs an index: add ".indexOn": ["t"] under "presence" in the rules.'
			else
				P.errs.read = "Couldn't read the list (" .. status .. ")" .. (msg ~= "" and (": " .. msg) or ".")
			end
			return
		end
		P.errs.read = nil
		local data = decode(res.Body)
		local list = {}
		if typeof(data) == "table" then
			for uid, v in pairs(data) do
				if typeof(v) == "table" and typeof(v.n) == "string" then
					table.insert(list, { name = v.n, display = typeof(v.d) == "string" and v.d or v.n, me = uid == P.uid })
				end
			end
		end
		-- while you're shared and your last update went through, you are online, so you are always in the count
		if P.share and P.beatOk then
			local found = false
			for _, u in ipairs(list) do
				if u.me then
					found = true
				end
			end
			if not found then
				table.insert(list, { name = player.Name, display = player.DisplayName, me = true })
			end
		end
		table.sort(list, function(a, b)
			if a.me ~= b.me then
				return a.me
			end
			return string.lower(a.display) < string.lower(b.display)
		end)
		P.users = list
	end

