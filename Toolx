-- Window state + animations
---------------------------------------------------------------------
local minimized = false
local closing = false
local animId = 0
local lastPos = main.Position

local function minimize()
	if minimized or closing then
		return
	end
	minimized = true
	animId += 1
	local id = animId
	lastPos = main.Position

	tween(main, 0.35, { Position = pillCenter, GroupTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	tween(mainScale, 0.35, { Scale = 0.12 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	setBlur(false)

	pillScale.Scale = 0.8
	pill.Visible = true
	task.delay(0.22, function()
		if animId == id then
			tween(pill, 0.3, { GroupTransparency = 0 })
			tween(pillScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end)
	task.delay(0.36, function()
		if animId == id then
			main.Visible = false
		end
	end)
end

local function restore()
	if not minimized or closing then
		return
	end
	minimized = false
	animId += 1
	local id = animId

	tween(pill, 0.2, { GroupTransparency = 1 })
	tween(pillScale, 0.2, { Scale = 0.8 })
	task.delay(0.2, function()
		if animId == id then
			pill.Visible = false
		end
	end)

	main.Visible = true
	tween(main, 0.45, { Position = lastPos, GroupTransparency = 0 })
	tween(mainScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
	setBlur(true)
end

Toolx = {}

function Toolx.Close()
	if closing then
		return
	end
	closing = true
	animId += 1

	pcall(saveOptions) -- flush anything still waiting to be written
	pcall(Desync.Unload)
	pcall(Mods.Unload)
	pcall(ChatLog.Stop)
	pcall(LoadLogger.Stop)
	tween(blur, 0.3, { Size = 0 })
	tween(main, 0.3, { GroupTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	tween(mainScale, 0.3, { Scale = 0.9 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	tween(pill, 0.25, { GroupTransparency = 1 })
	tween(pillScale, 0.25, { Scale = 0.8 })

	task.delay(0.4, function()
		for _, c in ipairs(connections) do
			c:Disconnect()
		end
		table.clear(connections)
		blur:Destroy()
		gui:Destroy()
		pcall(function()
			if getgenv().Toolx == Toolx then
				getgenv().Toolx = nil
			end
		end)
	end)
end

Toolx.Minimize = minimize
Toolx.Restore = restore
Toolx.AddTab = addTab
Toolx.Gui = gui

connect(minBtn.Activated, minimize)
connect(closeBtn.Activated, Toolx.Close)
connect(pillHit.Activated, restore)
connect(pillClose.Activated, Toolx.Close)

connect(UserInputService.InputBegan, function(input, processed)
	if processed or closing then
		return
	end
	if input.KeyCode == Enum.KeyCode.RightShift then
		if minimized then
			restore()
		else
			minimize()
		end
	end
end)

---------------------------------------------------------------------
-- Dragging (title bar)
---------------------------------------------------------------------
do
	local dragging, dragInput, dragStart, startPos

	connect(titleBar.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
			local c
			c = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					c:Disconnect()
				end
			end)
		end
	end)

	connect(titleBar.InputChanged, function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	connect(UserInputService.InputChanged, function(input)
		if dragging and input == dragInput then
			local d = input.Position - dragStart
			main.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end)
end

---------------------------------------------------------------------
-- Open animation
---------------------------------------------------------------------
-- Restore saved options (only when "Keep options" was on last time)
if keepEnabled then
	loadingOptions = true
	for key, comp in pairs(registry) do
		local value = savedData.options[key]
		local available = not (comp.IsEnabled and not comp.IsEnabled())
		if value ~= nil and available and typeof(value) == typeof(comp.Get()) then
			pcall(comp.Set, value)
		end
	end
	loadingOptions = false
end

selectTab(toolsTab)
tween(main, 0.4, { GroupTransparency = 0 })
tween(mainScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
setBlur(true)

pcall(function()
	getgenv().Toolx = Toolx
end)

return Toolx
