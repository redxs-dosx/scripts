	local GAMES_LIST_API = "https://games.roblox.com/v1/games/list"

	local mode = "Scripts" -- "Scripts" or "Games"
	local requestId = 0

	-----------------------------------------------------------------
	-- Data helpers
	-----------------------------------------------------------------
	local function fetchJson(url)
		local body = fetchUrl(url)
		if not body then
			return nil
		end
		local ok, data = pcall(function()
			return HttpService:JSONDecode(body)
		end)
		if ok and typeof(data) == "table" then
			return data
		end
		return nil
	end

	local function shortNumber(n)
		n = tonumber(n) or 0
		local s
		if n >= 1e6 then
			s = string.format("%.1fM", n / 1e6)
		elseif n >= 1e3 then
			s = string.format("%.1fK", n / 1e3)
		else
			s = tostring(math.floor(n))
		end
		return (s:gsub("%.0([MK])", "%1"))
	end

	-- Roblox games ------------------------------------------------
	local function parseGames(list)
		local out = {}
		if typeof(list) ~= "table" then
			return out
		end
		for _, g in ipairs(list) do
			if typeof(g) == "table" and g.universeId and (g.rootPlaceId or g.placeId) then
				table.insert(out, {
					universeId = g.universeId,
					placeId = g.rootPlaceId or g.placeId,
					name = tostring(g.name or "Unknown"),
					players = g.playerCount or 0,
					up = g.totalUpVotes or 0,
					down = g.totalDownVotes or 0,
				})
			end
		end
		return out
	end

	local function trendingGames()
		local session = HttpService:GenerateGUID(false)
		local sortId

		local sorts = fetchJson(EXPLORE_API .. "get-sorts?sessionId=" .. session .. "&device=computer&country=all")
		if sorts and typeof(sorts.sorts) == "table" then
			local fallback
			for _, s in ipairs(sorts.sorts) do
				local id = tostring(s.sortId or "")
				if id:lower():find("trending") then
					sortId = id
					break
				end
				if not fallback and id ~= "" and (s.contentType == nil or s.contentType == "Games") then
					fallback = id
				end
			end
			sortId = sortId or fallback
		end
		sortId = sortId or "top-trending"

		local data = fetchJson(
			EXPLORE_API .. "get-sort-content?sessionId=" .. session
				.. "&sortId=" .. HttpService:UrlEncode(sortId)
				.. "&device=computer&country=all"
		)
		if not data then
			return nil, "Couldn't reach Roblox. Check that your executor allows HTTP requests."
		end
		local games = parseGames(data.games or data.contents)
		if #games == 0 then
			return nil, "Roblox returned no trending games."
		end
		return games
	end

	local function searchGames(query)
		local session = HttpService:GenerateGUID(false)
		local data = fetchJson(
			OMNI_SEARCH_API .. "?searchQuery=" .. HttpService:UrlEncode(query)
				.. "&pageToken=&sessionId=" .. session .. "&pageType=all"
		)
		local games = {}
		if data and typeof(data.searchResults) == "table" then
			for _, group in ipairs(data.searchResults) do
				for _, g in ipairs(parseGames(group.contents)) do
					table.insert(games, g)
				end
			end
		end
		if #games == 0 then
			-- older endpoint as a fallback
			local legacy = fetchJson(GAMES_LIST_API .. "?model.keyword=" .. HttpService:UrlEncode(query) .. "&model.maxRows=24")
			if legacy then
				games = parseGames(legacy.games)
			end
		end
		if #games == 0 then
			return nil, data and ('No games found for "' .. query .. '".') or "Couldn't reach Roblox. Check that your executor allows HTTP requests."
		end
		return games
	end

	-- ScriptBlox scripts -------------------------------------------
	local function parseScripts(data)
		local root = data and (data.result or data)
		local list = root and (root.scripts or root)
		local out = {}
		if typeof(list) ~= "table" then
			return out
		end
		for _, s in ipairs(list) do
			if typeof(s) == "table" and s.title then
				local g = typeof(s.game) == "table" and s.game or nil
				table.insert(out, {
					title = tostring(s.title),
					slug = s.slug,
					id = s._id,
					source = typeof(s.script) == "string" and s.script or nil,
					game = g and g.name or nil,
					universal = s.isUniversal == true,
					verified = s.verified == true,
					key = s.key == true,
					patched = s.isPatched == true,
					views = s.views or 0,
				})
			end
		end
		return out
	end

	local function trendingScripts()
		local data = fetchJson(SCRIPTBLOX_API .. "trending")
		if not data then
			return nil, "Couldn't reach ScriptBlox. Check that your executor allows HTTP requests."
