	function FS.dropRow(specs)
		local HEAD, OPT, GAP = 32, 26, 4
		local count = #specs
		local row = mainTab:Container(HEAD)
		local drops = {}

		local function relayout()
			local maxH = HEAD
			for _, d in ipairs(drops) do
				local h = d.open and (HEAD + GAP + #d.options * (OPT + GAP)) or HEAD
				tween(d.frame, 0.25, { Size = UDim2.new(1 / count, count > 1 and -3 or 0, 0, h) })
				tween(d.arrow, 0.25, { Rotation = d.open and 180 or 0 })
				if h > maxH then
					maxH = h
				end
			end
			tween(row, 0.25, { Size = UDim2.new(1, 0, 0, maxH) })
		end

		for i, spec in ipairs(specs) do
			local d = { options = spec.options, selected = spec.initial or spec.options[1], open = false, buttons = {} }
			drops[i] = d
			d.frame = new("Frame", {
				BackgroundTransparency = 1,
				ClipsDescendants = true,
				Position = UDim2.new((i - 1) / count, i > 1 and 3 or 0, 0, 0),
				Size = UDim2.new(1 / count, count > 1 and -3 or 0, 0, HEAD),
			}, row)
			local head = new("TextButton", {
				Text = "",
				AutoButtonColor = false,
				Size = UDim2.new(1, 0, 0, HEAD),
				BackgroundColor3 = theme.surface,
				BackgroundTransparency = 0.35,
				BorderSizePixel = 0,
			}, d.frame)
			corner(head, 8)
			stroke(head, 0.94)
			d.text = new("TextLabel", {
				RichText = true,
				Text = "",
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = theme.text,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(10, 0),
				Size = UDim2.new(1, -28, 1, 0),
			}, head)
			d.arrow = new("TextLabel", {
				Text = "v",
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				TextColor3 = theme.dim,
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.fromOffset(14, 14),
			}, head)

			local function paint()
				d.text.Text = '<font color="#9090a6">' .. spec.name .. "</font>  " .. escapeRich(d.selected)
				for opt, b in pairs(d.buttons) do
					b.TextColor3 = opt == d.selected and theme.accent or theme.text
				end
			end

			for j, opt in ipairs(d.options) do
				local b = new("TextButton", {
					Text = opt,
					Font = Enum.Font.GothamMedium,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
					AutoButtonColor = false,
					BackgroundColor3 = theme.surface,
					BackgroundTransparency = 0.35,
					BorderSizePixel = 0,
					Position = UDim2.fromOffset(0, HEAD + GAP + (j - 1) * (OPT + GAP)),
					Size = UDim2.new(1, 0, 0, OPT),
				}, d.frame)
				corner(b, 8)
				new("UIPadding", { PaddingLeft = UDim.new(0, 10) }, b)
				d.buttons[opt] = b
				connect(b.Activated, function()
					d.open = false
					local changed = d.selected ~= opt
					d.selected = opt
					paint()
					relayout()
					if changed and spec.onChange then
						spec.onChange(opt)
					end
				end)
			end
			paint()

			connect(head.Activated, function()
				d.open = not d.open
				for _, other in ipairs(drops) do
					if other ~= d then
						other.open = false
					end
				end
				relayout()
			end)
		end
		return row
	end

