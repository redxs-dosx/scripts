	local function sendKey(key)
		if not VIM then
			return false
		end
		return pcall(function()
			VIM:SendKeyEvent(true, key, false, game)
			task.wait(0.05)
			VIM:SendKeyEvent(false, key, false, game)
		end)
	end

	-- is the real menu window showing? (falls back to the MenuIsOpen flag)
	local function isMenuOpen()
		local ok, shield = pcall(function()
			return CoreGui.RobloxGui.SettingsShield
		end)
		if ok and shield then
			local ok2, v = pcall(function()
				return shield.Visible
			end)
			if ok2 and type(v) == "boolean" then
				return v
			end
		end
		local ok3, flag = pcall(function()
			return GuiService.MenuIsOpen
		end)
		return ok3 and flag == true
	end

	-- true when we can actually see the menu window (so a "no change" result is believable)
	local function canSeeMenuWindow()
		local ok, shield = pcall(function()
			return CoreGui.RobloxGui.SettingsShield
		end)
		return ok and shield ~= nil
	end

	local function toggleMenu()
		local before = isMenuOpen()
		-- the menu button just presses Escape, same as the keyboard
		if sendKey(Enum.KeyCode.Escape) then
			task.wait(0.3)
			if canSeeMenuWindow() then
				setActionStatus("Menu: Escape pressed (" .. (isMenuOpen() and "open" or "closed") .. ")")
			else
				setActionStatus("Menu: Escape pressed")
			end
			return
		end

		-- no VirtualInputManager on this executor: fall back to Roblox's own menu module
		local want = not before
		local ok = pcall(function()
			require(CoreGui.RobloxGui.Modules.Settings.SettingsHub):SetVisibility(want)
		end)
		if not ok then
			ok = pcall(function()
				GuiService:SetMenuIsOpen(want)
			end)
		end
		setActionStatus(ok and ("Menu: " .. (want and "opened" or "closed") .. " (no Escape key available)") or "Menu: nothing worked")
	end

