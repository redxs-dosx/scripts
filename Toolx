local function copyToClipboard(text)
	local fn
	if typeof(setclipboard) == "function" then
		fn = setclipboard
	elseif typeof(toclipboard) == "function" then
		fn = toclipboard
	end
	if not fn then
		return false
	end
	return (pcall(fn, text))
end

local function getConsoleText()
	local lines = {}
	for _, entry in ipairs(LogService:GetLogHistory()) do
		local prefix = ""
		if entry.messageType == Enum.MessageType.MessageError then
			prefix = "[ERROR] "
		elseif entry.messageType == Enum.MessageType.MessageWarning then
			prefix = "[WARN] "
		end
		table.insert(lines, prefix .. entry.message)
	end
	return table.concat(lines, "\n")
end

local function flashLabel(lbl, text)
	local original = lbl.Text
	lbl.Text = text
	task.delay(1.2, function()
		if lbl.Parent then
			lbl.Text = original
		end
	end)
end

