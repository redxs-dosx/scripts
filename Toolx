	info = theme.accent,
	success = Color3.fromRGB(76, 201, 120),
	warn = theme.amber,
	error = theme.red,
}

local toastHost = new("Frame", {
	Name = "Toasts",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -14, 0, 56),
	Size = UDim2.fromOffset(TOAST_W, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundTransparency = 1,
	ZIndex = 10,
}, gui)
