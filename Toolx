	function load(query)
		requestId += 1
		local id = requestId
		local searching = query ~= nil and query ~= ""
		local currentMode = mode

		sectionLabel.Text = string.upper(
			searching and ('Results for "' .. query .. '"') or ("Trending " .. string.lower(currentMode))
		)
		clearResults()
		showMessage("Loading...")

		task.spawn(function()
			local ok, items, err = pcall(function()
				if currentMode == "Scripts" then
					if searching then
						return searchScripts(query)
					end
					return trendingScripts()
				end
				if searching then
					return searchGames(query)
				end
				return trendingGames()
			end)
			if id ~= requestId or not gui.Parent then
				return -- a newer request replaced this one
			end
			clearResults()
			if not ok then
				showMessage("Something went wrong while loading. Tap Search to try again.")
				return
			end
			if not items then
				showMessage((err or "Nothing to show.") .. " Tap Search to try again.")
				return
			end
			if currentMode == "Scripts" then
				renderScripts(items)
			else
				renderGames(items)
			end
		end)
	end

	local function doSearch()
		local q = (searchBox.Text or ""):match("^%s*(.-)%s*$")
		load(q ~= "" and q or nil)
	end

	connect(searchBtn.Activated, doSearch)
	connect(searchBox.FocusLost, function(enterPressed)
		if enterPressed then
			doSearch()
		end
	end)

	load(nil)
end

