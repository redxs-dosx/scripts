-- Server (rejoin / server hop)
---------------------------------------------------------------------
local Server = {}
do
	local TeleportService = game:GetService("TeleportService")
	local busy = false

	-- teleports can hang without ever failing, so never stay locked for long
	local function lock(seconds)
		busy = true
		task.delay(seconds, function()
			busy = false
		end)
	end

	connect(TeleportService.TeleportInitFailed, function(plr, result, message)
		if plr == player then
			busy = false
			notify("Teleport failed: " .. tostring(message ~= "" and message or result), "error", 4)
		end
	end)

	function Server.Rejoin()
		if busy then
			notify("Already teleporting", "warn")
			return
		end
		lock(20)
		notify("Rejoining...")
		local ok, err = pcall(function()
			if #Players:GetPlayers() <= 1 or game.JobId == "" then
				-- alone in the server (it would close when you leave), so just join a fresh one
				TeleportService:Teleport(game.PlaceId, player)
			else
				TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
			end
		end)
		if not ok then
			busy = false
			warn("[Toolx] rejoin failed: " .. tostring(err))
			notify("Rejoin failed", "error")
		end
	end

	-- Public servers that aren't full and aren't the one you are in (first two pages, emptiest first)
	local function findServers()
		local list = {}
		local cursor
		for _ = 1, 2 do
			local url = "https://games.roblox.com/v1/games/" .. game.PlaceId
				.. "/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100"
			if cursor then
				url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
			end
			local body = fetchUrl(url)
			if not body then
				return list, "Couldn't reach Roblox's server list"
			end
			local ok, data = pcall(function()
				return HttpService:JSONDecode(body)
			end)
			if not ok or typeof(data) ~= "table" or typeof(data.data) ~= "table" then
				return list, "Couldn't read the server list (rate limited?)"
			end
			for _, s in ipairs(data.data) do
				if
					typeof(s) == "table"
					and typeof(s.id) == "string"
					and s.id ~= game.JobId
					and typeof(s.playing) == "number"
					and typeof(s.maxPlayers) == "number"
					and s.playing < s.maxPlayers
				then
					table.insert(list, s)
				end
			end
			cursor = data.nextPageCursor
			if typeof(cursor) ~= "string" then
				break
			end
		end
		return list
	end

	function Server.Hop()
		if busy then
			notify("Already teleporting", "warn")
			return
		end
		lock(30)
		notify("Looking for another server...")
		local list, problem = findServers()
		if #list == 0 then
			busy = false
			notify(problem or "No other server found", problem and "error" or "warn", 3.5)
			return
		end
		local pick = list[math.random(#list)]
		notify(string.format("Hopping (%d/%d players)...", pick.playing, pick.maxPlayers), "success")
		local ok, err = pcall(function()
			TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, player)
		end)
		if not ok then
			busy = false
			warn("[Toolx] server hop failed: " .. tostring(err))
			notify("Server hop failed", "error")
		end
	end
end

---------------------------------------------------------------------
-- Anti-AFK (answers Roblox's idle timeout so you aren't kicked after 20 minutes)
---------------------------------------------------------------------
local AntiAFK = {}
do
	local conn
	local lastToast = 0
	local VirtualUser, VIM
	pcall(function()
		VirtualUser = game:GetService("VirtualUser")
	end)
	pcall(function()
		VIM = game:GetService("VirtualInputManager")
	end)

	local function poke()
		if VirtualUser then
			local ok = pcall(function()
				VirtualUser:CaptureController()
				VirtualUser:ClickButton2(Vector2.new())
			end)
			if ok then
				return true
			end
		end
		if VIM then
			-- right click in the middle of the screen (harmless, unlike the corners where the menu button lives)
			local cam = workspace.CurrentCamera
			local mid = cam and cam.ViewportSize / 2 or Vector2.new(400, 300)
			return (pcall(function()
				VIM:SendMouseButtonEvent(mid.X, mid.Y, 1, true, game, 0)
				task.wait(0.05)
				VIM:SendMouseButtonEvent(mid.X, mid.Y, 1, false, game, 0)
			end))
		end
		return false
	end

	function AntiAFK.Set(on)
		if conn then
			conn:Disconnect()
			conn = nil
		end
		if not on then
			return
		end
		conn = player.Idled:Connect(function()
			local ok = poke()
			local now = os.clock()
			if now - lastToast > 30 then
				lastToast = now
				notify(ok and "Anti-AFK: stopped an idle kick" or "Anti-AFK: couldn't send input", ok and "info" or "error")
			end
		end)
	end

	function AntiAFK.Unload()
		AntiAFK.Set(false)
	end
end

---------------------------------------------------------------------
-- Performance: FPS unlocker (setfpscap) + FPS counter
---------------------------------------------------------------------
local Perf = {}
do
	local CAPS = { ["60"] = 60, ["120"] = 120, ["240"] = 240, Max = 0 } -- 0 = uncapped
	local enabled, cap, original = false, 240, nil

	function Perf.Supported()
		return typeof(setfpscap) == "function"
	end

	local function apply(value)
		if Perf.Supported() then
			pcall(setfpscap, value)
		end
	end

	function Perf.Set(on)
		if not Perf.Supported() then
			return false
		end
		if on then
			if original == nil then
				local ok, current = pcall(function()
					return getfpscap()
				end)
				original = (ok and typeof(current) == "number") and current or 60
			end
			enabled = true
			apply(cap)
		else
			enabled = false
			if original ~= nil then
				apply(original)
				original = nil
			end
		end
		return true
	end

	function Perf.SetCap(name)
		cap = CAPS[name] or 240
		if enabled then
			apply(cap)
		end
	end

	function Perf.Unload()
		Perf.Set(false)
	end
end

local FPS = { value = 0 }
do
	local frames, last = 0, os.clock()
	connect(RunService.RenderStepped, function()
		frames += 1
	end)
	-- frames per second since the previous call (keeps the last value if called too soon)
	function FPS.Sample()
		local now = os.clock()
		local dt = now - last
		if dt >= 0.25 then
			FPS.value = frames / dt
			frames = 0
			last = now
		end
		return FPS.value
	end
end

