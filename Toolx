	-- switching
	------------------------------------------------------------------
	local loopRunning = false
	local function ensureLoop()
		if loopRunning then
			return
		end
		loopRunning = true
		task.spawn(function()
			while alive do
				if enforceHidden then
					pcall(applyHidden)
				end
				if style and style.refresh then
					pcall(style.refresh)
				end
				task.wait(0.2)
			end
			loopRunning = false
		end)
	end

	-- name: "2018", "2021" or "Current" (the real topbar)
	function Topbar.Set(name)
		if not alive then
			return
		end
		if name ~= "2018" and name ~= "2021" and name ~= "Current" then
			return
		end
		runCleanups()
		if style and style.root then
			style.root:Destroy()
		end
		style = nil
		current = name
		if name == "Current" then
			-- bring the real topbar back, the copy is gone
			setRealVisible(true)
		else
			-- hide the real topbar while a copy is shown
			setRealVisible(false)
			style = (name == "2018") and build2018() or build2021()
			ensureLoop()
		end
	end

	-- percent: 100 = original size
	function Topbar.SetScale(percent)
		uiScale = math.clamp(percent, 50, 300) / 100
		if style and style.ui and style.root then
			style.ui.Scale = uiScale
			style.root.Size = UDim2.fromScale(1 / uiScale, 1 / uiScale)
		end
	end

	function Topbar.Get()
		return current
	end

	-- puts the real topbar back and removes everything we made
	function Topbar.Unload()
		if not alive then
			return
		end
		alive = false
		runCleanups()
		if style and style.root then
			pcall(function()
				style.root:Destroy()
			end)
		end
		style = nil
		setRealVisible(true)
		if gui then
			pcall(function()
				gui:Destroy()
			end)
			gui = nil
		end
	end
end

