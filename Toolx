	scanResultsBox.Clear()
	
	task.spawn(function()
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local Workspace = game:GetService("Workspace")
		local defaultPayloads = {
			"print('Toolx Backdoor Scan Active')",
			"game:GetService('HttpService')",
		}
		
		local count = 0
		local containers = { ReplicatedStorage, Workspace }
		
		for _, container in ipairs(containers) do
			for _, descendant in ipairs(container:GetDescendants()) do
				if descendant:IsA("RemoteEvent") or descendant:IsA("RemoteFunction") then
					for _, payload in ipairs(defaultPayloads) do
						local ok = pcall(function()
							if descendant:IsA("RemoteEvent") then
								descendant:FireServer(payload)
							elseif descendant:IsA("RemoteFunction") then
								descendant:InvokeServer(payload)
							end
						end)
						if ok then
							count += 1
							local remoteObj = descendant
							scanResultsBox.Add(
								string.format('<font color="#4cc978">%s</font> (%s)', escapeRich(remoteObj.Name), escapeRich(remoteObj.ClassName)),
								function()
									local argsToFire = getBuiltArguments()
									local fireOk = pcall(function()
										if remoteObj:IsA("RemoteEvent") then
