						end
						nextI = i + #s
						emit(s, C_NUMBER)
					elseif (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95 then
						-- identifier / keyword
						local word = string.match(src, "^[%w_]+", i)
						nextI = i + #word
						local before = string.byte(src, i - 1)
						local isMember = (before == 46 and string.byte(src, i - 2) ~= 46) or before == 58
						local after = string.match(src, "^%s*([%(\"'{`])", nextI)
						local color
						if isMember then
							if after then
